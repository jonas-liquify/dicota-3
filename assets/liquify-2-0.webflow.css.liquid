  gap: 0.75rem;
}
.default-regular-component {
  display: flex;
  flex-direction: column;
  gap: 3rem;
}
.default-space-between {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
  justify-content: space-between;
}
.default-bg-wrapper {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}
.default-bg-image {
