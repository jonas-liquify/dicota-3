/* =============================================================
   DICOTA — Collection Products: Filter Bar
   ============================================================= */
.coll_filter-bar-outer {
  position: sticky;
  top: 4.5rem;
  z-index: 30;
  background-color: #ffffff;
  border-bottom: 1px solid #e8e8e8;
}

.coll_filter-bar-outer > .padding-global {
