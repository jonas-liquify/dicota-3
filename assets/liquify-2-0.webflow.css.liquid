  color: #ffffff;
  margin: 0;
}

.coll_promo-card_desc {
  color: rgba(255,255,255,0.85);
  margin: 0;
}

.coll_promo-card_cta {
  display: inline-block;
  padding: 0.625rem 1.25rem;
  background-color: #ffffff;
  color: #0f0f0f;
  font-family: "Futura PT", sans-serif;
  font-size: 0.875rem;
