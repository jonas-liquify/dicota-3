  padding-bottom: 0;
}

.coll_filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  min-height: 3rem;
}

.coll_filter-pills {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  flex: 1 1 auto;
  min-width: 0;
  gap: 0;
  overflow-x: auto;
  scrollbar-width: none;
}
.coll_filter-pills::-webkit-scrollbar {
  display: none;
}

.coll_filter-pill-group {
  position: relative;
}

.coll_filter-pill {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.875rem 1rem;
