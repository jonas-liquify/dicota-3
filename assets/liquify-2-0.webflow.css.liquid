.section_heading-h1 {
  width: 100%;
}
.heading-h1_grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem 12rem;
  align-items: start;
}

/* Section: Boxed Image */
.section_boxed-image {
  width: 100%;
}
/* Layout modes (merged Boxed Image + Boxed Image Centered) */
.section_boxed-image .boxed-image_wrapper.is-full {
  position: relative;
  min-height: 80dvh;
  overflow: hidden;
  z-index: 1;
}
.section_boxed-image .boxed-image_wrapper.is-contained {
  width: 100%;
}
/* Only show the branch matching the active layout (li-if renders both in builder preview) */
.section_boxed-image .boxed-image_wrapper.is-full > .padding-global { display: none; }
.section_boxed-image .boxed-image_wrapper.is-contained > .boxed-image_bg-container { display: none; }
.boxed-image_bg-container {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: grid;
  grid-template-columns: 1fr min(76rem, 100%) 1fr;
}
.boxed-image_image-wrapper {
  grid-column: 2;
  width: 100%;
  height: 100%;
  overflow: hidden;
}
.boxed-image_image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

