}

.accessories_list {
  display: flex;
  gap: .125rem;
}

.accessories_item {
  width: 20.5rem;
  flex: none;
}

.accessories_arrow {
  position: absolute;
  top: 50%;
  right: 1rem;
  z-index: 3;
  width: 3.5rem;
  height: 3.5rem;
  padding: 0;
  border: none;
  border-radius: 62.4375rem;
  background-color: rgba(15, 15, 15, .7);
  backdrop-filter: blur(.3125rem);
  color: var(--base-color-neutral--white);
