  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.coll_promo-card_overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
}

.coll_promo-card_content {
  position: absolute;
  z-index: 2;
  left: 0;
  bottom: 0;
