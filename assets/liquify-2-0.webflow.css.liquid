}

.coll_sort-inner .icon-embed-xsmall {
  width: 0.875rem;
  height: 0.875rem;
  pointer-events: none;
  position: absolute;
  right: 0;
  opacity: 0.6;
}

/* =============================================================
   DICOTA — Collection Products: Grid
   ============================================================= */
.section_collection-products > .padding-global:last-of-type {
  padding-top: 2rem;
  padding-bottom: 5rem;
}

.coll_grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem 1rem;
  align-items: start;
}

/* Promo Card — spans 2 columns (default). Toggle "Promo groß" off → .is-normal, 1 Kachel. */
.coll_promo-card {
  grid-column: span 2;
  background-color: #162040;
  color: #ffffff;
