}

.coll_filter-checkbox-box {
  width: 1rem;
  height: 1rem;
  border: 1.5px solid #c0c0c0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coll_filter-checkbox-label {
  flex: 1 1 auto;
}

.coll_filter-count {
