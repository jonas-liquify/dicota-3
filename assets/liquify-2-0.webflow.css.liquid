/* =============================================================
   DICOTA — Order Marketing Material (B2B/Acc Mkt Giveaways)
   Bestellformular mit Item-Tabelle + Lieferdatum + Event-Beschreibung.
   Layout-Pattern: Karten mit hellgrauem Hintergrund auf weißer Section.
   ============================================================= */
.section_mkt-order {
