/**
 * DICOTA — Judge.me Reviews Proxy (Cloudflare Worker reference)
 * ------------------------------------------------------------------
 * Hält den privaten Judge.me API-Token SERVERSEITIG. Das Theme spricht
 * nur diesen Proxy an (Setting "Reviews-Proxy-URL" in der Product-Reviews-
 * Section) — der Token verlässt nie den Server.
 *
 * Endpoints (Contract, den das Theme erwartet):
 *   GET  {proxy}/reviews?product_id=<shopify_id>&handle=<handle>&page=<n>&per_page=<m>
 *        -> { "reviews": [ {rating,title,body,reviewer:{name},created_at}, ... ],
 *             "has_more": bool }               // NUR veröffentlichte Reviews, OHNE E-Mails/PII
 *   POST {proxy}/reviews   (JSON: {product_id,url,handle,name,email,rating,title,body})
 *        -> { "ok": true }                     // öffentliche Review-Einreichung (Moderation via Judge.me)
 *
 * Secrets (als Worker-Variablen/Secrets setzen, NICHT hier hardcoden):
 *   JUDGEME_API_TOKEN   = <privater Judge.me API Token>
 *   JUDGEME_SHOP_DOMAIN = dicota.myshopify.com
 *   ALLOWED_ORIGIN      = https://www.dicota.com   (Storefront-Origin; für CORS)
 *
 * Deploy: siehe README.md
 */

const JM = "https://judge.me/api/v1";

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const cors = corsHeaders(request, env);

    if (request.method === "OPTIONS") return new Response(null, { status: 204, headers: cors });
    if (!url.pathname.replace(/\/+$/, "").endsWith("/reviews")) {
      return json({ error: "not found" }, 404, cors);
    }

    try {
      if (request.method === "GET")  return await handleList(url, env, cors);
      if (request.method === "POST") return await handleCreate(request, env, cors);
      return json({ error: "method not allowed" }, 405, cors);
    } catch (err) {
      return json({ error: "upstream error" }, 502, cors); // generisch — keine Upstream-Details/Token leaken
    }
  }
};

/* ---- GET /reviews : veröffentlichte Reviews, PII entfernt ---- */
async function handleList(url, env, cors) {
  const productId = url.searchParams.get("product_id") || "";
  const handle    = url.searchParams.get("handle") || "";
  const page      = clampInt(url.searchParams.get("page"), 1, 1, 1000);
  const perPage   = clampInt(url.searchParams.get("per_page"), 10, 1, 50);

  // 1) Shopify-external_id -> Judge.me interne Produkt-ID auflösen
  let jmId = null;
  try {
    const pr = await jmGet(env, "/products/-1", { external_id: productId, handle });
    jmId = pr && pr.product && pr.product.id;
  } catch (_) { /* fällt unten auf handle zurück */ }

  // 2) Reviews holen (nur published)
  const params = { per_page: perPage, page, published: "true" };
  if (jmId) params.product_id = jmId; else params.handle = handle;
  const d = await jmGet(env, "/reviews", params);
  const raw = (d && d.reviews) || [];

  // 3) Auf sichere Felder reduzieren (KEINE E-Mail, keine IDs/IP)
  const reviews = raw
    .filter(r => r && (r.published === undefined || r.published === true) && r.hidden !== true)
    .map(r => ({
      rating: r.rating,
      title: r.title || "",
      body: r.body || "",
      reviewer: { name: (r.reviewer && r.reviewer.name) || r.reviewer_name || "Anonymous" },
      created_at: r.created_at
    }));

  return json({ reviews, has_more: raw.length === perPage }, 200, cors);
}

/* ---- POST /reviews : öffentliche Einreichung (Token bleibt serverseitig) ---- */
async function handleCreate(request, env, cors) {
  let b;
  try { b = await request.json(); } catch (_) { return json({ error: "bad request" }, 400, cors); }

  const rating = parseInt(b.rating, 10);
  const name  = str(b.name), email = str(b.email), body = str(b.body);
  const title = str(b.title), pid = str(b.product_id), purl = str(b.url);
  if (!(rating >= 1 && rating <= 5) || !name || !isEmail(email) || !body) {
    return json({ error: "invalid input" }, 422, cors);
  }
  if (name.length > 120 || title.length > 200 || body.length > 5000) {
    return json({ error: "too long" }, 422, cors);
  }
  // TODO optional: Rate-Limit (z.B. per Cloudflare KV/Turnstile) gegen Review-Spam.

  const form = new URLSearchParams();
  form.set("shop_domain", env.JUDGEME_SHOP_DOMAIN);
  form.set("platform", "shopify");
  if (pid)  form.set("id", pid);
  if (purl) form.set("url", purl);
  form.set("name", name); form.set("email", email);
  form.set("rating", String(rating));
  if (title) form.set("title", title);
  form.set("body", body);

  const r = await fetch(JM + "/reviews", {
    method: "POST",
    headers: { "Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json" },
    body: form.toString()
  });
  return json({ ok: r.ok }, r.ok ? 200 : 502, cors);
}

/* ---- helpers ---- */
async function jmGet(env, path, params) {
  const u = new URL(JM + path);
  u.searchParams.set("api_token", env.JUDGEME_API_TOKEN);
  u.searchParams.set("shop_domain", env.JUDGEME_SHOP_DOMAIN);
  for (const k in params) if (params[k] != null && params[k] !== "") u.searchParams.set(k, params[k]);
  const r = await fetch(u.toString(), { headers: { "Accept": "application/json" } });
  if (!r.ok) throw new Error("judgeme " + r.status);
  return r.json();
}
function corsHeaders(request, env) {
  const origin = request.headers.get("Origin") || "";
  const allow = env.ALLOWED_ORIGIN || "";
  const ok = allow && (allow === "*" || allow.split(",").map(s => s.trim()).indexOf(origin) !== -1);
  return {
    "Access-Control-Allow-Origin": ok ? origin : allow.split(",")[0] || "null",
    "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type, Accept",
    "Vary": "Origin"
  };
}
function json(obj, status, cors) {
  return new Response(JSON.stringify(obj), { status, headers: Object.assign({ "Content-Type": "application/json" }, cors) });
}
function str(v) { return (v == null ? "" : String(v)).trim(); }
function isEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); }
function clampInt(v, def, min, max) { var n = parseInt(v, 10); if (isNaN(n)) n = def; return Math.max(min, Math.min(max, n)); }
