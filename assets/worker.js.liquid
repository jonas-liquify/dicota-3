/**
 * DICOTA — Upgradebox Product Finder Proxy (Cloudflare Worker)
 * ------------------------------------------------------------------
 * Die upgbAPI (upgradebox.eu) erwartet einen HTTP-POST mit XML-Body, der
 * userid, subid UND das PASSWORT IM KLARTEXT enthält, und antwortet in XML.
 * Sie ist damit prinzipiell nicht clientseitig nutzbar — ein Aufruf aus dem
 * Theme würde das Passwort im Seitenquelltext offenlegen (und CORS fehlt).
 *
 * Dieser Worker hält die Credentials serverseitig und übersetzt die API in
 * schlanke JSON-GETs. Das Theme (_sections/Product Finder Native.html)
 * spricht nur diesen Proxy an — über das Setting "Product-Finder-Proxy-URL".
 *
 * Endpoints (Contract, den das Theme erwartet):
 *   GET {proxy}/manufacturers?lang=de
 *       -> { "items": ["Acer", "Apple", ...] }
 *   GET {proxy}/types?manufacturer=Apple&lang=de
 *       -> { "items": [ {"value":"NOTEBOOK","label":"Notebook"}, ... ] }
 *   GET {proxy}/models?manufacturer=Apple&type=NOTEBOOK&lang=de
 *       -> { "items": ["MacBook Pro 16 M3", ...] }
 *   GET {proxy}/articles?manufacturer=Apple&model=MacBook%20Pro%2016%20M3&lang=de
 *       -> { "items": [ {"reference":"D31839","name":"…","group":"…",
 *                        "subgroup":"…","manufacturer":"DICOTA"}, ... ],
 *            "references": ["D31839", ...] }     // Convenience für die SKU-Suche
 *
 * Secrets (NICHT hier hardcoden — `wrangler secret put`):
 *   UPGRADEBOX_USERID   = <userID von upgradebox.eu>
 *   UPGRADEBOX_PASS     = <Passwort>
 * Vars (wrangler.toml):
 *   UPGRADEBOX_SUBID    = 0000
 *   UPGRADEBOX_VERSION  = v1            (Pfadsegment: https://api.upgradebox.net/<VERSION>/)
 *   ALLOWED_ORIGIN      = https://www.dicota.com,...
 *
 * Deploy: siehe README.md
 */

const API_HOST = "https://api.upgradebox.net";

/* Die API kennt laut Doku (Tab. 2) diese Sprachen. Shop-Locales ohne
   Gegenstück (ar, hi) fallen bewusst auf EN zurück. */
const LANGS = {
  cs: "CZ", da: "DK", de: "DE", en: "EN", es: "ES", fr: "FR",
  hu: "HU", it: "IT", nl: "NL", pl: "PL", pt: "PT", sk: "SL", sv: "SK", uk: "UA"
};

/* Cache-Dauer je Endpoint. Die Doku kündigt Rate-Limits an ("e.g. 10/min,
   1000/day") — Caching ist hier Pflicht, nicht Optimierung. */
const TTL = { manufacturers: 86400, types: 86400, models: 21600, articles: 3600 };

const ROUTES = {
  manufacturers: { type: "ModelManufacturers",        params: [] },
  types:         { type: "ModelTypes",                params: ["manufacturer"] },
  models:        { type: "ModelListManufacturerType", params: ["manufacturer", "type"] },
  articles:      { type: "ModelArticles",             params: ["manufacturer", "model"] }
};

export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);
    const cors = corsHeaders(request, env);

    if (request.method === "OPTIONS") return new Response(null, { status: 204, headers: cors });
    if (request.method !== "GET") return json({ error: "method not allowed" }, 405, cors);

    const route = url.pathname.replace(/\/+$/, "").split("/").pop();
    if (!ROUTES[route]) return json({ error: "not found" }, 404, cors);

    const lang = LANGS[str(url.searchParams.get("lang")).toLowerCase()] || "EN";
    const manufacturer = str(url.searchParams.get("manufacturer"));
    const modeltype    = str(url.searchParams.get("type"));
    const model        = str(url.searchParams.get("model"));

    /* Pflichtparameter prüfen, damit keine sinnlosen Upstream-Calls entstehen
       (jeder Call zählt gegen das Rate-Limit). */
    const need = ROUTES[route].params;
    if (need.indexOf("manufacturer") !== -1 && !manufacturer) return json({ error: "manufacturer required" }, 400, cors);
    if (need.indexOf("type") !== -1 && !modeltype) return json({ error: "type required" }, 400, cors);
    if (need.indexOf("model") !== -1 && !model) return json({ error: "model required" }, 400, cors);

    /* Cache-Key ohne Origin/Credentials — nur die fachlichen Parameter. */
    const cacheKey = new Request(
      `${url.origin}/__ub/${route}?l=${enc(lang)}&ma=${enc(manufacturer)}&t=${enc(modeltype)}&mo=${enc(model)}`,
      { method: "GET" }
    );
    const cache = caches.default;
    const hit = await cache.match(cacheKey);
    if (hit) {
      const body = await hit.text();
      return new Response(body, { status: 200, headers: Object.assign({ "Content-Type": "application/json", "X-Proxy-Cache": "HIT" }, cors) });
    }

    let payload;
    try {
      /* Bei /manufacturers wandert ein mitgegebenes ?type= nach
         <requirehasmodeltype>, nicht nach <modeltypesystemname>. */
      const p = route === "manufacturers"
        ? { requiretype: modeltype }
        : { manufacturer, modeltype, model };
      const xml = await callApi(env, ROUTES[route].type, lang, p);
      payload = parse(route, xml, env);
    } catch (err) {
      return json({ error: "upstream error" }, 502, cors); // generisch — keine Upstream-Details, keine Credentials
    }

    const body = JSON.stringify(payload);
    ctx.waitUntil(cache.put(cacheKey, new Response(body, {
      headers: { "Content-Type": "application/json", "Cache-Control": `public, max-age=${TTL[route]}` }
    })));

    return new Response(body, { status: 200, headers: Object.assign({ "Content-Type": "application/json", "X-Proxy-Cache": "MISS" }, cors) });
  }
};

/* ---- Upstream: XML-POST an die upgbAPI ---- */
async function callApi(env, requesttype, lang, p) {
  const version = str(env.UPGRADEBOX_VERSION) || "v1";
  let extra = "";
  if (p.manufacturer) extra += `<modelmanufacturer>${esc(p.manufacturer)}</modelmanufacturer>`;
  if (p.modeltype)    extra += `<modeltypesystemname>${esc(p.modeltype)}</modeltypesystemname>`;
  if (p.model)        extra += `<modelname>${esc(p.model)}</modelname>`;
  /* Optional bei ModelManufacturers (Kap. 4.1): kürzt die Herstellerliste auf
     die, für die es zu diesem Modelltyp überhaupt Artikel gibt. Verhindert
     Hersteller im Dropdown, die am Ende zu 0 Treffern führen. */
  if (p.requiretype)  extra += `<requirehasmodeltype>${esc(p.requiretype)}</requirehasmodeltype>`;

  const xml =
    `<?xml version="1.0" encoding="UTF-8"?>` +
    `<upgradeboxrequest>` +
      `<authorization>` +
        `<userid>${esc(env.UPGRADEBOX_USERID)}</userid>` +
        `<subid>${esc(str(env.UPGRADEBOX_SUBID) || "0000")}</subid>` +
        `<pass>${esc(env.UPGRADEBOX_PASS)}</pass>` +
      `</authorization>` +
      `<request>` +
        `<requesttype>${requesttype}</requesttype>` +
        `<requestlanguage>${lang}</requestlanguage>` +
        `<requestformat>XML</requestformat>` +
        extra +
      `</request>` +
    `</upgradeboxrequest>`;

  const r = await fetch(`${API_HOST}/${version}/`, {
    method: "POST",
    headers: { "Content-Type": "text/xml; charset=UTF-8", "Accept": "text/xml" },
    body: xml
  });
  if (!r.ok) throw new Error("upgradebox " + r.status);
  return r.text();
}

/* ---- XML -> JSON. Bewusst per Regex: die Antworten sind flach und
   Cloudflare Workers haben keinen DOMParser. ---- */
function parse(route, xml, env) {
  if (route === "manufacturers") {
    /* Die Doku ist hier widersprüchlich: die Befehlsreferenz (Kap. 4.1) nennt
       <modelmanufacturer>, die Beispielantwort (Kap. 2) <manufacturer>.
       Deshalb beide akzeptieren — sonst kommt still eine leere Liste zurück. */
    let items = tags(xml, "modelmanufacturer");
    if (!items.length) items = tags(xml, "manufacturer");
    return { items };
  }
  if (route === "types") {
    const items = blocks(xml, "modeltype").map(b => ({
      value: tag(b, "modeltypesystemname"),
      label: tag(b, "modeltypedisplay") || tag(b, "modeltypesystemname")
    })).filter(i => i.value);
    return { items };
  }
  if (route === "models") {
    /* ModelListManufacturerType liefert flache <modelname>-Elemente. */
    return { items: tags(xml, "modelname") };
  }
  // articles
  const items = blocks(xml, "article").map(b => ({
    reference:    tag(b, "articlereference"),
    name:         tag(b, "articlename"),
    group:        tag(b, "articlegroup"),
    subgroup:     tag(b, "articlesubgroup"),
    manufacturer: tag(b, "articlemanufacturer"),
    compattype:   tag(b, "articlecompattype")
  })).filter(a => a.reference);

  /* ModelArticles kann Artikel FREMDER Hersteller enthalten — die Doku nennt
     Kingston Technology und Origin Storage ausdrücklich als articlemanufacturer.
     Deren Referenznummern sind keine Shopify-SKUs; sie würden die Suche nur
     verwässern. Für die SKU-Suche daher auf den eigenen Hersteller einschränken.
     ARTICLE_MANUFACTURER leer setzen = nicht filtern.
     `items` bleibt vollständig, `skipped` macht das Weglassen sichtbar. */
  const own = str(env && env.ARTICLE_MANUFACTURER).toLowerCase();
  const mine = own ? items.filter(a => a.manufacturer.toLowerCase() === own) : items;
  return {
    items,
    references: mine.map(a => a.reference),
    skipped: items.length - mine.length,
    manufacturers: [...new Set(items.map(a => a.manufacturer).filter(Boolean))]
  };
}

function blocks(xml, name) {
  const out = [];
  const re = new RegExp(`<${name}>([\\s\\S]*?)</${name}>`, "gi");
  let m;
  while ((m = re.exec(xml)) !== null) out.push(m[1]);
  return out;
}
function tags(xml, name) {
  return blocks(xml, name).map(v => unesc(v).trim()).filter(Boolean);
}
function tag(block, name) {
  const m = new RegExp(`<${name}>([\\s\\S]*?)</${name}>`, "i").exec(block);
  return m ? unesc(m[1]).trim() : "";
}

/* ---- helpers ---- */
function esc(v) {
  return str(v).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
               .replace(/"/g, "&quot;").replace(/'/g, "&apos;");
}
function unesc(v) {
  return String(v).replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, "$1")
                  .replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, '"')
                  .replace(/&apos;/g, "'").replace(/&amp;/g, "&");
}
function corsHeaders(request, env) {
  const origin = request.headers.get("Origin") || "";
  const allow = env.ALLOWED_ORIGIN || "";
  const ok = allow && (allow === "*" || allow.split(",").map(s => s.trim()).indexOf(origin) !== -1);
  return {
    "Access-Control-Allow-Origin": ok ? origin : allow.split(",")[0] || "null",
    "Access-Control-Allow-Methods": "GET, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type, Accept",
    "Vary": "Origin"
  };
}
function json(obj, status, cors) {
  return new Response(JSON.stringify(obj), { status, headers: Object.assign({ "Content-Type": "application/json" }, cors) });
}
function str(v) { return (v == null ? "" : String(v)).trim(); }
function enc(v) { return encodeURIComponent(str(v)); }
