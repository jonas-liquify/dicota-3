<div li-block="4-up Karte" class="swiper-slide is-quad-cards" {{ block.shopify_attributes }}>
                    <div class="image-card_item"><a href="{{ block.settings.url_card_link }}" class="image-card_link is-large w-inline-block"> <h3 class="text-size-large">{{ block.settings.text_card_heading }}</h3>{% if block.settings.text_card_button_text != blank %} <div li-if="block.settings.text_card_button_text != blank" class="image-card_button-wrapper"> <div class="button is-white is-image-card"><span>{{ block.settings.text_card_button_text }}</span></div> </div>{% endif %}<div class="image-card_bg-wrapper"><div class="image-card_bg-overlay"></div>{% if block.settings.image_card_bg_image %} {{ block.settings.image_card_bg_image | image_url: width: 800 | image_tag: li-if: 'block.settings.image_card_bg_image != blank', class: 'image-card_bg-image', loading: 'lazy' }} {% else %} <img li-if="block.settings.image_card_bg_image != blank" class="image-card_bg-image" src="{{ 'platzhalter.svg' | asset_url }}" alt="" loading="lazy"> {% endif %}</div> </a></div>
                </div> {% schema %} {
    "name": "4-up Karte",
    "settings": [
        {
            "id": "url_card_link",
            "type": "url",
            "label": "Card Link"
        },
        {
            "id": "text_card_heading",
            "type": "text",
            "label": "Card Heading",
            "default": "Innovation"
        },
        {
            "id": "text_card_button_text",
            "type": "text",
            "label": "Card Button Text",
            "default": "Learn more"
        },
        {
            "id": "image_card_bg_image",
            "type": "image_picker",
            "label": "Card BG Image"
        }
    ],
    "presets": [
        {
            "name": "4-up Karte",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}