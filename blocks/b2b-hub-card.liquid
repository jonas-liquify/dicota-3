<div li-block="B2B Hub Card" class="acc-card sol-link-card" {{ block.shopify_attributes }}>
                    {% if block.settings.image_icon %}
{{ block.settings.image_icon | image_url: width: 80 | image_tag: loading: 'lazy', class: 'acc_cta-icon' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="acc_cta-icon">
{% endif %}
                    <div class="acc-card_content"><div class="heading-style-h4">
{{ block.settings.text_heading }}
</div><div class="text-size-regular"> {{ block.settings.textarea_text }} </div></div>
                    <a href="{{ block.settings.url_button_link }}" class="button is-secondary w-button"> <span>{{ block.settings.text_button_text }}</span> </a>
                </div> {% schema %} {
    "name": "B2B Hub Card",
    "settings": [
        {
            "id": "image_icon",
            "type": "image_picker",
            "label": "Icon"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Run Rate Product Supply"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "Ideal partner for daily IT accessory business \u2014 1,000+ products, fast availability and strong reseller margins."
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Learn more"
        }
    ],
    "presets": [
        {
            "name": "B2B Hub Card",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}