<div li-block="B2B Loy Kontakt" class="acc_support-card" {{ block.shopify_attributes }}>
                    <div class="default-bg-wrapper">{% if block.settings.image_foto %}
{{ block.settings.image_foto | image_url: width: 600 | image_tag: loading: 'lazy', class: 'default-bg-image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="default-bg-image">
{% endif %}</div>
                    <div class="acc_support-card-content"><div class="acc_support-card-text"><div class="text-size-large">
{{ block.settings.text_name }}
</div><a href="mailto:info@dicota.com" class="text-size-regular text-style-link"><span>
{{ block.settings.text_e_mail }}
</span></a><a href="tel:+41" class="text-size-regular text-style-link"><span>
{{ block.settings.text_telefon }}
</span></a></div><a href="{{ block.settings.url_linkedin_link }}" class="acc_support-card-link w-inline-block"> <div class="icon-1x1-medium w-embed"><svg width="100%" height="100%" viewbox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"></path></svg></div> </a></div>
                </div> {% schema %} {
    "name": "B2B Loy Kontakt",
    "settings": [
        {
            "id": "image_foto",
            "type": "image_picker",
            "label": "Foto"
        },
        {
            "id": "text_name",
            "type": "text",
            "label": "Name",
            "default": "First name Last name"
        },
        {
            "id": "text_e_mail",
            "type": "text",
            "label": "E-Mail",
            "default": "info@dicota.com"
        },
        {
            "id": "text_telefon",
            "type": "text",
            "label": "Telefon",
            "default": "+41 00 000 00 00"
        },
        {
            "id": "url_linkedin_link",
            "type": "url",
            "label": "LinkedIn Link"
        }
    ],
    "presets": [
        {
            "name": "B2B Loy Kontakt",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}