<div li-block="B2B Loy News" class="acc-card gap-2-5" {{ block.shopify_attributes }}>
                    {% if block.settings.image_bild != blank %}    <span class="li-guard" li-if="block.settings.image_bild != blank">
    {% if block.settings.image_bild %}
{{ block.settings.image_bild | image_url: width: 600 | image_tag: loading: 'lazy', class: 'acc-card_3-2-image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="acc-card_3-2-image">
{% endif %}    </span>
{% endif %}
                    <div class="acc-card_content">{% if block.settings.text_tag != blank %}    <div class="li-guard" li-if="block.settings.text_tag != blank">
    <div class="text-style-subline">
{{ block.settings.text_tag }}
</div>    </div>
{% endif %}<div class="text-size-large">
{{ block.settings.text_heading }}
</div><div class="text-size-regular"> {{ block.settings.textarea_text }} </div></div>
                    {% if block.settings.text_button_text != blank %}    <span class="li-guard" li-if="block.settings.text_button_text != blank">
    <a href="{{ block.settings.url_button_link }}" class="button is-secondary w-button"> <span>{{ block.settings.text_button_text }}</span> </a>    </span>
{% endif %}
                </div> {% schema %} {
    "name": "B2B Loy News",
    "settings": [
        {
            "id": "image_bild",
            "type": "image_picker",
            "label": "Bild"
        },
        {
            "id": "text_tag",
            "type": "text",
            "label": "Tag",
            "default": "News"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "News title"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "Short description of the news item."
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Read more"
        }
    ],
    "presets": [
        {
            "name": "B2B Loy News",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}