<div li-block="B2B Mkt Quicklink" class="acc-card" {{ block.shopify_attributes }}>
                    {% if block.settings.image_icon %}
{{ block.settings.image_icon | image_url: width: 80 | image_tag: loading: 'lazy', class: 'acc_cta-icon' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="acc_cta-icon">
{% endif %}
                    <div class="acc-card_content"><div class="heading-style-h4">
{{ block.settings.text_heading }}
</div><div class="text-rich-text w-richtext"> {{ block.settings.richtext_text }} </div></div>
                    <a href="{{ block.settings.url_button_link }}" class="button w-button"> <span>{{ block.settings.text_button_text }}</span> </a>
                </div> {% schema %} {
    "name": "B2B Mkt Quicklink",
    "settings": [
        {
            "id": "image_icon",
            "type": "image_picker",
            "label": "Icon"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Product images"
        },
        {
            "id": "richtext_text",
            "type": "richtext",
            "label": "Text",
            "default": "<p>All product images in high resolution as a ZIP.<\/p>"
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Open"
        }
    ],
    "presets": [
        {
            "name": "B2B Mkt Quicklink",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}