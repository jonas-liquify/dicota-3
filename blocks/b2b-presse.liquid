        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Pressemitteilung-Titel"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "Kurze Zusammenfassung des Inhalts."
        },
        {
            "id": "url_download_link",
            "type": "url",
            "label": "Download Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Herunterladen"
        }
    ],
    "presets": [
        {
            "name": "B2B Presse",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}