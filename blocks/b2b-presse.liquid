<div li-block="B2B Presse" class="acc-card is-small" {{ block.shopify_attributes }}>
                    <div class="acc-card_download-content"><div class="default-flex-tiny"><div class="text-style-subline">
{{ block.settings.text_datum }}
</div><div class="text-size-large">
{{ block.settings.text_heading }}
</div><div class="text-size-regular"> {{ block.settings.textarea_text }} </div></div><a href="{{ block.settings.url_download_link }}" class="button is-secondary w-button"> <span>{{ block.settings.text_button_text }}</span> </a></div>
                </div> {% schema %} {
    "name": "B2B Presse",
    "settings": [
        {
            "id": "text_datum",
            "type": "text",
            "label": "Datum",
