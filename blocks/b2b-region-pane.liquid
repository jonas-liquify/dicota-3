<div li-block="B2B Region Pane" role="tabpanel" class="acc-dis_tab-pane" x-bind:style="tab === {{ forloop.index }} ? { display: 'grid' } : { display: 'none' }" {{ block.shopify_attributes }}>
                    {% if block.settings.image_distributor_logo %}
{{ block.settings.image_distributor_logo | image_url: width: 200 | image_tag: loading: 'lazy', class: 'acc-dis_logo' }}
