<button li-block="B2B Region" type="button" role="tab" class="acc-dis_tab-link" x-on:click="tab = {{ forloop.index }}" x-bind:class="tab === {{ forloop.index }} ? 'is-active' : ''" {{ block.shopify_attributes }}>
                    {% if block.settings.image_region_icon %}
{{ block.settings.image_region_icon | image_url: width: 48 | image_tag: loading: 'lazy', class: 'icon-1x1-small' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="icon-1x1-small">
{% endif %}
                    <div>
{{ block.settings.text_region_name }}
</div>
                </button> {% schema %} {
    "name": "B2B Region",
    "settings": [
        {
            "id": "image_region_icon",
            "type": "image_picker",
            "label": "Region Icon"
        },
        {
            "id": "text_region_name",
            "type": "text",
            "label": "Region Name",
            "default": "DACH"
        }
    ],
    "presets": [
        {
            "name": "B2B Region",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}