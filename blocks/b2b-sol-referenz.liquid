<div li-block="B2B Sol Referenz" class="sol-refs_item" {{ block.shopify_attributes }}>
                    {% if block.settings.image_logo != blank %}    <span class="li-guard" li-if="block.settings.image_logo != blank">
    {% if block.settings.image_logo %}
