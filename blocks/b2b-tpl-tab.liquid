<button li-block="B2B Tpl Tab" type="button" role="tab" class="acc-dis_tab-link" id="acc-tab-{{ forloop.index }}" aria-controls="acc-tabpanel-{{ forloop.index }}" x-on:click="tab = {{ forloop.index }}" x-bind:aria-selected="tab === {{ forloop.index }} ? 'true' : 'false'" x-bind:class="tab === {{ forloop.index }} ? 'is-active' : ''" {{ block.shopify_attributes }}>
                    {% if block.settings.image_tab_icon %}
{{ block.settings.image_tab_icon | image_url: width: 48 | image_tag: li-if: 'block.settings.image_tab_icon != blank', loading: 'lazy', class: 'icon-1x1-small' }}
{% else %}
<img li-if="block.settings.image_tab_icon != blank" src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="icon-1x1-small">
{% endif %}
                    <div>
{{ block.settings.text_tab_label }}
</div>
                </button> {% schema %} {
    "name": "B2B Tpl Tab",
    "settings": [
        {
            "id": "image_tab_icon",
            "type": "image_picker",
            "label": "Tab Icon"
        },
        {
            "id": "text_tab_label",
            "type": "text",
            "label": "Tab Label",
            "default": "Region"
        }
    ],
    "presets": [
        {
            "name": "B2B Tpl Tab",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}