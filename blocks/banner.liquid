<article li-block="Banner" class="two-column-banner_item" {{ block.shopify_attributes }}>
                    <picture class="two-column-banner_picture">{% if block.settings.image_hintergrundbild %}
{{ block.settings.image_hintergrundbild | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'two-column-banner_image' }}
{% else %}
<img src="{{ 'hero-apparel-2.svg' | asset_url }}" loading="lazy" alt="" class="two-column-banner_image">
{% endif %}</picture>
                    {% if section.settings.overlay_strength > 0 %}    <div li-if="section.settings.overlay_strength > 0" class="two-column-banner_overlay">
        </div>
{% endif %}
                    <div class="two-column-banner_content"><h3 class="two-column-banner_title heading-style-h3">
{{ block.settings.text_uberschrift }}
</h3><p class="two-column-banner_subtext text-size-medium"> {{ block.settings.textarea_subtext }} </p><a href="{{ block.settings.url_button_link }}" class="button two-column-banner_button w-button"> <span>{{ block.settings.text_button_text }}</span> </a></div>
                </article> {% schema %} {
    "name": "Banner",
    "settings": [
        {
            "id": "image_hintergrundbild",
            "type": "image_picker",
            "label": "Hintergrundbild"
        },
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Tell A Friend &amp; Get 15% Off"
        },
        {
            "id": "textarea_subtext",
            "type": "textarea",
            "label": "Subtext",
            "default": "Give your friends 15% off their first\n                order, and get a 15% off for each successful referral"
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Freund einladen"
        }
    ],
    "presets": [
        {
            "name": "Banner",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}