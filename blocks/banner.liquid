<article li-block="Banner" class="two-column-banner_item" {{ block.shopify_attributes }}>
                    {% if block.settings.image_hintergrundbild != blank %}    <picture li-if="block.settings.image_hintergrundbild != blank" class="two-column-banner_picture">
    {% if block.settings.image_hintergrundbild %}
{{ block.settings.image_hintergrundbild | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'two-column-banner_image' }}
{% else %}
<img src="{{ 'hero-apparel-2.svg' | asset_url }}" loading="lazy" alt="" class="two-column-banner_image">
{% endif %}    </picture>
{% endif %}
                    <div li-if:inside="section.settings.overlay_strength > 0" style="display:contents" inside="1">
        {% if section.settings.overlay_strength > 0 %}
            <div class="two-column-banner_overlay" style="--overlay-color: {{ section.settings.overlay_color }}; --overlay-strength: {{ section.settings.overlay_strength }}%; --overlay-start: {{ section.settings.overlay_start }}%;"></div>        {% endif %}
    </div>
                    <div class="two-column-banner_content"><h3 class="two-column-banner_title heading-style-h3">
{{ block.settings.text_uberschrift }}
</h3><p li-if="block.settings.textarea_subtext != blank" class="two-column-banner_subtext text-size-regular"> {{ block.settings.textarea_subtext }} </p><a li-if="block.settings.text_button_text != blank" href="{{ block.settings.url_button_link }}" class="button two-column-banner_button w-button"> <span>{{ block.settings.text_button_text }}</span> </a></div>
                </article> {% schema %} {
    "name": "Banner",
    "settings": [
        {
            "id": "image_hintergrundbild",
            "type": "image_picker",
            "label": "Hintergrundbild"
        },
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Tell A Friend &amp; Get 15% Off"
        },
        {
            "id": "textarea_subtext",
            "type": "textarea",
            "label": "Subtext",
            "default": "Give your friends 15% off their first order, and get a 15% off for each successful referral"
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Invite a friend"
        }
    ],
    "presets": [
        {
            "name": "Banner",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}