<div li-block="Benefit" class="benefits_item" {{ block.shopify_attributes }}>
                    {% if block.settings.image_icon %}
{{ block.settings.image_icon | image_url: width: 48 | image_tag: loading: 'lazy', class: 'icon-1x1-small' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="icon-1x1-small">
{% endif %}
                    <div class="benefits_text-wrapper"><h3 class="text-size-large">
{{ block.settings.text_heading }}
</h3><div class="text-size-medium"> {{ block.settings.textarea_text }} </div></div>
                </div> {% schema %} {
    "name": "Benefit",
    "settings": [
        {
            "id": "image_icon",
            "type": "image_picker",
            "label": "Icon"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Flexible working hours"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "Flexitime, home office and trust instead of a time clock."
        }
    ],
    "presets": [
        {
            "name": "Benefit",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}