<div li-block="FAQ Kategorie" class="faq_category" {{ block.shopify_attributes }}>
                    <h3 class="heading-style-h4 faq_category-title" id="faq-{{ block.id }}">
{{ block.settings.text_kategorie_titel }}
</h3>
                    {% if block.settings.faq_set != blank %}    <div li-if="block.settings.faq_set != blank">
    <div class="faq_component" li-for:inside="faq in block.settings.faq_set.which_faqs.value">
        {% for faq in block.settings.faq_set.which_faqs.value %}                            <div x-data="{open: false}" class="faq_item background-color-alternate"><div tabindex="0" role="button" x-on:click="open=!open" x-bind:aria-expanded="open?'true':'false'" class="faq_header"><div li-object="faq.question" class="text-size-medium text-weight-medium">{{ faq.question }}</div><div class="faq_icon-outer"><div class="faq_icon-line"></div><div x-bind:class="open?'is-open':''" class="faq_icon-line is-rotating"></div></div></div><div x-bind:class="open?'is-open':''" class="faq_body"><div class="faq_body-content"><div li-object="faq.faq_answer | metafield_tag" class="text-size-regular">{{ faq.faq_answer | metafield_tag }}</div></div></div></div>
                    {% endfor %}    </div>    </div>
{% endif %}
                    {% if block.settings.faq_set == blank %}    <div li-if="block.settings.faq_set == blank">
    <div class="faq_component" li-for:inside="faq in block.settings.faq_entries">
        {% for faq in block.settings.faq_entries %}                            <div x-data="{open: false}" class="faq_item background-color-alternate"><div tabindex="0" role="button" x-on:click="open=!open" x-bind:aria-expanded="open?'true':'false'" class="faq_header"><div li-object="faq.question" class="text-size-medium text-weight-medium">{{ faq.question }}</div><div class="faq_icon-outer"><div class="faq_icon-line"></div><div x-bind:class="open?'is-open':''" class="faq_icon-line is-rotating"></div></div></div><div x-bind:class="open?'is-open':''" class="faq_body"><div class="faq_body-content"><div li-object="faq.faq_answer | metafield_tag" class="text-size-regular">{{ faq.faq_answer | metafield_tag }}</div></div></div></div>
                    {% endfor %}    </div>    </div>
{% endif %}
                    
                </div> {% schema %} {
    "name": "FAQ Kategorie",
    "settings": [
        {
            "id": "text_kategorie_titel",
            "type": "text",
            "label": "Kategorie Titel",
            "default": "General questions"
        },
        {
            "type": "header",
            "content": "FAQ-Quelle"
        },
        {
            "type": "metaobject",
            "id": "faq_set",
            "label": "FAQ-Set (Kategorie)",
            "metaobject_type": "faqs_category",
            "info": "Entweder ein FAQ-Set waehlen ODER unten einzelne FAQs. Ist ein Set gewaehlt, hat es Vorrang."
        },
        {
            "type": "metaobject_list",
            "id": "faq_entries",
            "label": "Einzelne FAQs",
            "metaobject_type": "faqs_filters",
            "limit": 50
        }
    ],
    "presets": [
        {
            "name": "FAQ Kategorie",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}