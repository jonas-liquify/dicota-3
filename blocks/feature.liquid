<div li-block="Feature" class="swiper-slide is-product-features product-features_item" {{ block.shopify_attributes }}>
                    <div class="product-features_img-wrap">{% if block.settings.image_bild %}
{{ block.settings.image_bild | image_url: width: 600 | image_tag: loading: 'lazy', class: 'product-features_img' }}
{% else %}
<img src="{{ 'placeholder.svg' | asset_url }}" loading="lazy" alt="" class="product-features_img">
{% endif %}</div>
                    <div class="product-features_content"><h3 class="product-features_title">
{{ block.settings.text_titel }}
</h3><p class="product-features_text text-size-regular"> {{ block.settings.textarea_text }} </p></div>
                </div> {% schema %} {
    "name": "Feature",
    "settings": [
        {
            "id": "image_bild",
            "type": "image_picker",
            "label": "Bild"
        },
        {
            "id": "text_titel",
            "type": "text",
            "label": "Titel",
            "default": "Dicota Cushion Technology"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "DCT ist ein strukturiertes D\u00e4mpfungssystem das St\u00f6sse, Schl\u00e4ge und Druck absorbieren kann."
        }
    ],
    "presets": [
        {
            "name": "Feature",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}