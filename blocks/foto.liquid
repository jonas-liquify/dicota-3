<article li-block="Foto" class="swiper-slide loved-by_slide" {{ block.shopify_attributes }}>
                    <picture class="loved-by_picture">{% if block.settings.image_foto %}
{{ block.settings.image_foto | image_url: width: 800 | image_tag: loading: 'lazy', class: 'loved-by_image' }}
{% else %}
<img src="{{ 'hero-apparel-2.svg' | asset_url }}" loading="lazy" alt="" class="loved-by_image">
{% endif %}</picture>
                    {% if block.settings.tagged_product != blank %}    <div li-if="block.settings.tagged_product != blank" class="loved-by_product-tag">
    <div class="loved-by_product-info"><a li-object:href="block.settings.tagged_product.url" href="{{ block.settings.tagged_product.url }}" class="loved-by_product-link w-inline-block"><img li-object:src="block.settings.tagged_product.featured_image | image_url: width: 200" li-object:alt="block.settings.tagged_product.title" src="{{ block.settings.tagged_product.featured_image | image_url: width: 200 }}" loading="lazy" alt="{{ block.settings.tagged_product.title }}" class="loved-by_product-thumb"><div class="loved-by_product-text"><p li-object="block.settings.tagged_product.title" class="loved-by_product-title">{{ block.settings.tagged_product.title }}</p><p li-object="block.settings.tagged_product.type" class="loved-by_product-type">{{ block.settings.tagged_product.type }}</p><p li-object="block.settings.tagged_product.price | money" class="loved-by_product-price">{{ block.settings.tagged_product.price | money }}</p>{% if block.settings.tagged_product.metafields.reviews.rating %}    <div li-if="block.settings.tagged_product.metafields.reviews.rating" class="loved-by_product-rating">
    <div class="loved-by_product-stars"><div style="--rating: {{ block.settings.tagged_product.metafields.reviews.rating.value }}"></div></div><span class="loved-by_product-review-count">14 reviews</span>    </div>
{% endif %}</div></a></div><button li-element="add-to-cart" type="button" class="button loved-by_atc-button w-button" @click="addToCart($event, true)" :disabled="!addToCartButton">Add to cart</button>    </div>
{% endif %}
                    
                </article> {% schema %} {
    "name": "Foto",
    "settings": [
        {
            "id": "image_foto",
            "type": "image_picker",
            "label": "Foto"
        },
        {
            "type": "product",
            "id": "tagged_product",
            "label": "Markiertes Produkt (optional)",
            "info": "Wird als Tag auf dem Foto eingeblendet"
        }
    ],
    "presets": [
        {
            "name": "Foto",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}