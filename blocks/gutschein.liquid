<div li-block="Gutschein" class="acc-card" {{ block.shopify_attributes }}>
                    {% if block.settings.image_bild %}
{{ block.settings.image_bild | image_url: width: 600 | image_tag: loading: 'lazy', class: 'acc-card_16-9-image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="acc-card_16-9-image">
{% endif %}
                    <div class="acc-card_content"><div class="text-style-subline">
{{ block.settings.text_partner }}
</div><div class="text-size-large">
{{ block.settings.text_wert }}
</div><div class="text-size-regular">
{{ block.settings.text_punkte }}
</div></div>
                    <a href="{{ block.settings.url_button_link }}" class="button w-button"> <span>{{ block.settings.text_button_text }}</span> </a>
                </div> {% schema %} {
    "name": "Gutschein",
    "settings": [
        {
            "id": "image_bild",
            "type": "image_picker",
            "label": "Bild"
        },
        {
            "id": "text_partner",
            "type": "text",
            "label": "Partner",
            "default": "Partner"
        },
        {
            "id": "text_wert",
            "type": "text",
            "label": "Wert",
            "default": "25 EUR Gutschein"
        },
        {
            "id": "text_punkte",
            "type": "text",
            "label": "Punkte",
            "default": "1.250 Punkte"
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Einl\u00f6sen"
        }
    ],
    "presets": [
        {
            "name": "Gutschein",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}