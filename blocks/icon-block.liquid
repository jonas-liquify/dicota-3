<div li-block="Icon Block" class="company_icon-block" {{ block.shopify_attributes }}>
                    {% if block.settings.image_icon != blank %}    <span class="li-guard" li-if="block.settings.image_icon != blank">
    {% if block.settings.image_icon %}
{{ block.settings.image_icon | image_url: width: 80 | image_tag: loading: 'lazy', class: 'company_icon' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="company_icon">
{% endif %}    </span>
{% endif %}
                    <div class="company_icon-text"><div class="text-size-large">
{{ block.settings.text_zahl }}
</div>{% if block.settings.text_label != blank %}    <div class="li-guard" li-if="block.settings.text_label != blank">
    <div class="text-size-medium">
{{ block.settings.text_label }}
</div>    </div>
{% endif %}</div>
                </div> {% schema %} {
    "name": "Icon Block",
    "settings": [
        {
            "id": "image_icon",
            "type": "image_picker",
            "label": "Icon"
        },
        {
            "id": "text_zahl",
            "type": "text",
            "label": "Zahl",
            "default": "14.2M"
        },
        {
            "id": "text_label",
            "type": "text",
            "label": "Label",
            "default": "Recycled PET bottles"
        }
    ],
    "presets": [
        {
            "name": "Icon Block",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}