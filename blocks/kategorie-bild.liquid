<div li-block="Kategorie-Bild" class="collection-intro_tile swiper-slide is-collection-intro" {{ block.shopify_attributes }}>
                    <a href="{{ block.settings.url_link }}" class="collection-intro_tile-link"> {% if block.settings.image_bild != blank %} <div li-if="block.settings.image_bild != blank" class="collection-intro_tile-media"> {% if block.settings.image_bild %} {{ block.settings.image_bild | image_url: width: 500 | image_tag: loading: 'lazy', class: 'collection-intro_tile-image' }} {% else %} <img src="{{ 'placeholder.svg' | asset_url }}" loading="lazy" alt="" class="collection-intro_tile-image"> {% endif %} </div>{% endif %}<div class="collection-intro_tile-caption"><p class="collection-intro_tile-title">{{ block.settings.text_titel }}</p><p class="collection-intro_tile-text"> {{ block.settings.textarea_text }} </p></div> </a>
                </div> {% schema %} {
    "name": "Kategorie-Bild",
    "settings": [
        {
            "id": "url_link",
            "type": "url",
            "label": "Link"
        },
        {
            "id": "image_bild",
            "type": "image_picker",
            "label": "Bild"
        },
        {
            "id": "text_titel",
            "type": "text",
            "label": "Titel",
            "default": "ENTRY LEVEL OR PROJECT TENDER"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "Lorem ipsum dolor sit amet, consectetur delle scu adipiscing elit. Suspendisse varius enim in eros elementum tristique."
        }
    ],
    "presets": [
        {
            "name": "Kategorie-Bild",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}