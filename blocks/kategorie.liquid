<div li-block="Kategorie" class="swiper-slide shop-by-category_item" {{ block.shopify_attributes }}>
                    <a href="{{ block.settings.url_link }}" class="category-tile w-inline-block"> <picture class="category-tile_picture">{% if block.settings.image_bild %} {{ block.settings.image_bild | image_url: width: 900 | image_tag: loading: 'lazy', class: 'category-tile_image' }} {% else %} <img src="{{ 'collection-apparel-1.svg' | asset_url }}" loading="lazy" alt="" class="category-tile_image"> {% endif %}</picture><div class="category-tile_overlay"></div><div class="category-tile_footer"><span class="category-tile_title">{{ block.settings.text_titel }}</span><span class="category-tile_arrow" aria-hidden="true"><svg width="100%" height="100%" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 12H20M20 12L14 6M20 12L14 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span></div> </a>
                </div> {% schema %} {
    "name": "Kategorie",
    "settings": [
        {
            "id": "url_link",
            "type": "url",
            "label": "Link"
        },
        {
            "id": "image_bild",
            "type": "image_picker",
            "label": "Bild"
        },
        {
            "id": "text_titel",
            "type": "text",
            "label": "Titel",
            "default": "Backpacks"
        }
    ],
    "presets": [
        {
            "name": "Kategorie",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}