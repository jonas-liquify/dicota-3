                    <div class="ph_highlights"><ul li-for:inside="argument in product.metafields.custom.sales_arguments.value" role="list">
        {% for argument in product.metafields.custom.sales_arguments.value %}                            <li li-object="argument">{{ argument }}</li>
                    {% endfor %}    </ul></div>
