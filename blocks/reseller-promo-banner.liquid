<article li-block="Reseller Promo Banner" class="reseller-promo_card" {{ block.shopify_attributes }}>
                    {% if block.settings.image_bild %}
{{ block.settings.image_bild | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'reseller-promo_image' }}
{% else %}
<img src="{{ 'hero-apparel-2.svg' | asset_url }}" loading="lazy" alt="" class="reseller-promo_image">
{% endif %}
                    <div class="reseller-promo_overlay"></div>
                    <div class="reseller-promo_content"><h3 class="reseller-promo_title heading-style-h4">
{{ block.settings.text_titel }}
</h3><p class="reseller-promo_text text-size-small"> {{ block.settings.textarea_text }} </p><a href="{{ block.settings.url_button_link }}" class="button is-on-dark reseller-promo_btn w-button"> <span>{{ block.settings.text_button_text }}</span> </a></div>
                </article> {% schema %} {
    "name": "Reseller Promo Banner",
    "settings": [
        {
            "id": "image_bild",
            "type": "image_picker",
            "label": "Bild"
        },
        {
            "id": "text_titel",
            "type": "text",
            "label": "Titel",
            "default": "One"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "Give your friends 15% off their first order, and get a 15% off for each successful referral"
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Freund einladen"
        }
    ],
    "presets": [
        {
            "name": "Reseller Promo Banner",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}