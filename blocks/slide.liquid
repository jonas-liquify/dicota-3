<div li-block="Slide" class="swiper-slide hero_slide" {{ block.shopify_attributes }}>
                    <picture class="hero_bg-picture">{% if block.settings.image_hintergrundbild != blank %}    <span class="li-guard" li-if="block.settings.image_hintergrundbild != blank">
    {% if block.settings.image_hintergrundbild %}
{{ block.settings.image_hintergrundbild | image_url: width: 2400 | image_tag: loading: 'eager', class: 'hero_bg-image' }}
{% else %}
<img src="{{ 'hero-apparel-1.svg' | asset_url }}" loading="eager" alt="" class="hero_bg-image">
{% endif %}    </span>
{% endif %}</picture>
                    <div class="hero_overlay"></div>
                    <div class="hero_content"><div class="hero_text"><div class="hero_headline"><p class="hero_headline-line">
{{ block.settings.text_headline_zeile_1 }}
</p>{% if block.settings.text_headline_zeile_2 != blank %}    <div class="li-guard" li-if="block.settings.text_headline_zeile_2 != blank">
    <p class="hero_headline-line">
{{ block.settings.text_headline_zeile_2 }}
</p>    </div>
{% endif %}</div>{% if block.settings.text_subtext != blank %}    <div class="li-guard" li-if="block.settings.text_subtext != blank">
    <p class="hero_subtext text-size-regular">
{{ block.settings.text_subtext }}
</p>    </div>
{% endif %}</div><div class="hero_actions">{% if block.settings.text_button_text != blank %}    <span class="li-guard" li-if="block.settings.text_button_text != blank">
    <a href="{{ block.settings.url_button_link }}" class="button hero_button w-button"> <span>{{ block.settings.text_button_text }}</span> </a>    </span>
{% endif %}</div></div>
                </div> {% schema %} {
    "name": "Slide",
    "settings": [
        {
            "id": "image_hintergrundbild",
            "type": "image_picker",
            "label": "Hintergrundbild"
        },
        {
            "id": "text_headline_zeile_1",
            "type": "text",
            "label": "Headline Zeile 1",
            "default": "Weigh Darker\u2122"
        },
        {
            "id": "text_headline_zeile_2",
            "type": "text",
            "label": "Headline Zeile 2",
            "default": "Moon Bag Ruffle"
        },
        {
            "id": "text_subtext",
            "type": "text",
            "label": "Subtext",
            "default": "Refined design. Recycled modern materials."
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Shop now"
        }
    ],
    "presets": [
        {
            "name": "Slide",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}