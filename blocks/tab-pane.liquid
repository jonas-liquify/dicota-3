<div li-block="Tab Pane" role="tabpanel" class="acc-dis_tab-pane" id="acc-tabpanel-{{ forloop.index }}" aria-labelledby="acc-tab-{{ forloop.index }}" x-bind:style="tab === {{ forloop.index }} ? { display: 'grid' } : { display: 'none' }" {{ block.shopify_attributes }}>
                    {% if block.settings.image_logo %}
{{ block.settings.image_logo | image_url: width: 200 | image_tag: loading: 'lazy', class: 'acc-dis_logo' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="acc-dis_logo">
{% endif %}
                </div> {% schema %} {
    "name": "Tab Pane",
    "settings": [
        {
            "id": "image_logo",
            "type": "image_picker",
            "label": "Logo"
        }
    ],
    "presets": [
        {
            "name": "Tab Pane",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}