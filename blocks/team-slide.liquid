<div li-block="Team Slide" class="swiper-slide is-team-swiper" {{ block.shopify_attributes }}>
                    {% if block.settings.image_slide_image %}
{{ block.settings.image_slide_image | image_url: width: 900 | image_tag: li-if: 'block.settings.image_slide_image != blank', loading: 'lazy', class: 'team_slide-image' }}
{% else %}
<img li-if="block.settings.image_slide_image != blank" src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="team_slide-image">
{% endif %}
                    <div class="team_slide-overlay"></div>
                </div> {% schema %} {
    "name": "Team Slide",
    "settings": [
        {
            "id": "image_slide_image",
            "type": "image_picker",
            "label": "Slide Image"
        }
    ],
    "presets": [
        {
            "name": "Team Slide",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}