<div li-block="Trend Tag" style="display:contents" {{ block.shopify_attributes }}>
                    {% if block.settings.text_text != blank %}    <span class="li-guard" li-if="block.settings.text_text != blank">
    <a href="{{ block.settings.url_link }}" class="reseller-hero_trend w-inline-block"> <span>{{ block.settings.text_text }}</span> </a>    </span>
{% endif %}
                </div> {% schema %} {
    "name": "Trend Tag",
    "settings": [
        {
            "id": "url_link",
            "type": "url",
            "label": "Link"
        },
        {
            "id": "text_text",
            "type": "text",
            "label": "Text",
            "default": "Summer Release"
        }
    ],
    "presets": [
        {
            "name": "Trend Tag",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}