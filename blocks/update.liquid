<div li-block="Update" style="display:contents" {{ block.shopify_attributes }}>
                    <a href="{{ block.settings.url_link }}" class="news-updates_link w-inline-block"> <div class="news-updates_link-text"><span class="news-updates_link-title">{{ block.settings.text_titel }}</span>{% if block.settings.text_untertitel != blank %} <span class="li-guard" li-if="block.settings.text_untertitel != blank"> <span class="news-updates_link-sub">{{ block.settings.text_untertitel }}</span> </span>{% endif %}</div><span class="news-updates_link-arrow w-embed"><svg width="100%" height="100%" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 12H19M13 6L19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span> </a>
                </div> {% schema %} {
    "name": "Update",
    "settings": [
        {
            "id": "url_link",
            "type": "url",
            "label": "Link"
        },
        {
            "id": "text_titel",
            "type": "text",
            "label": "Titel",
            "default": "New price list"
        },
        {
            "id": "text_untertitel",
            "type": "text",
            "label": "Untertitel",
            "default": "Everyting you need to advertise"
        }
    ],
    "presets": [
        {
            "name": "Update",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}