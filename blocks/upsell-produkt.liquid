<div li-block="Upsell Produkt" class="swiper-slide ph_upsell-card" {{ block.shopify_attributes }}>
                    <img li-object:src="block.settings.upsell_product.featured_image | image_url: width: 140" li-object:alt="block.settings.upsell_product.title" src="{{ block.settings.upsell_product.featured_image | image_url: width: 140 }}" loading="lazy" alt="{{ block.settings.upsell_product.title }}" class="ph_upsell-img">
                    <div class="ph_upsell-info"><a li-object:href="block.settings.upsell_product.url" href="{{ block.settings.upsell_product.url }}" class="ph_upsell-name-link w-inline-block"><span li-object="block.settings.upsell_product.title" class="ph_upsell-name">{{ block.settings.upsell_product.title }}</span></a><span li-object="block.settings.upsell_product.price | money" class="ph_upsell-price">{{ block.settings.upsell_product.price | money }}</span><form method="post" action="/cart/add" class="ph_upsell-form"><input type="hidden" name="id" value="{{ block.settings.upsell_product.selected_or_first_available_variant.id }}"><script src="{{ 'li_custom.js' | asset_url }}" type="text/javascript"></script>
<button class="ph_upsell-btn" li-element="direct-add-to-cart" x-data="handleVariant({{ product | json | escape }}, {{ product.options_by_name | json | escape }}, {{ product.selected_or_first_available_variant | json | escape }})" @click="addToCart($event, true)">Add</button></form></div>
                    
                </div> {% schema %} {
    "name": "Upsell Produkt",
    "settings": [
        {
            "type": "product",
            "id": "upsell_product",
            "label": "Produkt"
        }
    ],
    "presets": [
        {
            "name": "Upsell Produkt",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}