<div li-block="Upsell" {{ block.shopify_attributes }}>
                    {% if product.metafields.shopify--discovery--product_recommendation.complementary_products != blank %}    <div class="li-guard" li-if="product.metafields.shopify--discovery--product_recommendation.complementary_products != blank">
    <div class="ph_upsell"><div class="ph_upsell-header"><span class="ph_upsell-title">
{{ block.settings.text_upsell_titel }}
