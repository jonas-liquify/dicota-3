                                    <img li-object:src="upsell_product.featured_image | image_url: width: 140" li-object:alt="upsell_product.title" src="{{ upsell_product.featured_image | image_url: width: 140 }}" loading="lazy" alt="{{ upsell_product.title }}" class="ph_upsell-img">
                            <div class="ph_upsell-info"><a li-object:href="upsell_product.url" href="{{ upsell_product.url }}" class="ph_upsell-name-link w-inline-block"><span li-object="upsell_product.title" class="ph_upsell-name">{{ upsell_product.title }}</span></a><span li-object="upsell_product.price | money" class="ph_upsell-price">{{ upsell_product.price | money }}</span><form method="post" action="/cart/add" class="ph_upsell-form"><input type="hidden" name="id" value="{{ upsell_product.selected_or_first_available_variant.id }}"><script src="{{ 'li_custom.js' | asset_url }}" type="text/javascript"></script>
