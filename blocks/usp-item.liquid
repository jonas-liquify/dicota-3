<div li-block="USP Item" class="product-usp-bar_item" {{ block.shopify_attributes }}>
                    {% if block.settings.image_icon != blank %}    <div li-if="block.settings.image_icon != blank" class="product-usp-bar_icon-wrap">
    {% if block.settings.image_icon %}
{{ block.settings.image_icon | image_url: width: 48 | image_tag: loading: 'lazy', class: 'product-usp-bar_icon' }}
{% else %}
<img src="{{ 'placeholder.svg' | asset_url }}" loading="lazy" alt="" class="product-usp-bar_icon">
{% endif %}    </div>
{% endif %}
                    <div class="product-usp-bar_content"><p class="product-usp-bar_title">
{{ block.settings.text_titel }}
</p><p class="product-usp-bar_desc"> {{ block.settings.textarea_beschreibung }} </p></div>
                </div> {% schema %} {
    "name": "USP Item",
    "settings": [
        {
            "id": "image_icon",
            "type": "image_picker",
            "label": "Icon"
        },
        {
            "id": "text_titel",
            "type": "text",
            "label": "Titel",
            "default": "Free shipping"
        },
        {
            "id": "textarea_beschreibung",
            "type": "textarea",
            "label": "Beschreibung",
            "default": "On orders over 50 EUR, fast and reliable"
        }
    ],
    "presets": [
        {
            "name": "USP Item",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}