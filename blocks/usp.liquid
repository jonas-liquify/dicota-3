<div li-block="USP" class="announcement-bar_item" {{ block.shopify_attributes }}>
                    {% if block.settings.image_icon %}
{{ block.settings.image_icon | image_url: width: 40 | image_tag: loading: 'lazy', class: 'announcement-bar_icon' }}
{% else %}
<img src="{{ 'payment.svg' | asset_url }}" loading="lazy" alt="" class="announcement-bar_icon">
{% endif %}
                    <div class="text-size-tiny announcement-bar_text">
{{ block.settings.text_text }}
</div>
                </div> {% schema %} {
    "name": "USP",
    "settings": [
        {
            "id": "image_icon",
            "type": "image_picker",
            "label": "Icon"
        },
        {
            "id": "text_text",
            "type": "text",
            "label": "Text",
            "default": "Gratis Versand ab 100 EUR"
        }
    ],
    "presets": [
        {
            "name": "USP",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}