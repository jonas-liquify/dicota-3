<div li-block="USP" class="announcement-bar_item" {{ block.shopify_attributes }}>
                    <div class="announcement-bar_icon w-embed">{% if block.settings.image_icon %}
{{ block.settings.image_icon | image_url: width: 1000 | image_tag: width: '100%', height: '100%', viewbox: '0 0 24 24', fill: 'none', xmlns: 'http://www.w3.org/2000/svg' }}
{% else %}
<img width="100%" height="100%" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
{% endif %}</div>
                    <div class="announcement-bar_text">
{{ block.settings.text_text }}
</div>
                </div> {% schema %} {
    "name": "USP",
    "settings": [
        {
            "id": "image_icon",
            "type": "image_picker",
            "label": "Icon"
        },
        {
            "id": "text_text",
            "type": "text",
            "label": "Text",
            "default": "Free shipping over 100 EUR"
        }
    ],
    "presets": [
        {
            "name": "USP",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}