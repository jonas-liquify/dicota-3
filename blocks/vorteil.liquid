<div li-block="Vorteil" class="swiper-slide dicota-difference_card" {{ block.shopify_attributes }}>
                    <div class="dicota-difference_icon">{% if block.settings.image_icon %}
{{ block.settings.image_icon | image_url: width: 120 | image_tag: loading: 'lazy', class: 'dicota-difference_icon-img' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="dicota-difference_icon-img">
{% endif %}</div>
                    <div class="dicota-difference_card-text"><h3 class="dicota-difference_card-title text-size-regular text-weight-bold">
{{ block.settings.text_titel }}
</h3><p class="dicota-difference_card-desc text-size-small"> {{ block.settings.textarea_text }} </p></div>
                </div> {% schema %} {
    "name": "Vorteil",
    "settings": [
        {
            "id": "image_icon",
            "type": "image_picker",
            "label": "Icon"
        },
        {
            "id": "text_titel",
            "type": "text",
            "label": "Titel",
            "default": "Suplier of the top 100:"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "(Placeholder) trade in your current device. Get credit toward a new one."
        }
    ],
    "presets": [
        {
            "name": "Vorteil",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}