<div class="padding-global" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"><div class="container-large"><div class="accessories_header"><h2 class="accessories_title heading-style-h2">
{{ section.settings.text_uberschrift }}
</h2><div id="accessories-tabs" class="accessories_tabs"></div></div><div class="accessories_slider-wrapper"><div li-cf-theme-blocks="" class="accessories_categories">
{% content_for 'blocks' %}
</div><button type="button" class="accessories_arrow swiper-button-next" aria-label="Weiter"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_right' %}</div></button><button type="button" class="accessories_arrow is-prev swiper-button-prev" aria-label="Zurück"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_left' %}</div></button></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Accessories Slider",
    "class": "section_accessories",
    "blocks": [
        {
            "type": "kategorie"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Zubeh\u00f6r &amp; Accessories"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 60
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#0f0f0f"
        }
    ],
    "presets": [
        {
            "name": "Accessories Slider",
            "category": "Listing",
            "blocks": [
                {
                    "type": "kategorie"
                }
            ]
        }
    ]
} {% endschema %}