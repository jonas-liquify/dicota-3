<div class="padding-global" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem; background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"><div class="container-large" x-data="{ active: null }"><div class="accessories_header"><h2 class="accessories_title heading-style-h2">
{{ section.settings.text_uberschrift }}
</h2><div id="accessories-tabs" class="accessories_tabs"></div></div><div class="accessories_slider-wrapper"><div li-cf-theme-blocks="" class="accessories_categories">
{% content_for 'blocks' %}
</div><button type="button" class="accessories_arrow swiper-button-next" aria-label="Next"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_right' %}</div></button><button type="button" class="accessories_arrow is-prev swiper-button-prev" aria-label="Previous"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_left' %}</div></button></div></div></div><div class="hide w-embed w-script"><script>document.addEventListener("DOMContentLoaded", function() { var ensure = function(cb) { if (typeof Swiper !== "undefined") return cb(); if (window.__swiperLoading) return window.__swiperLoading.then(cb); var s = document.createElement("script"); s.src = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"; var link = document.createElement("link"); link.rel = "stylesheet"; link.href = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"; document.head.appendChild(link); window.__swiperLoading = new Promise(function(res) { s.onload = res; }); document.head.appendChild(s); window.__swiperLoading.then(cb); }; ensure(function() { document.querySelectorAll(".accessories_swiper.swiper").forEach(function(el) { if (el.swiper) return; var root = el.closest(".section_accessories") || document; new Swiper(el, { slidesPerView: "auto", spaceBetween: 2, navigation: { nextEl: root.querySelector(".accessories_arrow.swiper-button-next"), prevEl: root.querySelector(".accessories_arrow.is-prev"), disabledClass: "swiper-button-disabled" }, scrollbar: { el: el.querySelector(".accessories_scrollbar"), draggable: true } }); }); }); });</script></div> {% schema %} {
    "tag": "section",
    "name": "Accessories Slider",
    "class": "section_accessories",
    "blocks": [
        {
            "type": "kategorie-wrapper"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Accessories"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 4
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#0f0f0f"
        }
    ],
    "presets": [
        {
            "name": "Accessories Slider",
            "category": "Listing",
            "blocks": [
                {
                    "type": "kategorie-wrapper"
                }
            ]
        }
    ]
} {% endschema %}