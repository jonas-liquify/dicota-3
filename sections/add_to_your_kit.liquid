<div class="padding-global" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"><div class="container-large"><div class="product-add-to-kit_header"><h2 class="product-add-to-kit_headline">
{{ section.settings.text_uberschrift }}
</h2><div class="product-add-to-kit_tabs"><button class="product-add-to-kit_tab is-active" data-tab="0">
{{ section.settings.text_tab_1_label }}
</button><button class="product-add-to-kit_tab" data-tab="1">
{{ section.settings.text_tab_2_label }}
</button><button class="product-add-to-kit_tab" data-tab="2">
{{ section.settings.text_tab_3_label }}
</button><button class="product-add-to-kit_tab" data-tab="3">
{{ section.settings.text_tab_4_label }}
</button></div></div><div class="swiper is-add-to-kit"><div li-cf-theme-blocks="" class="swiper-wrapper is-add-to-kit">
{% content_for 'blocks' %}
</div></div></div></div><div class="hide w-embed w-script"><script>document.addEventListener("DOMContentLoaded", function() {  new Swiper(".swiper.is-add-to-kit", {    slidesPerView: "auto",    spaceBetween: 24,    grabCursor: true,    breakpoints: { 0: { spaceBetween: 16 }, 768: { spaceBetween: 24 } }  });  var tabs = document.querySelectorAll(".product-add-to-kit_tab");  tabs.forEach(function(tab) {    tab.addEventListener("click", function() {      tabs.forEach(function(t) { t.classList.remove("is-active"); });      this.classList.add("is-active");    });  });});</script></div> {% schema %} {
    "tag": "section",
    "name": "Add to Your Kit",
    "class": "section_product-add-to-kit",
    "blocks": [
        {
            "type": "produkt-karte"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Add to Your Kit"
        },
        {
            "id": "text_tab_1_label",
            "type": "text",
            "label": "Tab 1 Label",
            "default": "Screen Filters"
        },
        {
            "id": "text_tab_2_label",
            "type": "text",
            "label": "Tab 2 Label",
            "default": "Locks"
        },
        {
            "id": "text_tab_3_label",
            "type": "text",
            "label": "Tab 3 Label",
            "default": "Hub Chargers"
        },
        {
            "id": "text_tab_4_label",
            "type": "text",
            "label": "Tab 4 Label",
            "default": "Input Devices"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#000000"
        }
    ],
    "presets": [
        {
            "name": "Add to Your Kit",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "produkt-karte"
                }
            ]
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}