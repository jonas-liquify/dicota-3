<div class="padding-global" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">{% if product.metafields.shopify--discovery--product_recommendation.complementary_products != blank %}    <div class="container-large" li-if="product.metafields.shopify--discovery--product_recommendation.complementary_products != blank">
    <div class="product-add-to-kit_header"><h2 class="product-add-to-kit_headline heading-style-h3">
{{ section.settings.text_uberschrift }}
</h2></div><div class="swiper is-add-to-kit"><div class="swiper-wrapper is-add-to-kit">{% for kit_product in product.metafields.shopify--discovery--product_recommendation.complementary_products.value %}    <div class="swiper-slide is-add-to-kit" li-for="kit_product in product.metafields.shopify--discovery--product_recommendation.complementary_products.value">
                                    {% render 'product_card', product: kit_product %}
                        </div>
{% endfor %}</div></div>    </div>
{% endif %}</div><div class="hide w-embed w-script"><script>document.addEventListener("DOMContentLoaded", function() { var ensure = function(cb) { if (typeof Swiper !== "undefined") return cb(); if (window.__swiperLoading) return window.__swiperLoading.then(cb); var s = document.createElement("script"); s.src = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"; var link = document.createElement("link"); link.rel = "stylesheet"; link.href = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"; document.head.appendChild(link); window.__swiperLoading = new Promise(function(res) { s.onload = res; }); document.head.appendChild(s); window.__swiperLoading.then(cb); }; ensure(function() { document.querySelectorAll(".swiper.is-add-to-kit").forEach(function(el) { if (el.swiper) return; new Swiper(el, { slidesPerView: "auto", spaceBetween: 24, grabCursor: true, breakpoints: { 0: { spaceBetween: 16 }, 768: { spaceBetween: 24 } } }); }); });</script></div> {% schema %} {
    "tag": "section",
    "name": "Add to Your Kit",
    "class": "section_product-add-to-kit",
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Add to Your Kit"
        },
        {
            "type": "paragraph",
            "content": "Die Produkte kommen automatisch aus den Complementary Products (Shopify Search &amp; Discovery) des aktuellen Produkts \u2014 Metafeld shopify--discovery--product_recommendation.complementary_products. Ohne gepflegte Complementary-Produkte wird die Section ausgeblendet. Nur die \u00dcberschrift ist editierbar."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#000000"
        }
    ],
    "presets": [
        {
            "name": "Add to Your Kit",
            "category": "Product",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}