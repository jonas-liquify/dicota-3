<div class="announcement-bar_container"><div li-cf-theme-blocks="" class="announcement-bar_items">
{% content_for 'blocks' %}
</div>{% content_for "block", type: "rechte-seite", id: "rechte-seite" %}</div> {% schema %} {
    "tag": "section",
    "name": "Announcement Bar",
    "class": "section_announcement-bar",
    "blocks": [
        {
            "type": "usp"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "url_link_url",
            "type": "url",
            "label": "Link URL"
        },
        {
            "id": "text_link_text",
            "type": "text",
            "label": "Link Text",
            "default": "\u00dcber DICOTA"
        },
        {
            "type": "checkbox",
            "id": "highlighted",
            "label": "Hervorheben (Hintergrund-Akzent)",
            "default": false
        }
    ],
    "presets": [
        {
            "name": "Announcement Bar",
            "category": "Global",
            "blocks": [
                {
                    "type": "usp"
                },
                {
                    "type": "rechte-seite",
                    "static": true,
                    "id": "rechte-seite"
                }
            ]
        }
    ],
    "enabled_on": {
        "groups": [
            "*"
        ]
    }
} {% endschema %}