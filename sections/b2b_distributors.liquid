<div class="padding-global padding-section-small" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem"><div class="container-large"><div class="acc-default_wrapper"><div class="acc-default_flex-small"><div class="default-flex-tiny"><h1 class="heading-style-h2">
{{ section.settings.text_heading }}
</h1><div class="text-size-medium max-width-large"> {{ section.settings.textarea_subheading }} </div></div><div x-data="{tab: 1}" role="tablist" class="acc-dis_tab-component">{% content_for "block", type: "b2b-menu", id: "b2b-menu" %}{% content_for "block", type: "b2b-panes", id: "b2b-panes" %}</div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Distributors",
    "class": "section_acc-default",
    "blocks": [
        {
            "type": "b2b-region"
        },
        {
            "type": "b2b-region-pane"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Distributor Overview"
        },
        {
            "id": "textarea_subheading",
            "type": "textarea",
            "label": "Subheading",
            "default": "Authorized DICOTA distribution partners by region \u2014 contacts and details at a glance."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 4
        }
    ],
    "presets": [
        {
            "name": "B2B Distributors",
            "category": "_B2B",
            "blocks": [
                {
                    "type": "b2b-menu",
                    "static": true,
                    "id": "b2b-menu",
                    "blocks": [
                        {
                            "type": "b2b-region"
                        }
                    ]
                },
                {
                    "type": "b2b-panes",
                    "static": true,
                    "id": "b2b-panes",
                    "blocks": [
                        {
                            "type": "b2b-region-pane"
                        }
                    ]
                }
            ]
        }
    ]
} {% endschema %}