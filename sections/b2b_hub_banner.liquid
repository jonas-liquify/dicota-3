<div class="padding-global padding-section-small" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem"><div class="container-large"><div class="acc-default_wrapper"><div class="acc-banner text-color-white">{% if section.settings.image_bild != blank %}    <span class="li-guard" li-if="section.settings.image_bild != blank">
    {% if section.settings.image_bild %}
{{ section.settings.image_bild | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'acc-banner_image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="acc-banner_image">
{% endif %}    </span>
{% endif %}<div class="acc-banner_content"><h3 class="heading-style-h2">
{{ section.settings.text_heading }}
</h3><div class="text-size-medium"> {{ section.settings.textarea_text }} </div>{% if section.settings.text_button_text != blank %}    <div class="li-guard" li-if="section.settings.text_button_text != blank">
    <div class="button-group margin-top margin-small"><a href="{{ section.settings.url_button_link }}" class="button is-white w-button"> <span>{{ section.settings.text_button_text }}</span> </a></div>    </div>
{% endif %}</div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Hub Banner",
    "class": "section_acc-default",
    "settings": [
        {
            "id": "image_bild",
            "type": "image_picker",
            "label": "Bild"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Exclusive offer"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "This month only: double points on all physical rewards."
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Learn more"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 2
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 2
        }
    ],
    "presets": [
        {
            "name": "B2B Hub Banner",
            "category": "_B2B",
            "blocks": []
        }
    ]
} {% endschema %}