<div class="padding-global padding-section-small" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem"><div class="container-large"><div class="acc-default_wrapper"><div class="acc-default_flex-small"><div class="default-flex-tiny"><h1 class="heading-style-h2">
{{ section.settings.text_heading_1 }}
</h1><div class="text-size-medium max-width-large"> {{ section.settings.textarea_subheading }} </div></div><div class="acc-card"><div class="acc-default_flex-small max-width-full"><h2 class="heading-style-h4">
{{ section.settings.text_heading_2 }}
</h2><div li-cf-theme-blocks="" class="acc-triple">
{% content_for 'blocks' %}
</div></div></div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Kontakt",
    "class": "section_acc-default",
    "blocks": [
        {
            "type": "b2b-kontakt"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading_1",
            "type": "text",
            "label": "Heading 1",
            "default": "Sales Support"
        },
        {
            "id": "textarea_subheading",
            "type": "textarea",
            "label": "Subheading",
            "default": "Your direct line to the DICOTA sales team for individual requests."
        },
        {
            "id": "text_heading_2",
            "type": "text",
            "label": "Heading 2",
            "default": "DICOTA Schweiz AG"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 4
        }
    ],
    "presets": [
        {
            "name": "B2B Kontakt",
            "category": "_B2B",
            "blocks": [
                {
                    "type": "b2b-kontakt"
                }
            ]
        }
    ]
} {% endschema %}