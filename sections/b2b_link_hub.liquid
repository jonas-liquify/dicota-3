<div class="padding-global padding-section-small" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"><div class="container-large"><div class="acc-default_wrapper"><div class="acc-default_flex-small"><div class="default-flex-tiny">{% if section.settings.text_subline != blank %}    <div class="li-guard" li-if="section.settings.text_subline != blank">
    <div class="text-style-subline">
{{ section.settings.text_subline }}
</div>    </div>
{% endif %}<h1 class="heading-style-h2">
{{ section.settings.text_heading_1 }}
</h1><div class="text-size-medium max-width-large"> {{ section.settings.textarea_subheading_1 }} </div></div></div><div class="acc-default_flex-small"><div class="default-flex-tiny"><h2 class="heading-style-h4">
{{ section.settings.text_heading_2 }}
</h2></div><div li-cf-theme-blocks="" class="acc-triple">
{% content_for 'blocks' %}
</div></div><div class="acc-banner text-color-white">{% if section.settings.image_banner_bild != blank %}    <span class="li-guard" li-if="section.settings.image_banner_bild != blank">
    {% if section.settings.image_banner_bild %}
{{ section.settings.image_banner_bild | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'acc-banner_image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="acc-banner_image">
{% endif %}    </span>
{% endif %}<div class="acc-banner_content">{% if section.settings.text_banner_subline != blank %}    <div class="li-guard" li-if="section.settings.text_banner_subline != blank">
    <div class="text-style-subline">
{{ section.settings.text_banner_subline }}
</div>    </div>
{% endif %}<h3 class="heading-style-h2">
{{ section.settings.text_banner_heading }}
</h3><div class="text-size-medium"> {{ section.settings.textarea_banner_text }} </div><div class="button-group margin-top margin-small">{% if section.settings.text_banner_button_text != blank %}    <span class="li-guard" li-if="section.settings.text_banner_button_text != blank">
    <a href="{{ section.settings.url_banner_button_link }}" class="button is-white w-button"> <span>{{ section.settings.text_banner_button_text }}</span> </a>    </span>
{% endif %}</div></div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Link Hub",
    "class": "section_acc-default",
    "blocks": [
        {
            "type": "b2b-hub-card"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_subline",
            "type": "text",
            "label": "Subline",
            "default": "B2B Solutions"
        },
        {
            "id": "text_heading_1",
            "type": "text",
            "label": "Heading 1",
            "default": "Solutions for every business need"
        },
        {
            "id": "textarea_subheading_1",
            "type": "textarea",
            "label": "Subheading 1",
            "default": "DICOTA's services, expertise, and portfolio through clear B2B-focused storytelling \u2014 supported by facts, references, and concrete product offerings."
        },
        {
            "id": "text_heading_2",
            "type": "text",
            "label": "Heading 2",
            "default": "Explore our solution areas"
        },
        {
            "id": "image_banner_bild",
            "type": "image_picker",
            "label": "Banner Bild"
        },
        {
            "id": "text_banner_subline",
            "type": "text",
            "label": "Banner Subline",
            "default": "Tailored"
        },
        {
            "id": "text_banner_heading",
            "type": "text",
            "label": "Banner Heading",
            "default": "Need something specific?"
        },
        {
            "id": "textarea_banner_text",
            "type": "textarea",
            "label": "Banner Text",
            "default": "From branded products and individual configurations to fully tailor-made concepts for specific customer and corporate requirements."
        },
        {
            "id": "url_banner_button_link",
            "type": "url",
            "label": "Banner Button Link"
        },
        {
            "id": "text_banner_button_text",
            "type": "text",
            "label": "Banner Button Text",
            "default": "Talk to us"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 4
        }
    ],
    "presets": [
        {
            "name": "B2B Link Hub",
            "category": "_B2B",
            "blocks": [
                {
                    "type": "b2b-hub-card"
                }
            ]
        }
    ]
} {% endschema %}