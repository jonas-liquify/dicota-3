            "id": "text_subline",
            "type": "text",
            "label": "Subline",
            "default": "B2B Solutions"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Solutions for every business need"
        },
        {
            "id": "textarea_subheading",
            "type": "textarea",
            "label": "Subheading",
            "default": "DICOTA's services, expertise, and portfolio through clear B2B-focused storytelling \u2014 supported by facts, references, and concrete product offerings."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 2
        }
    ],
    "presets": [
        {
            "name": "B2B Link Hub Header",
            "category": "_B2B",
            "blocks": []
        }
    ]
} {% endschema %}