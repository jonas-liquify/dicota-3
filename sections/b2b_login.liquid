<div class="split-image_content-wrapper is-right-image"><div class="default-flex-small"><div class="text-style-subline">
{{ section.settings.text_subline }}
</div><h1 class="heading-style-h1">
{{ section.settings.text_heading }}
</h1><div class="text-size-regular"> {{ section.settings.textarea_text }} </div></div><div class="b2b-login_form-block w-form">{% form 'customer-login', class: 'b2b-login_form' %}
<div class="b2b-login_field"><label for="b2b-email" class="b2b-login_label">Email address*</label><input class="b2b-login_input w-input" maxlength="256" name="customer[email]" placeholder="e.g. partner@company.com" type="email" id="b2b-email" required=""></div><div class="b2b-login_field"><label for="b2b-password" class="b2b-login_label">Password*</label><input class="b2b-login_input w-input" maxlength="256" name="customer[password]" placeholder="••••••••" type="password" id="b2b-password" required=""></div><div class="b2b-login_links"><a href="{{ section.settings.url_passwort_vergessen_link }}" class="text-size-small text-weight-medium text-style-link"> <span>{{ section.settings.text_passwort_vergessen_text }}</span> </a></div><div class="button-group margin-top margin-small"><input type="submit" data-wait="Please wait..." class="button is-white w-button" value="Log in"></div><div class="b2b-login_register"><div class="text-size-small">
{{ section.settings.text_registrieren_text }}
</div><a href="{{ section.settings.url_registrieren_link }}" class="text-size-small text-weight-medium text-style-link"> <span>{{ section.settings.text_registrieren_link_text }}</span> </a></div>{% endform %}</div></div><div class="split-image_image-block">{% if section.settings.image_bild %}
{{ section.settings.image_bild | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'split-image_image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="split-image_image">
{% endif %}</div> {% schema %} {
    "tag": "section",
    "name": "B2B Login",
    "class": "section_split-image-right section_b2b-login background-color-primary",
    "settings": [
        {
            "id": "text_subline",
            "type": "text",
            "label": "Subline",
            "default": "B2B partner"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Welcome to the DICOTA Partner Area"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "Log in to access volume pricing, marketing materials and exclusive partner content."
        },
        {
            "id": "url_passwort_vergessen_link",
            "type": "url",
            "label": "Passwort vergessen Link"
        },
        {
            "id": "text_passwort_vergessen_text",
            "type": "text",
            "label": "Passwort vergessen Text",
            "default": "Forgot your password?"
        },
        {
            "id": "text_registrieren_text",
            "type": "text",
            "label": "Registrieren Text",
            "default": "No partner account yet?"
        },
        {
            "id": "url_registrieren_link",
            "type": "url",
            "label": "Registrieren Link"
        },
        {
            "id": "text_registrieren_link_text",
            "type": "text",
            "label": "Registrieren Link Text",
            "default": "Register now \u2192"
        },
        {
            "id": "image_bild",
            "type": "image_picker",
            "label": "Bild"
        }
    ],
    "presets": [
        {
            "name": "B2B Login",
            "category": "Form",
            "blocks": []
        }
    ]
} {% endschema %}