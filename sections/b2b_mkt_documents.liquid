<div class="padding-global" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem"><div class="container-large"><div class="mkt-collection_card"><div class="mkt-collection_header"><h2 class="mkt-collection_title heading-style-h4">
{{ section.settings.text_uberschrift }}
</h2></div><div li-cf-theme-blocks="" class="mkt-doc_grid">
{% content_for 'blocks' %}
</div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Mkt Documents",
    "class": "section_mkt-collection",
    "blocks": [
        {
            "type": "b2b-mkt-dokument"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Documents"
        },
        {
            "type": "paragraph",
            "content": "2-spaltiges Download-Grid f\u00fcr Dokumente (ZIP, PDF etc.). Jeder Block: File-Icon, Titel, Datei-Info (z.B. \u201eZIP \u00b7 25 MB\u201c) und Download-Icon. Klick auf die ganze Karte triggert den Download."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 4
        }
    ],
    "presets": [
        {
            "name": "B2B Mkt Documents",
            "category": "_B2B Mkt",
            "blocks": [
                {
                    "type": "b2b-mkt-dokument"
                }
            ]
        }
    ]
} {% endschema %}