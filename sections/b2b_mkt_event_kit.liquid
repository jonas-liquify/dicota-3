<div class="padding-global padding-section-small" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem"><div class="container-large"><div class="acc-default_wrapper"><div class="acc-default_flex-small"><div class="default-flex-tiny"><h1 class="heading-style-h2">
{{ section.settings.text_heading }}
</h1>{% if section.settings.textarea_subheading != blank %}    <div class="li-guard" li-if="section.settings.textarea_subheading != blank">
    <div class="text-size-medium max-width-large"> {{ section.settings.textarea_subheading }} </div>    </div>
{% endif %}</div><div class="acc-banner text-color-white">{% if section.settings.image_banner_bild != blank %}    <span class="li-guard" li-if="section.settings.image_banner_bild != blank">
    {% if section.settings.image_banner_bild %}
{{ section.settings.image_banner_bild | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'acc-banner_image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="acc-banner_image">
{% endif %}    </span>
{% endif %}<div class="acc-banner_content"><div class="acc-banner_heading"><div class="acc-banner_tag-row">{% if section.settings.text_tag != blank %}    <div li-if="section.settings.text_tag != blank" class="acc-banner_tag">
    <div class="text-style-subline">
{{ section.settings.text_tag }}
</div>    </div>
{% endif %}</div><h3 class="heading-style-h2">
{{ section.settings.text_banner_heading }}
</h3></div><div class="text-size-medium"> {{ section.settings.textarea_banner_text }} </div><div class="acc-banner_button-wrapper">{% if section.settings.text_banner_button_text != blank %}    <span class="li-guard" li-if="section.settings.text_banner_button_text != blank">
    <a href="{{ section.settings.url_banner_button_link }}" class="button is-white w-button"> <span>{{ section.settings.text_banner_button_text }}</span> </a>    </span>
{% endif %}</div></div></div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Mkt Event Kit",
    "class": "section_acc-default",
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Event Kit"
        },
        {
            "id": "textarea_subheading",
            "type": "textarea",
            "label": "Subheading",
            "default": "Complete trade show package: roll-ups, table covers, brochures and product samples."
        },
        {
            "id": "image_banner_bild",
            "type": "image_picker",
            "label": "Banner Bild"
        },
        {
            "id": "text_tag",
            "type": "text",
            "label": "Tag",
            "default": "Standard Kit"
        },
        {
            "id": "text_banner_heading",
            "type": "text",
            "label": "Banner Heading",
            "default": "Trade Show Starter"
        },
        {
            "id": "textarea_banner_text",
            "type": "textarea",
            "label": "Banner Text",
            "default": "Contents: 2 roll-ups, table cover, 100\u00d7 A4 brochures, 50\u00d7 product samples."
        },
        {
            "id": "url_banner_button_link",
            "type": "url",
            "label": "Banner Button Link"
        },
        {
            "id": "text_banner_button_text",
            "type": "text",
            "label": "Banner Button Text",
            "default": "Order kit"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 4
        }
    ],
    "presets": [
        {
            "name": "B2B Mkt Event Kit",
            "category": "_B2B",
            "blocks": []
        }
    ]
} {% endschema %}