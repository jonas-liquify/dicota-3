<div class="padding-global padding-section-small"><div class="container-large"><div class="acc-default_wrapper"><div class="acc-default_flex-small"><ul role="list" class="breadcrumbs_component w-list-unstyled"><li class="breadcrumbs_item"><a li-object:href="routes.root_url" href="{{ routes.root_url }}" class="w-inline-block"><div class="text-size-regular">Home</div></a><div class="breadcrumbs_icon w-embed"><svg width="15" height="15" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" fill="none"></path></svg></div></li><li class="breadcrumbs_item"><div>
{{ section.settings.text_breadcrumb }}
</div></li></ul><div class="default-flex-tiny"><h1 class="heading-style-h2">
{{ section.settings.text_heading }}
</h1><div class="text-size-medium max-width-large"> {{ section.settings.textarea_subheading }} </div></div><div class="acc-banner text-color-white">{% if section.settings.image_banner_bild %}
{{ section.settings.image_banner_bild | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'acc-banner_image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="acc-banner_image">
{% endif %}<div class="acc-banner_content"><div class="acc-banner_heading"><div class="acc-banner_tag-row"><div class="acc-banner_tag"><div class="text-style-subline">
{{ section.settings.text_tag }}
</div></div></div><h3 class="heading-style-h2">
{{ section.settings.text_banner_heading }}
</h3></div><div class="text-size-medium"> {{ section.settings.textarea_banner_text }} </div><div class="acc-banner_button-wrapper"><a href="{{ section.settings.url_banner_button_link }}" class="button is-white w-button"> <span>{{ section.settings.text_banner_button_text }}</span> </a></div></div></div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Mkt Event Kit",
    "class": "section_acc-default",
    "settings": [
        {
            "id": "text_breadcrumb",
            "type": "text",
            "label": "Breadcrumb",
            "default": "Event Kit"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Event Kit"
        },
        {
            "id": "textarea_subheading",
            "type": "textarea",
            "label": "Subheading",
            "default": "Komplettes Messe-Paket: Rollups, Tischdecken, Brosch\u00fcren und Produktmuster."
        },
        {
            "id": "image_banner_bild",
            "type": "image_picker",
            "label": "Banner Bild"
        },
        {
            "id": "text_tag",
            "type": "text",
            "label": "Tag",
            "default": "Standard-Kit"
        },
        {
            "id": "text_banner_heading",
            "type": "text",
            "label": "Banner Heading",
            "default": "Trade Show Starter"
        },
        {
            "id": "textarea_banner_text",
            "type": "textarea",
            "label": "Banner Text",
            "default": "Inhalt: 2 Rollups, Tischdecke, 100\u00d7 Brosch\u00fcren A4, 50\u00d7 Produktmuster."
        },
        {
            "id": "url_banner_button_link",
            "type": "url",
            "label": "Banner Button Link"
        },
        {
            "id": "text_banner_button_text",
            "type": "text",
            "label": "Banner Button Text",
            "default": "Kit bestellen"
        }
    ],
    "presets": [
        {
            "name": "B2B Mkt Event Kit",
            "category": "_B2B",
            "blocks": []
        }
    ]
} {% endschema %}