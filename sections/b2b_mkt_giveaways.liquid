<div class="padding-global padding-section-small" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem"><div class="container-large"><div class="acc-default_wrapper"><div class="acc-default_flex-small"><div class="default-flex-tiny"><h1 class="heading-style-h2">
{{ section.settings.text_heading }}
</h1><div class="text-size-medium max-width-large"> {{ section.settings.textarea_subheading }} </div></div>{% form 'contact', class: 'mkt-order_form' %}
<div class="mkt-order_card mkt-order_table-card"><div role="row" class="mkt-order_thead"><div role="columnheader" class="mkt-order_th mkt-order_th-img"><span class="text-style-subline">
{{ section.settings.text_spalte_article }}
</span></div><div role="columnheader" class="mkt-order_th mkt-order_th-desc"><span class="text-style-subline">
{{ section.settings.text_spalte_beschreibung }}
</span></div><div role="columnheader" class="mkt-order_th mkt-order_th-art"><span class="text-style-subline">
{{ section.settings.text_spalte_art_nr }}
</span></div><div role="columnheader" class="mkt-order_th mkt-order_th-price"><span class="text-style-subline">
{{ section.settings.text_spalte_preis }}
</span></div><div role="columnheader" class="mkt-order_th mkt-order_th-qty"><span class="text-style-subline">
{{ section.settings.text_spalte_menge }}
</span></div></div><div li-cf-theme-blocks="" class="mkt-order_tbody">
{% content_for 'blocks' %}
</div></div><div class="mkt-order_card"><div class="mkt-order_field"><label for="mkt-order-date" class="mkt-order_label">{{ section.settings.field_date_label | default: 'Preferred delivery date:' }}<span class="mkt-order_required" aria-hidden="true">*</span></label><p class="mkt-order_help"> {{ section.settings.textarea_datum_hinweistext }} </p><input type="date" id="mkt-order-date" name="contact[Lieferdatum]" required="" class="mkt-order_input"></div></div><div class="mkt-order_card"><div class="mkt-order_field"><label for="mkt-order-event" class="mkt-order_label">{{ section.settings.field_event_label | default: 'Event/Activity:' }}<span class="mkt-order_required" aria-hidden="true">*</span></label><p class="mkt-order_help"> {{ section.settings.textarea_event_hinweistext }} </p><textarea id="mkt-order-event" name="contact[Event/Aktivität]" placeholder="Write to us…" rows="4" required="" class="mkt-order_textarea"></textarea></div></div><div class="mkt-order_submit-row"><button type="submit" class="button mkt-order_submit w-button"><span>
{{ section.settings.text_submit_button }}
</span></button></div>{% endform %}</div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Mkt Giveaways",
    "class": "section_acc-default section_mkt-order",
    "blocks": [
        {
            "type": "b2b-bestell-artikel"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Order Marketing Material"
        },
        {
            "id": "textarea_subheading",
            "type": "textarea",
            "label": "Subheading",
            "default": "Order promotional materials, flyers and giveaways for your next activity. Choose quantities and let us know your delivery date and occasion."
        },
        {
            "id": "text_spalte_article",
            "type": "text",
            "label": "Spalte Article",
            "default": "Article"
        },
        {
            "id": "text_spalte_beschreibung",
            "type": "text",
            "label": "Spalte Beschreibung",
            "default": "Description"
        },
        {
            "id": "text_spalte_art_nr",
            "type": "text",
            "label": "Spalte Art. Nr.",
            "default": "Art. No."
        },
        {
            "id": "text_spalte_preis",
            "type": "text",
            "label": "Spalte Preis",
            "default": "Price"
        },
        {
            "id": "text_spalte_menge",
            "type": "text",
            "label": "Spalte Menge",
            "default": "Amount"
        },
        {
            "id": "textarea_datum_hinweistext",
            "type": "textarea",
            "label": "Datum Hinweistext",
            "default": "Express delivery is charged separately."
        },
        {
            "id": "textarea_event_hinweistext",
            "type": "textarea",
            "label": "Event Hinweistext",
            "default": "What do you need the promotional material for?"
        },
        {
            "id": "text_submit_button",
            "type": "text",
            "label": "Submit Button",
            "default": "Submit now"
        },
        {
            "type": "header",
            "content": "Formular-Labels"
        },
        {
            "type": "text",
            "id": "field_date_label",
            "label": "Label Lieferdatum",
            "default": "Bevorzugtes Lieferdatum:"
        },
        {
            "type": "text",
            "id": "field_event_label",
            "label": "Label Event\/Aktivit\u00e4t",
            "default": "Event\/Aktivit\u00e4t:"
        },
        {
            "type": "paragraph",
            "content": "Bei jedem Bestell-Artikel-Block werden die eingegebenen Mengen, Bezeichnung und Art.-Nr. als Felder ans Shopify-Contact-Formular gesendet. Du erh\u00e4ltst die Bestellung an die Shop-Kontakt-E-Mail."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 4
        }
    ],
    "presets": [
        {
            "name": "B2B Mkt Giveaways",
            "category": "_B2B Mkt",
            "blocks": [
                {
                    "type": "b2b-bestell-artikel"
                }
            ]
        }
    ]
} {% endschema %}