</div></div><div class="text-rich-text w-richtext"> {{ section.settings.richtext_info_text }} </div></div></div></div></div></div></div></div></div><div class="hide w-embed w-script"><script>(function(){function init(){var input=document.getElementById("mkt-pd-search");var list=document.getElementById("mkt-pd-results");var empty=document.getElementById("mkt-pd-empty");if(!input||!list)return;var timer=null;function clear(){list.innerHTML="";list.style.display="none";}function render(products){clear();if(!products.length){if(empty)empty.style.display="block";return;}if(empty)empty.style.display="none";products.forEach(function(p){var li=document.createElement("li");li.className="acc_download-item background-color-secondary max-width-full acc-search_result-item";var row=document.createElement("div");row.className="acc_download-banner";var link=document.createElement("a");link.className="acc_download-banner-left acc-search_result-link w-inline-block";link.href=p.url||"#";var img=document.createElement("img");img.className="acc-search_result-img";img.loading="lazy";img.alt=p.title||"";var src=(p.featured_image&&p.featured_image.url)||p.image||"";if(src)img.src=src;var info=document.createElement("div");var title=document.createElement("div");title.className="text-size-large";title.textContent=p.title||"";var vendor=document.createElement("div");vendor.className="text-size-regular";vendor.textContent=p.vendor||"";info.appendChild(title);info.appendChild(vendor);link.appendChild(img);link.appendChild(info);var dl=document.createElement("a");dl.className="icon-1x1-large w-embed acc-search_result-download";dl.setAttribute("aria-label","Download images");var sep=(p.url||"").indexOf("?")>-1?"&":"?";dl.href=(p.url||"#")+sep+"download=true";dl.innerHTML='<svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" fill="currentColor">';row.appendChild(link);row.appendChild(dl);li.appendChild(row);list.appendChild(li);});list.style.display="flex";}function search(){var q=input.value.trim();if(q.length<2){clear();if(empty)empty.style.display="none";return;}fetch("/search/suggest.json?q="+encodeURIComponent(q)+"&resources[type]=product&resources[limit]=10",{headers:{Accept:"application/json"}}).then(function(r){return r.json();}).then(function(d){var products=(((d.resources||{}).results)||{}).products||[];render(products);}).catch(function(){});}input.addEventListener("input",function(){clearTimeout(timer);timer=setTimeout(search,300);});}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",init);}else{init();}})();</script></div> {% schema %} {
