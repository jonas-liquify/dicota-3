<div class="padding-global" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem"><div class="container-large"><div class="mkt-collection_card"><div class="mkt-collection_header"><h2 class="mkt-collection_title heading-style-h4">
{{ section.settings.text_uberschrift }}
</h2></div><div li-cf-theme-blocks="" class="mkt-video_grid">
{% content_for 'blocks' %}
</div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Mkt Train Videos",
    "class": "section_mkt-collection",
    "blocks": [
        {
            "type": "b2b-mkt-video"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Videos"
        },
        {
            "type": "paragraph",
            "content": "2-spaltiges Video-Grid. Jeder Block ist eine Video-Karte mit Thumbnail (16:9), Play-Icon, \u201eTeilen\u201c-Link (oben rechts), Titel und Beschreibung. Der Video-Link \u00f6ffnet im neuen Tab \u2014 kann YouTube\/Vimeo URL oder direkter Video-Link sein."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 4
        }
    ],
    "presets": [
        {
            "name": "B2B Mkt Train Videos",
            "category": "_B2B Mkt",
            "blocks": [
                {
                    "type": "b2b-mkt-video"
                }
            ]
        }
    ]
} {% endschema %}