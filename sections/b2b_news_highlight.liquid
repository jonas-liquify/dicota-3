<div class="padding-global b2b-news_padding" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem; background-color: {{ section.settings.bg_color }};"><div class="container-large"><div class="b2b-news_panel">{% if section.settings.image_bild != blank %}    <div li-if="section.settings.image_bild != blank" class="b2b-news_media">
    {% if section.settings.image_bild %}
{{ section.settings.image_bild | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'b2b-news_image' }}
{% else %}
<img src="{{ 'hero-apparel-3.svg' | asset_url }}" loading="lazy" alt="" class="b2b-news_image">
{% endif %}    </div>
{% endif %}<div class="b2b-news_content"><div class="b2b-news_head"><div class="b2b-news_meta">{% unless section.settings.badge == blank %}    <span class="li-guard" li-unless="section.settings.badge == blank">
    <span class="b2b-news_badge">
{{ section.settings.text_badge }}
</span>    </span>
{% endunless %}<span class="b2b-news_divider"></span><span class="b2b-news_cat">
{{ section.settings.text_kategorie }}
</span><span class="b2b-news_divider"></span><span class="b2b-news_date">
{{ section.settings.text_datum }}
</span></div><h2 class="b2b-news_title">
{{ section.settings.text_uberschrift }}
</h2></div><p class="b2b-news_text text-size-medium"> {{ section.settings.textarea_text }} </p>{% if section.settings.text_button_text != blank %}    <span class="li-guard" li-if="section.settings.text_button_text != blank">
    <a href="{{ section.settings.url_button_link }}" class="button is-on-dark b2b-news_btn w-button"> <span>{{ section.settings.text_button_text }}</span> </a>    </span>
{% endif %}</div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B News Highlight",
    "class": "section_b2b-news",
    "settings": [
        {
            "id": "image_bild",
            "type": "image_picker",
            "label": "Bild"
        },
        {
            "id": "text_badge",
            "type": "text",
            "label": "Badge",
            "default": "NEW"
        },
        {
            "id": "text_kategorie",
            "type": "text",
            "label": "Kategorie",
            "default": "Company News"
        },
        {
            "id": "text_datum",
            "type": "text",
            "label": "Datum",
            "default": "May 5, 2026"
        },
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Dicota is opening another Office-Complex in Dubai"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "(Placeholder) Since 1992, more than 12 million PET bottles have been processed to minimize waste - DCT (DICOTA Cushion Technology) is a structured cushioning system that absorbs impacts, knocks and pressure from various angles."
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Learn more"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 4
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#f6f6f6"
        }
    ],
    "presets": [
        {
            "name": "B2B News Highlight",
            "category": "_B2B",
            "blocks": []
        }
    ]
} {% endschema %}