<div class="padding-global news-updates_padding" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem; background-color: {{ section.settings.bg_color }};"><div class="container-large"><h2 class="news-updates_heading heading-style-h2"><span class="news-updates_heading-bold">
{{ section.settings.text_titel_fett }}
</span><span class="news-updates_heading-light">
{{ section.settings.text_titel_normal }}
</span></h2><div class="news-updates_slider-wrapper"><div class="news-updates_swiper swiper"><div li-cf-theme-blocks="" class="swiper-wrapper news-updates_list">
{% content_for 'blocks' %}
</div></div><button type="button" class="news-updates_arrow is-prev swiper-button-prev" aria-label="Previous"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_left' %}</div></button><button type="button" class="news-updates_arrow swiper-button-next" aria-label="Next"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_right' %}</div></button></div></div></div><div class="hide w-embed w-script"><script>document.addEventListener("DOMContentLoaded", function() { var ensure = function(cb) { if (typeof Swiper !== "undefined") return cb(); if (window.__swiperLoading) return window.__swiperLoading.then(cb); var s = document.createElement("script"); s.src = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"; var link = document.createElement("link"); link.rel = "stylesheet"; link.href = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"; if(!document.getElementById("swiper-css")){link.id="swiper-css";var _h=document.head,_f=_h.querySelector('link[rel="stylesheet"],style');_f?_h.insertBefore(link,_f):_h.appendChild(link);} window.__swiperLoading = new Promise(function(res) { s.onload = res; }); document.head.appendChild(s); window.__swiperLoading.then(cb); }; ensure(function() { document.querySelectorAll(".news-updates_swiper.swiper").forEach(function(el){ if(el.swiper) return; var root=el.closest(".section_news-updates")||document; new Swiper(el,{ slidesPerView:"auto", spaceBetween:12, navigation:{ nextEl:root.querySelector(".news-updates_arrow.swiper-button-next"), prevEl:root.querySelector(".news-updates_arrow.is-prev"), disabledClass:"swiper-button-disabled" } }); }); }); });</script></div> {% schema %} {
    "tag": "section",
    "name": "B2B News Updates",
    "class": "section_news-updates",
    "blocks": [
        {
            "type": "updates-card"
        },
        {
            "type": "news-card"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_titel_fett",
            "type": "text",
            "label": "Titel fett",
            "default": "Not enough yet?"
        },
        {
            "id": "text_titel_normal",
            "type": "text",
            "label": "Titel normal",
            "default": "More news hot off the press"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 4
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#f6f6f6"
        }
    ],
    "presets": [
        {
            "name": "B2B News Updates",
            "category": "_B2B",
            "blocks": [
                {
                    "type": "updates-card",
                    "blocks": [
                        {
                            "type": "update"
                        }
                    ]
                },
                {
                    "type": "news-card"
                }
            ]
        }
    ]
} {% endschema %}