<div class="padding-global padding-section-large" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"><div class="container-large"><div class="no-access_wrapper"><div class="no-access_icon w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></div><div class="no-access_content"><div li-if="section.settings.text_subline != blank" class="text-style-subline">
{{ section.settings.text_subline }}
</div><h1 class="heading-style-h2">
{{ section.settings.text_uberschrift }}
</h1><div class="text-size-medium max-width-medium"> {{ section.settings.textarea_text }} </div><div class="button-group margin-top margin-small"><a href="{{ section.settings.url_login_link }}" class="button w-button"> <span>{{ section.settings.text_login_text }}</span> </a><a li-if="section.settings.text_sekundar_text != blank" href="{{ section.settings.url_sekundar_link }}" class="button is-secondary w-button"> <span>{{ section.settings.text_sekundar_text }}</span> </a></div></div></div></div></div> {% schema %} {
    "tag": "section",
