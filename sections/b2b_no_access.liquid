        },
        {
            "id": "url_login_link",
            "type": "url",
            "label": "Login Link"
        },
        {
            "id": "text_login_text",
            "type": "text",
            "label": "Login Text",
            "default": "Log in"
        },
        {
            "id": "url_sekundar_link",
            "type": "url",
            "label": "Sekund\u00e4r Link"
        },
        {
            "id": "text_sekundar_text",
            "type": "text",
            "label": "Sekund\u00e4r Text",
