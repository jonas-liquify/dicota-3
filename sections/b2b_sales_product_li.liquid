<div class="padding-global padding-section-small" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem"><div class="container-large"><div class="acc-default_wrapper"><div class="acc-default_flex-small"><div class="default-flex-tiny"><h1 class="heading-style-h2">
{{ section.settings.text_heading }}
</h1><div class="text-size-medium max-width-large"> {{ section.settings.textarea_subheading }} </div></div><div class="acc-card"><div class="default-flex-tiny"><h2 class="heading-style-h4">
{{ section.settings.text_liste_heading }}
</h2>{% if section.settings.text_liste_subheading != blank %}    <div class="li-guard" li-if="section.settings.text_liste_subheading != blank">
    <div class="text-size-regular">
{{ section.settings.text_liste_subheading }}
</div>    </div>
{% endif %}</div><div li-cf-theme-blocks="" class="acc-double">
{% content_for 'blocks' %}
</div><div class="acc_download-item background-color-secondary max-width-full"><div class="acc_download-banner"><div class="acc_download-banner-content"><div class="acc_download-banner-heading"><div class="icon-1x1-large w-embed"><svg width="100%" height="100%" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" fill="none"></circle><path d="M12 8v5m0 3h.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg></div><div class="text-size-large">
{{ section.settings.text_info_heading }}
</div></div><div class="text-rich-text w-richtext"> {{ section.settings.richtext_info_text }} </div></div></div></div></div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Sales Product Li",
    "class": "section_acc-default",
    "blocks": [
        {
            "type": "b2b-sales-download"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Product List"
        },
        {
            "id": "textarea_subheading",
            "type": "textarea",
            "label": "Subheading",
            "default": "Current product range as a download \u2014 all items with prices and availability."
        },
        {
            "id": "text_liste_heading",
            "type": "text",
            "label": "Liste Heading",
            "default": "Product range"
        },
        {
            "id": "text_liste_subheading",
            "type": "text",
            "label": "Liste Subheading",
            "default": "Last updated: this morning."
        },
        {
            "id": "text_info_heading",
            "type": "text",
            "label": "Info Heading",
            "default": "The following information is included:"
        },
        {
            "id": "richtext_info_text",
            "type": "richtext",
            "label": "Info Text",
            "default": "<p>Item no. \u00b7 Predecessor model \u00b7 EAN code \u00b7 Availability \u00b7 Price tiers \u00b7 Construction type \u00b7 Color<\/p>"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 4
        }
    ],
    "presets": [
        {
            "name": "B2B Sales Product Li",
            "category": "_B2B",
            "blocks": [
                {
                    "type": "b2b-sales-download"
                }
            ]
        }
    ]
} {% endschema %}