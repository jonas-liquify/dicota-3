<div class="padding-global padding-section-small"><div class="container-large"><div class="acc-default_wrapper"><div class="acc-default_flex-small"><ul role="list" class="breadcrumbs_component w-list-unstyled"><li class="breadcrumbs_item"><a li-object:href="routes.root_url" href="{{ routes.root_url }}" class="w-inline-block"><div class="text-size-regular">Home</div></a><div class="breadcrumbs_icon w-embed"><svg width="15" height="15" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" fill="none"></path></svg></div></li><li class="breadcrumbs_item"><div>
{{ section.settings.text_breadcrumb }}
</div></li></ul><div class="default-flex-tiny"><h1 class="heading-style-h2">
{{ section.settings.text_heading }}
</h1><div class="text-size-medium max-width-large"> {{ section.settings.textarea_subheading }} </div></div><div x-data="{step: 1}" class="multi-form_component"><div class="multi-form_block w-form"><form name="volumenpreise" data-name="Volumenpreise" method="get" class="multi-form_form"><div class="multi-form_step"><div class="multi-form_heading"><h2 class="heading-style-h4">
{{ section.settings.text_form_heading }}
</h2><div class="multi-form_progress-wrapper"><div class="multi-form_progress-item" x-bind:class="step >= 1 ? '' : 'multi-form_progress-disabled'"><div class="multi-form_progress" x-bind:class="step === 1 ? 'multi-form_progress-current' : step > 1 ? 'completed' : ''"><div>1</div></div><div>
{{ section.settings.text_step_1_label }}
</div></div><div class="multi-form_progress-item" x-bind:class="step >= 2 ? '' : 'multi-form_progress-disabled'"><div class="multi-form_progress" x-bind:class="step === 2 ? 'multi-form_progress-current' : step > 2 ? 'completed' : ''"><div>2</div></div><div>
{{ section.settings.text_step_2_label }}
</div></div><div class="multi-form_progress-item" x-bind:class="step >= 3 ? '' : 'multi-form_progress-disabled'"><div class="multi-form_progress" x-bind:class="step === 3 ? 'multi-form_progress-current' : step > 3 ? 'completed' : ''"><div>3</div></div><div>
{{ section.settings.text_step_3_label }}
</div></div><div class="multi-form_progress-item" x-bind:class="step >= 4 ? '' : 'multi-form_progress-disabled'"><div class="multi-form_progress" x-bind:class="step === 4 ? 'multi-form_progress-current' : ''"><div>4</div></div><div>
{{ section.settings.text_step_4_label }}
</div></div></div></div><div class="multi-form_form-content"><div class="text-size-medium text-weight-medium">Reseller-Daten eingeben</div><div class="multi-form_triple"><div class="form_field-wrapper"><input class="form_input w-input" maxlength="256" name="contact[name]" placeholder=" " type="text" id="ansprechpartner" required=""><label for="ansprechpartner" class="form_label">Ansprechpartner*</label></div><div class="form_field-wrapper"><input class="form_input w-input" maxlength="256" name="contact[email]" placeholder=" " type="email" id="email" required=""><label for="email" class="form_label">E-Mail-Adresse*</label></div><div class="form_field-wrapper"><input class="form_input w-input" maxlength="256" name="contact[phone]" placeholder=" " type="tel" id="telefon"><label for="telefon" class="form_label">Telefon</label></div></div><div class="multi-form_button-group"><button type="button" x-on:click="step = step > 1 ? step - 1 : 1" x-show="step > 1" class="button is-secondary w-button">Zurück</button><button type="button" x-on:click="step = step < 4 ? step + 1 : 4" x-show="step < 4" class="button w-button">Weiter</button><button type="submit" x-show="step === 4" class="button w-button">Absenden</button></div></div></div></form></div></div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B \/ Sales \u2014 Volu",
    "class": "section_acc-default",
    "settings": [
        {
            "id": "text_breadcrumb",
            "type": "text",
            "label": "Breadcrumb",
            "default": "Volumenpreise"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Volumenpreise anfragen"
        },
        {
            "id": "textarea_subheading",
            "type": "textarea",
            "label": "Subheading",
            "default": "Fordere ein individuelles Angebot in vier Schritten an: Reseller-Daten, Distributor, Endkunde und deine Anmerkungen."
        },
        {
            "id": "text_form_heading",
            "type": "text",
            "label": "Form Heading",
            "default": "Angebot anfragen"
        },
        {
            "id": "text_step_1_label",
            "type": "text",
            "label": "Step 1 Label",
            "default": "Reseller"
        },
        {
            "id": "text_step_2_label",
            "type": "text",
            "label": "Step 2 Label",
            "default": "Distributor"
        },
        {
            "id": "text_step_3_label",
            "type": "text",
            "label": "Step 3 Label",
            "default": "Endkunde"
        },
        {
            "id": "text_step_4_label",
            "type": "text",
            "label": "Step 4 Label",
            "default": "Anmerkungen"
        }
    ],
    "presets": [
        {
            "name": "B2B \/ Sales \u2014 Volu",
            "category": "B2B",
            "blocks": []
        }
    ]
} {% endschema %}