        },
        {
            "id": "text_subline",
            "type": "text",
            "label": "Subline",
            "default": "B2B Services"
        },
        {
            "id": "text_heading_1",
            "type": "text",
            "label": "Heading 1",
            "default": "Everything you need to support your business"
        },
        {
            "id": "textarea_subheading_1",
            "type": "textarea",
            "label": "Subheading 1",
            "default": "Find warranty claims, data sheets, declarations, manuals and product tools in one place \u2014 fast self-service for resellers and partners."
        },
        {
            "id": "text_heading_2",
            "type": "text",
            "label": "Heading 2",
            "default": "Browse our services"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 60
        }
    ],
    "presets": [
        {
            "name": "B2B Services Overvie",
            "category": "_B2B",
            "blocks": [
                {
                    "type": "b2b-service-card"
                }
            ]
        }
    ]
} {% endschema %}