<div class="padding-global padding-section-small" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"><div class="container-large"><div class="acc-default_wrapper"><div class="acc-default_flex-small"><ul role="list" class="breadcrumbs_component w-list-unstyled"><li class="breadcrumbs_item"><a li-object:href="routes.root_url" href="{{ routes.root_url }}" class="w-inline-block"><div li-object="'general.home' | t" class="text-size-regular">{{ 'general.home' | t }}</div></a><div class="breadcrumbs_icon w-embed"><svg width="15" height="15" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" fill="none"></path></svg></div></li>{% if section.settings.breadcrumb_parent_label != blank %}    <li li-if="section.settings.breadcrumb_parent_label != blank" class="breadcrumbs_item">
    <a href="{{ section.settings.url_breadcrumb_parent_link }}" class="w-inline-block"> <div class="text-size-regular">{{ section.settings.text_breadcrumb_parent_label }}</div> </a><div class="breadcrumbs_icon w-embed"><svg width="15" height="15" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" fill="none"></path></svg></div>    </li>
{% endif %}<li class="breadcrumbs_item"><div>
{{ section.settings.text_breadcrumb }}
</div></li></ul><div class="default-flex-tiny"><div class="text-style-subline">
{{ section.settings.text_subline }}
</div><h1 class="heading-style-h2">
{{ section.settings.text_heading_1 }}
</h1><div class="text-size-medium max-width-large"> {{ section.settings.textarea_subheading_1 }} </div></div><div class="button-group margin-top margin-small"><a href="{{ section.settings.url_hero_button_link }}" class="button w-button"> <span>{{ section.settings.text_hero_button_text }}</span> </a></div></div><div class="sol-feature"><div class="sol-feature_media">{% if section.settings.image_feature_bild %}
{{ section.settings.image_feature_bild | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'sol-feature_image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="sol-feature_image">
{% endif %}</div><div class="sol-feature_content"><div class="text-style-subline">
{{ section.settings.text_feature_subline }}
</div><h2 class="heading-style-h3">
{{ section.settings.text_feature_heading }}
</h2><div class="text-size-regular"> {{ section.settings.textarea_feature_text }} </div></div></div><div class="acc-default_flex-small"><div class="default-flex-tiny"><h2 class="heading-style-h4">
{{ section.settings.text_facts_heading }}
</h2></div><div li-cf-theme-blocks="" class="sol-facts_grid">
{% content_for 'blocks' %}
</div></div><div class="acc-default_flex-small"><div class="default-flex-tiny"><h2 class="heading-style-h4">
{{ section.settings.text_referenzen_heading }}
</h2></div>{% content_for "block", type: "b2b-sol-referenzen", id: "b2b-sol-referenzen" %}</div><div class="acc-banner text-color-white">{% if section.settings.image_cta_bild %}
{{ section.settings.image_cta_bild | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'acc-banner_image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="acc-banner_image">
{% endif %}<div class="acc-banner_content"><h3 class="heading-style-h2">
{{ section.settings.text_cta_heading }}
</h3><div class="text-size-medium"> {{ section.settings.textarea_cta_text }} </div><div class="button-group margin-top margin-small"><a href="{{ section.settings.url_cta_button_link }}" class="button is-white w-button"> <span>{{ section.settings.text_cta_button_text }}</span> </a></div></div></div></div></div></div> {% schema %} {
