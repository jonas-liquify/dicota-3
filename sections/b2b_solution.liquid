<div class="padding-global padding-section-small" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"><div class="container-large"><div class="acc-default_wrapper"><div class="acc-default_flex-small"><div class="default-flex-tiny">{% if section.settings.text_subline != blank %}    <div class="li-guard" li-if="section.settings.text_subline != blank">
    <div class="text-style-subline">
{{ section.settings.text_subline }}
</div>    </div>
{% endif %}<h1 class="heading-style-h2">
{{ section.settings.text_heading_1 }}
</h1><div class="text-size-medium max-width-large"> {{ section.settings.textarea_subheading_1 }} </div></div><div class="button-group margin-top margin-small">{% if section.settings.text_hero_button_text != blank %}    <span class="li-guard" li-if="section.settings.text_hero_button_text != blank">
    <a href="{{ section.settings.url_hero_button_link }}" class="button w-button"> <span>{{ section.settings.text_hero_button_text }}</span> </a>    </span>
{% endif %}</div></div><div class="sol-feature"><div class="sol-feature_media">{% if section.settings.image_feature_bild != blank %}    <span class="li-guard" li-if="section.settings.image_feature_bild != blank">
    {% if section.settings.image_feature_bild %}
{{ section.settings.image_feature_bild | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'sol-feature_image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="sol-feature_image">
{% endif %}    </span>
{% endif %}</div><div class="sol-feature_content">{% if section.settings.text_feature_subline != blank %}    <div class="li-guard" li-if="section.settings.text_feature_subline != blank">
    <div class="text-style-subline">
{{ section.settings.text_feature_subline }}
</div>    </div>
{% endif %}<h2 class="heading-style-h3">
{{ section.settings.text_feature_heading }}
</h2><div class="text-size-regular"> {{ section.settings.textarea_feature_text }} </div></div></div><div class="acc-default_flex-small"><div class="default-flex-tiny"><h2 class="heading-style-h4">
{{ section.settings.text_facts_heading }}
</h2></div><div li-cf-theme-blocks="" class="sol-facts_grid">
{% content_for 'blocks' %}
</div></div><div class="acc-default_flex-small"><div class="default-flex-tiny"><h2 class="heading-style-h4">
{{ section.settings.text_referenzen_heading }}
</h2></div>{% content_for "block", type: "b2b-sol-referenzen", id: "b2b-sol-referenzen" %}</div><div class="acc-banner text-color-white">{% if section.settings.image_cta_bild != blank %}    <span class="li-guard" li-if="section.settings.image_cta_bild != blank">
    {% if section.settings.image_cta_bild %}
{{ section.settings.image_cta_bild | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'acc-banner_image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="acc-banner_image">
{% endif %}    </span>
{% endif %}<div class="acc-banner_content"><h3 class="heading-style-h2">
{{ section.settings.text_cta_heading }}
</h3><div class="text-size-medium"> {{ section.settings.textarea_cta_text }} </div><div class="button-group margin-top margin-small">{% if section.settings.text_cta_button_text != blank %}    <span class="li-guard" li-if="section.settings.text_cta_button_text != blank">
    <a href="{{ section.settings.url_cta_button_link }}" class="button is-white w-button"> <span>{{ section.settings.text_cta_button_text }}</span> </a>    </span>
{% endif %}</div></div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Solution",
    "class": "section_acc-default",
    "blocks": [
        {
            "type": "b2b-sol-fact"
        },
        {
            "type": "b2b-sol-capability"
        },
        {
            "type": "b2b-sol-referenz"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_subline",
            "type": "text",
            "label": "Subline",
            "default": "B2B Solutions"
        },
        {
            "id": "text_heading_1",
            "type": "text",
            "label": "Heading 1",
            "default": "Solution name"
        },
        {
            "id": "textarea_subheading_1",
            "type": "textarea",
            "label": "Subheading 1",
            "default": "Describe this B2B solution: the service, the value for the reseller, and what makes it work \u2014 supported by facts, references and concrete offerings."
        },
        {
            "id": "url_hero_button_link",
            "type": "url",
            "label": "Hero Button Link"
        },
        {
            "id": "text_hero_button_text",
            "type": "text",
            "label": "Hero Button Text",
            "default": "Become a reseller"
        },
        {
            "id": "image_feature_bild",
            "type": "image_picker",
            "label": "Feature Bild"
        },
        {
            "id": "text_feature_subline",
            "type": "text",
            "label": "Feature Subline",
            "default": "Why DICOTA"
        },
        {
            "id": "text_feature_heading",
            "type": "text",
            "label": "Feature Heading",
            "default": "Your everyday IT accessory partner"
        },
        {
            "id": "textarea_feature_text",
            "type": "textarea",
            "label": "Feature Text",
            "default": "Ideal partner for daily IT accessory business: 1,000+ products, fast availability from a European warehouse, 2\u20133 day delivery, no MOQ, strong reseller margins, high product quality, online ordering and dedicated customer support."
        },
        {
            "id": "text_facts_heading",
            "type": "text",
            "label": "Facts Heading",
            "default": "Key facts"
        },
        {
            "id": "text_referenzen_heading",
            "type": "text",
            "label": "Referenzen Heading",
            "default": "Trusted by"
        },
        {
            "id": "image_cta_bild",
            "type": "image_picker",
            "label": "CTA Bild"
        },
        {
            "id": "text_cta_heading",
            "type": "text",
            "label": "CTA Heading",
            "default": "Ready to get started?"
        },
        {
            "id": "textarea_cta_text",
            "type": "textarea",
            "label": "CTA Text",
            "default": "Order online with fast availability and no minimum order quantity \u2014 backed by dedicated customer support."
        },
        {
            "id": "url_cta_button_link",
            "type": "url",
            "label": "CTA Button Link"
        },
        {
            "id": "text_cta_button_text",
            "type": "text",
            "label": "CTA Button Text",
            "default": "Start ordering"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 4
        }
    ],
    "presets": [
        {
            "name": "B2B Solution",
            "category": "_B2B",
            "blocks": [
                {
                    "type": "b2b-sol-fact"
                },
                {
                    "type": "b2b-sol-capability"
                },
                {
                    "type": "b2b-sol-referenzen",
                    "static": true,
                    "id": "b2b-sol-referenzen",
                    "blocks": [
                        {
                            "type": "b2b-sol-referenz"
                        }
                    ]
                }
            ]
        }
    ]
} {% endschema %}