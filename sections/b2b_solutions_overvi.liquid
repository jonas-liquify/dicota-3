<div class="padding-global padding-section-small" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"><div class="container-large"><div class="acc-default_wrapper"><div class="acc-default_flex-small"><ul role="list" class="breadcrumbs_component w-list-unstyled"><li class="breadcrumbs_item"><a li-object:href="routes.root_url" href="{{ routes.root_url }}" class="w-inline-block"><div li-object="'general.home' | t" class="text-size-regular">{{ 'general.home' | t }}</div></a><div class="breadcrumbs_icon w-embed"><svg width="15" height="15" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" fill="none"></path></svg></div></li><li class="breadcrumbs_item"><div>
{{ section.settings.text_breadcrumb }}
</div></li></ul><div class="default-flex-tiny"><div class="text-style-subline">
{{ section.settings.text_subline }}
</div><h1 class="heading-style-h2">
{{ section.settings.text_heading_1 }}
</h1><div class="text-size-medium max-width-large"> {{ section.settings.textarea_subheading_1 }} </div></div></div><div class="acc-default_flex-small"><div class="default-flex-tiny"><h2 class="heading-style-h4">
{{ section.settings.text_heading_2 }}
</h2></div><div li-cf-theme-blocks="" class="acc-triple">
{% content_for 'blocks' %}
</div></div><div class="acc-banner text-color-white">{% if section.settings.image_banner_bild %}
{{ section.settings.image_banner_bild | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'acc-banner_image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="acc-banner_image">
{% endif %}<div class="acc-banner_content"><div class="text-style-subline">
{{ section.settings.text_banner_subline }}
</div><h3 class="heading-style-h2">
{{ section.settings.text_banner_heading }}
</h3><div class="text-size-medium"> {{ section.settings.textarea_banner_text }} </div><div class="button-group margin-top margin-small"><a href="{{ section.settings.url_banner_button_link }}" class="button is-white w-button"> <span>{{ section.settings.text_banner_button_text }}</span> </a></div></div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Solutions Overvi",
    "class": "section_acc-default",
    "blocks": [
        {
            "type": "b2b-solution-card"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_breadcrumb",
            "type": "text",
            "label": "Breadcrumb",
            "default": "Solutions"
        },
        {
            "id": "text_subline",
            "type": "text",
            "label": "Subline",
            "default": "B2B Solutions"
        },
        {
            "id": "text_heading_1",
            "type": "text",
            "label": "Heading 1",
            "default": "Solutions for every business need"
        },
        {
            "id": "textarea_subheading_1",
            "type": "textarea",
            "label": "Subheading 1",
            "default": "DICOTA's services, expertise, and portfolio through clear B2B-focused storytelling \u2014 supported by facts, references, and concrete product offerings."
        },
        {
            "id": "text_heading_2",
            "type": "text",
            "label": "Heading 2",
            "default": "Explore our solution areas"
        },
        {
            "id": "image_banner_bild",
            "type": "image_picker",
            "label": "Banner Bild"
        },
        {
            "id": "text_banner_subline",
            "type": "text",
            "label": "Banner Subline",
            "default": "Tailored"
        },
        {
            "id": "text_banner_heading",
            "type": "text",
            "label": "Banner Heading",
            "default": "Need something specific?"
        },
        {
            "id": "textarea_banner_text",
            "type": "textarea",
            "label": "Banner Text",
            "default": "From branded products and individual configurations to fully tailor-made concepts for specific customer and corporate requirements."
        },
        {
            "id": "url_banner_button_link",
            "type": "url",
            "label": "Banner Button Link"
        },
        {
            "id": "text_banner_button_text",
            "type": "text",
            "label": "Banner Button Text",
            "default": "Talk to us"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 60
        }
    ],
    "presets": [
        {
            "name": "B2B Solutions Overvi",
