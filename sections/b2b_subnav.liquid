<div class="subnav_component"><div class="container-large"><nav class="subnav_menu"><div class="subnav_wrapper" li-for:inside="link in linklists[section.settings.account_menu].links">
        {% for link in linklists[section.settings.account_menu].links %}                            <div x-data="{open:false}" class="subnav_dropdown"><div x-on:click="open=!open" x-on:click.outside="open=false" class="subnav_dropdown-toggle"><div li-object="link.title" class="text-weight-medium">{{ link.title }}</div>{% if link.links.size > 0 %}    <div li-if="link.links.size > 0" class="dropdown-icon w-embed">
    {% render 'icon_chevron_down' %}    </div>
{% endif %}</div>{% if link.links.size > 0 %}    <nav x-show="open" x-cloak="" li-if="link.links.size > 0" class="nav_secondary-content is-subnav">
    <div class="container-large"><div class="subnav_dropdown-list">{% for child_link in link.links %}    <div li-for="child_link in link.links" class="subnav_dropdown-item">
                                    <a li-object:href="child_link.url" href="{{ child_link.url }}" class="subnav_dropdown-link w-inline-block"><div li-object="child_link.title" class="text-size-regular text-weight-medium">{{ child_link.title }}</div><div li-if="section.settings.text_dummy_description != blank" class="text-size-small">
{{ section.settings.text_dummy_description }}
</div></a>
                        </div>
{% endfor %}</div></div>    </nav>
{% endif %}</div>
                            <div class="subnav_points"><div li-if="section.settings.text_punkte_label != blank" class="text-size-small">
{{ section.settings.text_punkte_label }}
</div><div class="text-size-small text-color-blue text-weight-medium"><span li-object="customer.metafields.custom.points | default: '0'">{{ customer.metafields.custom.points | default: '0' }}</span>P</div></div>
                    {% endfor %}    </div></nav></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Subnav",
    "class": "section_acc-subnav",
    "settings": [
        {
            "id": "text_dummy_description",
            "type": "text",
            "label": "Dummy Description",
            "default": "Short description"
        },
        {
            "id": "text_punkte_label",
            "type": "text",
            "label": "Punkte Label",
            "default": "Current point balance:"
        },
        {
            "type": "header",
            "content": "Men\u00fc"
        },
        {
            "type": "link_list",
            "id": "account_menu",
            "label": "Account-Men\u00fc Linkliste"
        }
    ],
    "presets": [
        {
            "name": "B2B Subnav",
            "category": "_B2B",
            "blocks": []
        }
    ]
} {% endschema %}