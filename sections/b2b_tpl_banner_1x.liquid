<div class="padding-global padding-section-small" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem"><div class="container-large"><div class="acc-default_wrapper"><div class="acc-banner text-color-white">{% if section.settings.image_banner_bild %}
{{ section.settings.image_banner_bild | image_url: width: 1200 | image_tag: li-if: 'section.settings.image_banner_bild != blank', loading: 'lazy', class: 'acc-banner_image' }}
{% else %}
<img li-if="section.settings.image_banner_bild != blank" src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="acc-banner_image">
{% endif %}<div class="acc-banner_content"><div class="acc-banner_heading"><div class="acc-banner_tag-row">{% if section.settings.text_tag != blank %}    <div li-if="section.settings.text_tag != blank" class="acc-banner_tag">
    <div class="text-style-subline">
{{ section.settings.text_tag }}
</div>    </div>
{% endif %}</div><h3 class="heading-style-h2">
{{ section.settings.text_heading }}
</h3></div><div class="text-size-medium"> {{ section.settings.textarea_text }} </div><div class="acc-banner_button-wrapper"><a li-if="section.settings.text_button_text != blank" href="{{ section.settings.url_button_link }}" class="button is-white w-button"> <span>{{ section.settings.text_button_text }}</span> </a></div></div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Tpl Banner 1x",
    "class": "section_acc-default",
    "settings": [
        {
            "id": "image_banner_bild",
            "type": "image_picker",
            "label": "Banner Bild"
        },
        {
            "id": "text_tag",
            "type": "text",
            "label": "Tag",
            "default": "Promotion"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Banner title"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "A short descriptive text for this banner."
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Discover now"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 4
        }
    ],
    "presets": [
        {
            "name": "B2B Tpl Banner 1x",
            "category": "_B2B",
            "blocks": []
        }
    ]
} {% endschema %}