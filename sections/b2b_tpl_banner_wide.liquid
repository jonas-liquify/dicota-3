<div class="padding-global padding-section-small"><div class="container-large"><div class="acc-default_wrapper"><div class="acc_banner-item is-large">{% if section.settings.image_bild %}
{{ section.settings.image_bild | image_url: width: 600 | image_tag: loading: 'lazy', class: 'acc_banner-image is-large' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="acc_banner-image is-large">
{% endif %}<div class="acc_banner-content is-large"><div class="acc_tag-list"><div class="text-style-subline">Category</div><div class="text-style-subline">·</div><div class="text-style-subline">Tag</div></div><h3 class="heading-style-h2">
{{ section.settings.text_heading }}
</h3><div class="text-size-medium"> {{ section.settings.textarea_text }} </div><a href="{{ section.settings.url_button_link }}" class="button w-button"> <span>{{ section.settings.text_button_text }}</span> </a></div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Tpl Banner Wide",
    "class": "section_acc-default",
    "settings": [
        {
            "id": "image_bild",
            "type": "image_picker",
            "label": "Bild"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Long banner title"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "More room for a detailed description of this banner."
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Learn more"
        }
    ],
    "presets": [
        {
            "name": "B2B Tpl Banner Wide",
            "category": "_B2B",
            "blocks": []
        }
    ]
} {% endschema %}