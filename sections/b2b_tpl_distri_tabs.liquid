<div class="padding-global padding-section-medium" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem"><div class="container-large"><div class="default-small-component"><div class="default-flex-tiny"><h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2><div li-if="section.settings.textarea_text != blank" class="text-size-medium"> {{ section.settings.textarea_text }} </div></div><div x-data="{tab: 1}" role="tablist" class="acc-dis_tab-component"><div li-cf-theme-blocks="" class="acc-dis_tab-menu">
{% content_for 'blocks' %}
</div></div>{% content_for "block", type: "b2b-tpl-panes", id: "b2b-tpl-panes" %}</div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Tpl Distri Tabs",
    "class": "section_acc-dis",
    "blocks": [
        {
            "type": "b2b-tpl-tab"
        },
        {
            "type": "b2b-tpl-tab-pane"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Distributors"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "Our authorized distribution partners worldwide."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 4
        }
    ],
    "presets": [
        {
            "name": "B2B Tpl Distri Tabs",
            "category": "_B2B",
            "blocks": [
                {
                    "type": "b2b-tpl-tab"
                },
                {
                    "type": "b2b-tpl-panes",
                    "static": true,
                    "id": "b2b-tpl-panes",
                    "blocks": [
                        {
                            "type": "b2b-tpl-tab-pane"
                        }
                    ]
                }
            ]
        }
    ]
} {% endschema %}