<div class="padding-global padding-section-small" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem"><div class="container-large"><div class="acc-default_wrapper"><div class="acc-default_flex-small"><h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2><div class="text-size-medium max-width-large"> {{ section.settings.textarea_text }} </div><div class="acc_cta background-color-red"><div class="acc_cta-content">{% if section.settings.image_cta_icon %}
{{ section.settings.image_cta_icon | image_url: width: 80 | image_tag: li-if: 'section.settings.image_cta_icon != blank', loading: 'lazy', class: 'acc_cta-icon' }}
{% else %}
<img li-if="section.settings.image_cta_icon != blank" src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="acc_cta-icon">
{% endif %}<div class="acc_cta-text"><div class="heading-style-h4">
{{ section.settings.text_cta_heading }}
</div><div li-if="section.settings.textarea_cta_text != blank" class="text-size-medium"> {{ section.settings.textarea_cta_text }} </div></div></div><a li-if="section.settings.text_cta_button_text != blank" href="{{ section.settings.url_cta_button_link }}" class="button is-white w-button"> <span>{{ section.settings.text_cta_button_text }}</span> </a></div><div li-cf-theme-blocks="" class="acc-triple">
{% content_for 'blocks' %}
</div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Tpl News Highl",
    "class": "section_acc-default",
    "blocks": [
        {
            "type": "b2b-tpl-news-karte"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "What's new at DICOTA"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "The latest announcements, releases and offers \u2014 all at a glance."
        },
        {
            "id": "image_cta_icon",
            "type": "image_picker",
            "label": "CTA Icon"
        },
        {
            "id": "text_cta_heading",
            "type": "text",
            "label": "CTA Heading",
            "default": "Important information"
        },
        {
            "id": "textarea_cta_text",
            "type": "textarea",
            "label": "CTA Text",
            "default": "Note our new delivery terms starting next week."
        },
        {
            "id": "url_cta_button_link",
            "type": "url",
            "label": "CTA Button Link"
        },
        {
            "id": "text_cta_button_text",
            "type": "text",
            "label": "CTA Button Text",
            "default": "Details"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 4
        }
    ],
    "presets": [
        {
            "name": "B2B Tpl News Highl",
            "category": "_B2B",
            "blocks": [
                {
                    "type": "b2b-tpl-news-karte"
                }
            ]
        }
    ]
} {% endschema %}