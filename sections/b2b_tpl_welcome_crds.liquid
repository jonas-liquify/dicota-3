<div class="padding-global padding-section-medium"><div class="container-large"><div class="default-small-component"><h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2><div class="acc-welcome_wrapper"><div class="acc-welcome_top"><div li-cf-theme-blocks="">
{% content_for 'blocks' %}
</div></div><div class="acc-banner text-color-white"><div class="acc-banner_content"><h3 class="heading-style-h2">
{{ section.settings.text_banner_heading }}
</h3><div class="text-size-medium"> {{ section.settings.textarea_banner_text }} </div><div class="button-group margin-top margin-small"><a href="{{ section.settings.url_banner_button_link }}" class="button is-white w-button"> <span>{{ section.settings.text_banner_button_text }}</span> </a></div></div>{% if section.settings.image_banner_bild %}
{{ section.settings.image_banner_bild | image_url: width: 800 | image_tag: loading: 'lazy', class: 'acc-banner_image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="acc-banner_image">
{% endif %}</div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Tpl Welcome Crds",
    "class": "section_acc-welcome",
    "blocks": [
        {
            "type": "karte"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Sch\u00f6n, dass du da bist"
        },
        {
            "id": "text_banner_heading",
            "type": "text",
            "label": "Banner Heading",
            "default": "Dein n\u00e4chster Meilenstein"
        },
        {
            "id": "textarea_banner_text",
            "type": "textarea",
            "label": "Banner Text",
            "default": "Sammle weitere Punkte und schalte neue Pr\u00e4mien frei."
        },
        {
            "id": "url_banner_button_link",
            "type": "url",
            "label": "Banner Button Link"
        },
        {
            "id": "text_banner_button_text",
            "type": "text",
            "label": "Banner Button Text",
            "default": "Punkte ansehen"
        },
        {
            "id": "image_banner_bild",
            "type": "image_picker",
            "label": "Banner Bild"
        }
    ],
    "presets": [
        {
            "name": "B2B Tpl Welcome Crds",
            "category": "_B2B",
            "blocks": [
                {
                    "type": "karte"
                }
            ]
        }
    ]
} {% endschema %}