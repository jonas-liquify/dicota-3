<div class="padding-global padding-section-medium" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem"><div class="container-large"><div class="default-small-component"><h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2><div class="acc-welcome_wrapper"><div class="acc-welcome_top"><div li-cf-theme-blocks="">
{% content_for 'blocks' %}
</div></div><div class="acc-banner text-color-white"><div class="acc-banner_content"><h3 class="heading-style-h2">
{{ section.settings.text_banner_heading }}
</h3><div class="text-size-medium"> {{ section.settings.textarea_banner_text }} </div>{% if section.settings.text_banner_button_text != blank %}    <div li-if="section.settings.text_banner_button_text != blank" class="button-group margin-top margin-small">
    <a href="{{ section.settings.url_banner_button_link }}" class="button is-white w-button"> <span>{{ section.settings.text_banner_button_text }}</span> </a>    </div>
{% endif %}</div>{% if section.settings.image_banner_bild %}
{{ section.settings.image_banner_bild | image_url: width: 800 | image_tag: li-if: 'section.settings.image_banner_bild != blank', loading: 'lazy', class: 'acc-banner_image' }}
{% else %}
<img li-if="section.settings.image_banner_bild != blank" src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="acc-banner_image">
{% endif %}</div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Tpl Welcome Crds",
    "class": "section_acc-welcome",
    "blocks": [
        {
            "type": "b2b-welcome-karte"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Great to have you here"
        },
        {
            "id": "text_banner_heading",
            "type": "text",
            "label": "Banner Heading",
            "default": "Your next milestone"
        },
        {
            "id": "textarea_banner_text",
            "type": "textarea",
            "label": "Banner Text",
            "default": "Collect more points and unlock new rewards."
        },
        {
            "id": "url_banner_button_link",
            "type": "url",
            "label": "Banner Button Link"
        },
        {
            "id": "text_banner_button_text",
            "type": "text",
            "label": "Banner Button Text",
            "default": "View points"
        },
        {
            "id": "image_banner_bild",
            "type": "image_picker",
            "label": "Banner Bild"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 4
        }
    ],
    "presets": [
        {
            "name": "B2B Tpl Welcome Crds",
            "category": "_B2B",
            "blocks": [
                {
                    "type": "b2b-welcome-karte"
                }
            ]
        }
    ]
} {% endschema %}