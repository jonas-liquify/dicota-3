<div class="padding-global padding-section-small" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem"><div class="container-large"><div class="acc-default_wrapper"><div class="acc-default_flex-small"><div class="default-flex-tiny"><h1 class="heading-style-h2">
{{ section.settings.text_heading }}
</h1>{% if section.settings.textarea_subheading != blank %}    <div class="li-guard" li-if="section.settings.textarea_subheading != blank">
    <div class="text-size-medium max-width-large"> {{ section.settings.textarea_subheading }} </div>    </div>
{% endif %}</div><div class="acc-card"><h2 class="why-dicota_card-heading">
{{ section.settings.text_checklist_heading }}
</h2><div li-cf-theme-blocks="" class="why-dicota_list">
{% content_for 'blocks' %}
</div></div>{% content_for "block", type: "glossary-card", id: "glossary-card" %}</div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Why Dicota",
    "class": "section_acc-default",
    "blocks": [
        {
            "type": "why-dicota-item"
        },
        {
            "type": "glossary-term"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Key selling arguments"
        },
        {
            "id": "textarea_subheading",
            "type": "textarea",
            "label": "Subheading",
            "default": "Wenn man unterwegs ist, gibt es viele Situationen, in denen man sein Notebook nicht direkt am K\u00f6rper tragen kann. Sei es beim Toilettengang in der Bahn oder beim kurzen Kaffeep\u00e4uschen in der Gemeinschaftsk\u00fcche eines Coworking-Spaces. Selbst in nur wenigen Minuten k\u00f6nnten Langfinger zuschlagen."
        },
        {
            "id": "text_checklist_heading",
            "type": "text",
            "label": "Checklist Heading",
            "default": "Why DICOTA"
        },
        {
            "id": "text_glossary_heading",
            "type": "text",
            "label": "Glossary Heading",
            "default": "Key selling arguments"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 4
        }
    ],
    "presets": [
        {
            "name": "B2B Why Dicota",
            "category": "_B2B",
            "blocks": [
                {
                    "type": "why-dicota-item"
                },
                {
                    "type": "glossary-card",
                    "static": true,
                    "id": "glossary-card",
                    "blocks": [
                        {
                            "type": "glossary-term"
                        }
                    ]
                }
            ]
        }
    ]
} {% endschema %}