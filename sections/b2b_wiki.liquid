<div class="padding-global padding-section-medium" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"><div class="container-large"><div class="faq_wrapper"><div class="default-flex-small"><div class="text-style-subline">
{{ section.settings.text_subline }}
</div><h1 class="heading-style-h2">
{{ section.settings.text_heading }}
</h1><div class="text-size-medium"> {{ section.settings.textarea_text }} </div></div><div li-cf-theme-blocks="" class="faq_component">
{% content_for 'blocks' %}
</div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "B2B Wiki",
    "class": "section_faq",
    "blocks": [
        {
            "type": "wiki-eintrag"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_subline",
            "type": "text",
            "label": "Subline",
            "default": "DICOTA Wiki"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Knowledge base"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "Answers to the most common product, process and partner questions \u2014 curated by the DICOTA team."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        }
    ],
    "presets": [
        {
            "name": "B2B Wiki",
            "category": "_B2B",
            "blocks": [
                {
                    "type": "wiki-eintrag"
                }
            ]
        }
    ]
} {% endschema %}