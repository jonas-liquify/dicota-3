<div class="padding-global padding-section-medium" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"><div class="container-large"><div class="default-medium-component"><div class="default-flex-tiny">{% if section.settings.text_subline != blank %}    <div class="li-guard" li-if="section.settings.text_subline != blank">
    <div class="text-style-subline">
{{ section.settings.text_subline }}
</div>    </div>
{% endif %}<h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2></div><div li-cf-theme-blocks="" class="benefits_grid">
{% content_for 'blocks' %}
</div><div class="button-group is-center">{% if section.settings.text_button_text != blank %}    <span class="li-guard" li-if="section.settings.text_button_text != blank">
    <a href="{{ section.settings.url_button_link }}" class="button is-white w-button"> <span>{{ section.settings.text_button_text }}</span> </a>    </span>
{% endif %}</div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Benefits Grid",
    "class": "section_benefits background-color-primary",
    "blocks": [
        {
            "type": "benefit"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_subline",
            "type": "text",
            "label": "Subline",
            "default": "What we offer"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Your benefits"
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "View all benefits"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 5
        }
    ],
    "presets": [
        {
            "name": "Benefits Grid",
            "category": "Listing",
            "blocks": [
                {
                    "type": "benefit"
                }
            ]
        }
    ]
} {% endschema %}