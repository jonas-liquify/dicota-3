<div class="padding-global padding-section-medium"><div class="container-large"><div class="default-medium-component"><div class="default-flex-tiny"><div class="text-style-subline">
{{ section.settings.text_subline }}
</div><h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2></div><div li-cf-theme-blocks="" class="benefits_grid">
{% content_for 'blocks' %}
</div><div class="button-group is-center"><a href="{{ section.settings.url_button_link }}" class="button is-white w-button"> <span>{{ section.settings.text_button_text }}</span> </a></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Benefits Grid",
    "class": "section_benefits background-color-primary",
    "blocks": [
        {
            "type": "benefit"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_subline",
            "type": "text",
            "label": "Subline",
            "default": "Was wir bieten"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Deine Benefits"
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Alle Benefits ansehen"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        }
    ],
    "presets": [
        {
            "name": "Benefits Grid",
            "category": "Listing",
            "blocks": [
                {
                    "type": "benefit"
                }
            ]
        }
    ]
} {% endschema %}