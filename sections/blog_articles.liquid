{% paginate blog.articles by 9 %}
    <div li-paginate:by="9" li-paginate="blog.articles" class="padding-global blog-list_padding" by="9"><div class="container-large"><div class="blog-list_bar"><div class="blog-list_filters">{% if section.settings.text_filter_1 != blank %}    <span class="li-guard" li-if="section.settings.text_filter_1 != blank">
    <a href="{{ section.settings.url_filter_1_link }}" class="blog-list_filter w-inline-block"> <span>{{ section.settings.text_filter_1 }}</span><span class="blog-list_filter-chev w-embed"><svg width="100%" height="100%" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" fill="none"></path></svg></span> </a>    </span>
{% endif %}{% if section.settings.text_filter_2 != blank %}    <span class="li-guard" li-if="section.settings.text_filter_2 != blank">
    <a href="{{ section.settings.url_filter_2_link }}" class="blog-list_filter w-inline-block"> <span>{{ section.settings.text_filter_2 }}</span><span class="blog-list_filter-chev w-embed"><svg width="100%" height="100%" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" fill="none"></path></svg></span> </a>    </span>
{% endif %}{% if section.settings.text_filter_3 != blank %}    <span class="li-guard" li-if="section.settings.text_filter_3 != blank">
    <a href="{{ section.settings.url_filter_3_link }}" class="blog-list_filter w-inline-block"> <span>{{ section.settings.text_filter_3 }}</span><span class="blog-list_filter-chev w-embed"><svg width="100%" height="100%" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" fill="none"></path></svg></span> </a>    </span>
{% endif %}</div><div class="blog-list_sort"><span li-object="'general.sort_by' | t" class="blog-list_sort-label">{{ 'general.sort_by' | t }}</span><span class="blog-list_sort-value"><span>
{{ section.settings.text_sortierung }}
</span><span class="blog-list_filter-chev w-embed"><svg width="100%" height="100%" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" fill="none"></path></svg></span></span></div></div>{% if blog.articles != blank %}    <div li-if="blog.articles != blank" role="list" class="blog-grid w-dyn-items">
    {% for article in blog.articles %}    <a li-for="article in blog.articles" li-object:href="article.url" href="#" role="listitem" class="blog-card w-inline-block">
                                    <div class="blog-card_image-wrap"><img li-object:src="article.image | image_url: width: 700" li-object:alt="article.image.alt" src="{{ article.image | image_url: width: 700 }}" loading="lazy" alt="{{ article.image.alt }}" class="blog-card_image"></div>
                            <div class="blog-card_body"><div class="blog-card_head"><div class="blog-card_meta"><span li-object="article.tags.first">{{ article.tags.first }}</span><span class="blog-meta_dot">·</span><span li-object="article.published_at | date: '%-d. %B %Y'">{{ article.published_at | date: '%-d. %B %Y' }}</span></div><h3 li-object="article.title" class="blog-card_title">{{ article.title }}</h3></div><p li-object="article.excerpt" class="blog-card_excerpt">{{ article.excerpt }}</p><span class="blog-card_link">Learn more</span></div>
                        </a>
{% endfor %}    </div>
{% endif %}{% if blog.articles == blank %}    <div li-if="blog.articles == blank" class="blog-grid-empty w-dyn-empty">
    <div li-object="'blog.no_posts' | t">{{ 'blog.no_posts' | t }}</div>    </div>
{% endif %}{% if paginate.pages > 1 %}    <nav li-if="paginate.pages > 1" class="pagination_component">
    <ul role="list" class="pagination_list w-list-unstyled">{% if paginate.previous %}    <li li-if="paginate.previous" class="pagination_item">
    <a li-object:href="paginate.previous.url" href="{{ paginate.previous.url }}" class="button is-secondary is-icon w-inline-block"><div class="pagination_arrow w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 13 8" fill="none" preserveaspectratio="xMidYMid meet" aria-hidden="true" role="img"><path d="M1.67318 0.589844L6.26318 5.16984L10.8532 0.589844L12.2632 1.99984L6.26318 7.99984L0.263184 1.99984L1.67318 0.589844Z" fill="currentColor"></path></svg></div><div li-object="'general.back' | t">{{ 'general.back' | t }}</div></a>    </li>
{% endif %}{% if paginate.previous == false %}    <li li-if="paginate.previous == false" class="pagination_item">
    <a li-object:href="paginate.previous.url" href="{{ paginate.previous.url }}" class="button is-secondary is-icon text-style-muted pointer-events-off w-inline-block"><div class="pagination_arrow w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 13 8" fill="none" preserveaspectratio="xMidYMid meet" aria-hidden="true" role="img"><path d="M1.67318 0.589844L6.26318 5.16984L10.8532 0.589844L12.2632 1.99984L6.26318 7.99984L0.263184 1.99984L1.67318 0.589844Z" fill="currentColor"></path></svg></div><div li-object="'general.back' | t">{{ 'general.back' | t }}</div></a>    </li>
{% endif %}{% for part in paginate.parts %}    <li li-for="part in paginate.parts" class="pagination_item">
                                    {% if part.is_link %}    <div li-if="part.is_link">
    <a li-object:href="part.url" href="{{ part.url }}" class="pagination_count w-inline-block"><div li-object="part.title" class="text-style-link">{{ part.title }}</div></a>    </div>
{% endif %}
                            {% if part.is_link == false %}    <div li-if="part.is_link == false">
    <div li-object="part.title" class="{% if part.title == paginate.current_page %}text-weight-semibold{% endif %}">{{ part.title }}</div>    </div>
{% endif %}
                        </li>
{% endfor %}{% if paginate.next == false %}    <li li-if="paginate.next == false" class="pagination_item">
    <a li-object:href="paginate.next.url" href="{{ paginate.next.url }}" class="button is-secondary is-icon text-style-muted pointer-events-off w-inline-block"><div li-object="'general.next' | t">{{ 'general.next' | t }}</div><div class="pagination_arrow is-right w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 13 8" fill="none" preserveaspectratio="xMidYMid meet" aria-hidden="true" role="img"><path d="M1.67318 0.589844L6.26318 5.16984L10.8532 0.589844L12.2632 1.99984L6.26318 7.99984L0.263184 1.99984L1.67318 0.589844Z" fill="currentColor"></path></svg></div></a>    </li>
{% endif %}{% if paginate.next %}    <li li-if="paginate.next" class="pagination_item">
    <a li-object:href="paginate.next.url" href="{{ paginate.next.url }}" class="button is-secondary is-icon w-inline-block"><div li-object="'general.next' | t">{{ 'general.next' | t }}</div><div class="pagination_arrow is-right w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 13 8" fill="none" preserveaspectratio="xMidYMid meet" aria-hidden="true" role="img"><path d="M1.67318 0.589844L6.26318 5.16984L10.8532 0.589844L12.2632 1.99984L6.26318 7.99984L0.263184 1.99984L1.67318 0.589844Z" fill="currentColor"></path></svg></div></a>    </li>
{% endif %}</ul>    </nav>
{% endif %}</div></div>{% endpaginate %} {% schema %} {
    "tag": "section",
    "name": "Blog Articles",
    "class": "section_blog-list",
    "settings": [
        {
            "id": "url_filter_1_link",
            "type": "url",
            "label": "Filter 1 Link"
        },
        {
            "id": "text_filter_1",
            "type": "text",
            "label": "Filter 1",
            "default": "Filter"
        },
        {
            "id": "url_filter_2_link",
            "type": "url",
            "label": "Filter 2 Link"
        },
        {
            "id": "text_filter_2",
            "type": "text",
            "label": "Filter 2",
            "default": "Filter"
        },
        {
            "id": "url_filter_3_link",
            "type": "url",
            "label": "Filter 3 Link"
        },
        {
            "id": "text_filter_3",
            "type": "text",
            "label": "Filter 3",
            "default": "Filter"
        },
        {
            "id": "text_sortierung",
            "type": "text",
            "label": "Sortierung",
            "default": "Newest first"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        }
    ],
    "presets": [
        {
            "name": "Blog Articles",
            "category": "Liquify",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "blog"
        ]
    }
} {% endschema %}