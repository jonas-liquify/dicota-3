{% if section.settings.image_image_full != blank %}    <span class="li-guard" li-if="section.settings.image_image_full != blank">
    {% if section.settings.image_image_full %}
{{ section.settings.image_image_full | image_url: width: 2000 | image_tag: class: 'boxed-image_image', loading: 'lazy' }}
{% else %}
<img class="boxed-image_image" src="{{ 'platzhalter.svg' | asset_url }}" alt="" loading="lazy">
{% endif %}    </span>
{% endif %} {% schema %} {
    "tag": "section",
    "name": "Boxed Image",
    "class": "section_boxed-image",
    "settings": [
        {
            "id": "image_image_full",
            "type": "image_picker",
            "label": "Image (Full)"
        }
    ],
    "presets": [
        {
            "name": "Boxed Image",
            "category": "Showcase",
            "blocks": []
        }
    ]
} {% endschema %}