<div class="padding-global"><div class="container-large">{% if section.settings.image_image %}
{{ section.settings.image_image | image_url: width: 1400 | image_tag: class: 'boxed-image_image-centerd', loading: 'lazy' }}
{% else %}
<img class="boxed-image_image-centerd" src="{{ 'platzhalter.svg' | asset_url }}" alt="" loading="lazy">
{% endif %}</div></div> {% schema %} {
    "tag": "section",
    "name": "Boxed Image Centered",
