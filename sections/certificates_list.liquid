<div class="padding-global padding-section-small" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"><div class="container-large"><div class="acc-default_wrapper"><div class="acc-default_flex-small"><div class="default-flex-tiny"><h1 class="heading-style-h2">
{{ section.settings.text_heading }}
</h1><div class="text-size-medium max-width-large"> {{ section.settings.richtext_text }} </div></div></div><div class="zertifikate_search"><div class="zertifikate_form w-form"><form name="zertifikate-search" data-name="Zertifikate Search" method="get" class="zertifikate_form-inner"><div class="filter_input-wrapper"><div class="filter_left-icon w-embed"><svg width="16" height="16" viewbox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M18.29 18.33L12.6 12.98C12.15 13.33 11.62 13.6 11.04 13.8C10.45 14 9.84 14.1 9.21 14.1C7.66 14.1 6.35 13.6 5.27 12.59C4.2 11.58 3.66 10.34 3.66 8.88C3.66 7.43 4.2 6.19 5.27 5.18C6.35 4.17 7.66 3.67 9.21 3.67C10.75 3.67 12.07 4.17 13.14 5.18C14.21 6.19 14.75 7.43 14.75 8.88C14.75 9.49 14.64 10.07 14.42 10.63C14.21 11.18 13.92 11.67 13.55 12.08L19.25 17.43L18.29 18.33Z" fill="currentColor"></path></svg></div><label li-object="'general.search' | t" for="zertifikate-search" class="form_hidden-label">{{ 'general.search' | t }}</label><input class="filter_input is-white-bg w-input" maxlength="256" name="search" placeholder="Search by SKU or product name…" type="text" id="zertifikate-search" autocomplete="off"></div></form></div></div>{% if section.settings.download_collection != blank %}    <div li-if="section.settings.download_collection != blank">
    {% paginate section.settings.download_collection.products by 1500 %}
    <div li-paginate="section.settings.download_collection.products" li-paginate:by="1500" by="1500"><div role="list" class="zertifikate_list w-dyn-items">{% for product in section.settings.download_collection.products %}    <div li-for="product in section.settings.download_collection.products" role="listitem" class="w-dyn-item">
                                    <div class="acc_download-item max-width-full background-color-alternate"><div class="acc_download-banner is-large is-zertifikat"><div class="acc_download-banner-left"><img li-object:src="product.featured_image | image_url: width: 200" li-object:alt="product.featured_image.alt" src="{{ product.featured_image | image_url: width: 200 }}" loading="lazy" alt="{{ product.featured_image.alt }}" class="zertifikate_img"><div><div li-object="product.title" class="text-size-large">{{ product.title }}</div><div class="text-size-regular">SKU: <span li-object="product.selected_or_first_available_variant.sku">{{ product.selected_or_first_available_variant.sku }}</span></div></div></div><a target="_blank" href="https://cdn.dicota.com/DICOTA/cdn/url.php?cdn=/s/files/1/0707/9208/5641/files/{{ product.selected_or_first_available_variant.sku }}_Letter_of_Conformity_CE_DICOTA_Schweiz_AG.pdf" class="acc_download-link w-inline-block"><div class="icon-1x1-large w-embed"><svg width="100%" height="100%" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" fill="currentColor"></path></svg></div></a></div></div>
                        </div>
{% endfor %}</div></div>{% endpaginate %}    </div>
{% endif %}{% if section.settings.download_collection == blank %}    <div li-if="section.settings.download_collection == blank">
    {% paginate collection.products by 1500 %}
    <div li-paginate="collection.products" li-paginate:by="1500" by="1500"><div role="list" class="zertifikate_list w-dyn-items">{% for product in collection.products %}    <div li-for="product in collection.products" role="listitem" class="w-dyn-item">
                                    <div class="acc_download-item max-width-full background-color-alternate"><div class="acc_download-banner is-large is-zertifikat"><div class="acc_download-banner-left"><img li-object:src="product.featured_image | image_url: width: 200" li-object:alt="product.featured_image.alt" src="{{ product.featured_image | image_url: width: 200 }}" loading="lazy" alt="{{ product.featured_image.alt }}" class="zertifikate_img"><div><div li-object="product.title" class="text-size-large">{{ product.title }}</div><div class="text-size-regular">SKU: <span li-object="product.selected_or_first_available_variant.sku">{{ product.selected_or_first_available_variant.sku }}</span></div></div></div><a target="_blank" href="https://cdn.dicota.com/DICOTA/cdn/url.php?cdn=/s/files/1/0707/9208/5641/files/{{ product.selected_or_first_available_variant.sku }}_Letter_of_Conformity_CE_DICOTA_Schweiz_AG.pdf" class="acc_download-link w-inline-block"><div class="icon-1x1-large w-embed"><svg width="100%" height="100%" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" fill="currentColor"></path></svg></div></a></div></div>
                        </div>
{% endfor %}</div></div>{% endpaginate %}    </div>
{% endif %}</div></div></div><div class="hide w-embed w-script"><script>document.addEventListener("DOMContentLoaded", function() { var input = document.getElementById("zertifikate-search"); if (!input) return; var items = document.querySelectorAll(".zertifikate_list .w-dyn-item"); input.addEventListener("input", function() { var q = this.value.trim().toLowerCase(); items.forEach(function(it) { var txt = it.textContent.toLowerCase(); it.style.display = q === "" || txt.indexOf(q) !== -1 ? "" : "none"; }); }); });</script></div> {% schema %} {
    "tag": "section",
    "name": "Certificates List",
    "class": "section_acc-default",
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Certificates"
        },
        {
            "id": "richtext_text",
            "type": "richtext",
            "label": "Text",
            "default": "<p>All DICOTA products with a Letter of Conformity (CE) \u2014 filtered by SKU or product title.<\/p>"
        },
        {
            "type": "header",
            "content": "Collection"
        },
        {
            "type": "collection",
            "id": "download_collection",
            "label": "Collection (Produkte-Quelle)",
            "info": "W\u00e4hle die Collection, deren Produkte hier zum Download gelistet werden. Leer lassen \u2192 auf Collection-Seiten wird die aktuelle Collection genutzt."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 2.5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 5
        }
    ],
    "presets": [
        {
            "name": "Certificates List",
            "category": "Listing",
            "blocks": []
        }
    ]
} {% endschema %}