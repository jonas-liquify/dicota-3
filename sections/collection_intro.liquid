<div class="padding-global" style="padding-top:{{ section.settings.padding_top }}rem;padding-bottom:{{ section.settings.padding_bottom }}rem;background-color:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};"><div class="container-large"><div class="collection-intro_layout"><div class="collection-intro_text-col"><h1 li-object="section.settings.text_headline | default: collection.metafields.custom.collection_name | default: collection.title" class="collection-intro_title">{{ section.settings.text_headline | default: collection.metafields.custom.collection_name | default: collection.title }}</h1>{% if section.settings.textarea_beschreibung != blank or collection.description != blank %}    <div class="li-guard" li-if="section.settings.textarea_beschreibung != blank or collection.description != blank">
    <div li-object="section.settings.textarea_beschreibung | default: collection.description" class="collection-intro_desc text-size-regular">{{ section.settings.textarea_beschreibung | default: collection.description }}</div>    </div>
{% endif %}</div><div class="collection-intro_slider-wrapper"><div class="collection-intro_swiper swiper is-collection-intro"><div li-cf-theme-blocks="" class="collection-intro_tiles swiper-wrapper is-collection-intro">
{% content_for 'blocks' %}
</div></div><button type="button" class="collection-intro_arrow is-prev swiper-button-prev" aria-label="Previous"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_left' %}</div></button><button type="button" class="collection-intro_arrow swiper-button-next" aria-label="Next"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_right' %}</div></button></div></div></div></div><div class="hide w-embed w-script"><script>(function(){function ensure(cb){if(typeof Swiper!=="undefined")return cb();if(window.__swiperLoading)return window.__swiperLoading.then(cb);var s=document.createElement("script");s.src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js";var link=document.createElement("link");link.rel="stylesheet";link.href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css";document.head.appendChild(link);window.__swiperLoading=new Promise(function(res){s.onload=res;});document.head.appendChild(s);window.__swiperLoading.then(cb);}function isDesktop(){return window.matchMedia("(min-width: 768px)").matches;}var instances=new WeakMap();function initAll(){document.querySelectorAll(".collection-intro_swiper.swiper").forEach(function(el){var root=el.closest(".collection-intro_slider-wrapper")||document;if(isDesktop()){if(instances.has(el))return;ensure(function(){if(!isDesktop()||instances.has(el))return;var inst=new Swiper(el,{slidesPerView:"auto",spaceBetween:20,watchOverflow:true,navigation:{nextEl:root.querySelector(".collection-intro_arrow.swiper-button-next"),prevEl:root.querySelector(".collection-intro_arrow.is-prev"),disabledClass:"swiper-button-disabled",lockClass:"swiper-button-lock"}});instances.set(el,inst);});}else{if(instances.has(el)){try{instances.get(el).destroy(true,true);}catch(e){}instances.delete(el);}}});}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",initAll);}else{initAll();}var rt;window.addEventListener("resize",function(){clearTimeout(rt);rt=setTimeout(initAll,150);});})();</script></div> {% schema %} {
    "tag": "section",
    "name": "Collection Intro",
    "class": "section_collection-intro",
    "blocks": [
        {
            "type": "kategorie-bild"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "type": "header",
            "content": "Inhalt"
        },
        {
            "type": "text",
            "id": "text_headline",
            "label": "Headline",
            "info": "Leer lassen = Metafeld \u201eCollection Name\u201c, sonst der Kollektions-Titel."
        },
        {
            "type": "textarea",
            "id": "textarea_beschreibung",
            "label": "Beschreibung",
            "info": "Leer lassen = Beschreibungstext der Kollektion."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 2.5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 2.5
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#0f0f0f"
        }
    ],
    "presets": [
        {
            "name": "Collection Intro",
            "category": "Showcase",
            "blocks": [
                {
                    "type": "kategorie-bild"
                }
            ]
        }
    ],
    "enabled_on": {
        "templates": [
            "collection"
        ]
    }
} {% endschema %}