<div class="padding-global" style="padding-top:{{ section.settings.padding_top }}rem;padding-bottom:{{ section.settings.padding_bottom }}rem;background-color:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};"><div class="container-large"><div class="collection-intro_layout"><div class="collection-intro_text-col"><h1 li-object="collection.title" class="collection-intro_title">{{ collection.title }}</h1><div li-if:inside="collection.description != blank" inside="1">
        {% if collection.description != blank %}
            <div li-object="collection.description" class="collection-intro_desc text-size-regular">{{ collection.description }}</div>        {% endif %}
    </div></div><div li-cf-theme-blocks="" class="collection-intro_tiles">
{% content_for 'blocks' %}
</div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Collection Intro",
    "class": "section_collection-intro",
    "blocks": [
        {
            "type": "kategorie-bild"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 2.5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 2.5
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#0f0f0f"
        }
    ],
    "presets": [
        {
            "name": "Collection Intro",
            "category": "Showcase",
            "blocks": [
                {
                    "type": "kategorie-bild"
                }
            ]
        }
    ],
    "enabled_on": {
        "templates": [
            "collection"
        ]
    }
} {% endschema %}