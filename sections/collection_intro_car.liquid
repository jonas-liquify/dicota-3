<div class="padding-global coll-intro-cards_padding" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem; background-color: {{ section.settings.bg_color }};"><div class="container-large"><div class="coll-intro-cards_layout"><div class="coll-intro-cards_intro"><h2 class="coll-intro-cards_heading heading-style-h4">
{{ section.settings.text_uberschrift }}
</h2><p class="coll-intro-cards_text text-size-medium"> {{ section.settings.textarea_einleitungstext }} </p></div><div li-cf-theme-blocks="" class="coll-intro-cards_grid">
{% content_for 'blocks' %}
</div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Collection Intro Car",
    "class": "section_collection-intro-cards",
    "blocks": [
        {
            "type": "use-case"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Backpack with intro"
        },
        {
            "id": "textarea_einleitungstext",
            "type": "textarea",
            "label": "Einleitungstext",
            "default": "This is where a short intro sentence could go, briefly introducing the category and giving customers helpful information about DICOTA's product range."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 6
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        }
    ],
    "presets": [
        {
            "name": "Collection Intro Car",
            "category": "Showcase",
            "blocks": [
                {
                    "type": "use-case"
                }
            ]
        }
    ]
} {% endschema %}