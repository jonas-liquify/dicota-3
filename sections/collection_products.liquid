<div class="coll_filter-bar-outer"><div class="padding-global"><div class="container-large"><div class="coll_filter-bar"><div class="coll_filter-pills">{% for filter in collection.filters %}    <div li-for="filter in collection.filters" class="coll_filter-pill-group" x-data="{ open: false }">
                                    <button type="button" class="coll_filter-pill"><span li-object="filter.label" class="coll_filter-pill-label">{{ filter.label }}</span><div class="icon-embed-xsmall w-embed"><svg width="100%" height="100%" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M2.55806 6.29544C2.46043 6.19781 2.46043 6.03952 2.55806 5.94189L3.44195 5.058C3.53958 4.96037 3.69787 4.96037 3.7955 5.058L8.00001 9.26251L12.2045 5.058C12.3021 4.96037 12.4604 4.96037 12.5581 5.058L13.4419 5.94189C13.5396 6.03952 13.5396 6.19781 13.4419 6.29544L8.17678 11.5606C8.07915 11.6582 7.92086 11.6582 7.82323 11.5606L2.55806 6.29544Z" fill="currentColor"></path></svg></div></button>
                            <div class="coll_filter-dropdown" x-show="open" false="">{% for filter_value in filter.values %}    <div li-for="filter_value in filter.values" class="coll_filter-option">
                                    <a href="{% if filter_value.active %}{{ filter_value.url_to_remove }}{% else %}{{ filter_value.url_to_add }}{% endif %}" class="{% if filter_value.active %}coll_filter-checkbox is-active{% else %}coll_filter-checkbox{% endif %}"><div class="coll_filter-checkbox-box"></div><span li-object="filter_value.label" class="coll_filter-checkbox-label">{{ filter_value.label }}</span><span class="coll_filter-count">(<span li-object="filter_value.count">{{ filter_value.count }}</span>)</span></a>
                        </div>
{% endfor %}</div>
                        </div>
{% endfor %}</div><div class="coll_sort-wrap"><span class="coll_sort-label">Sort by</span><div class="coll_sort-inner"><select id="sort-by-coll" li-for:inside="option in collection.sort_options" class="coll_sort-select">
        {% for option in collection.sort_options %}                            <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% elsif option.value == collection.default_sort_by %}selected{% endif %}>{{ option.name }}</option>
                    {% endfor %}    </select><div class="icon-embed-xsmall w-embed"><svg width="100%" height="100%" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M2.55806 6.29544C2.46043 6.19781 2.46043 6.03952 2.55806 5.94189L3.44195 5.058C3.53958 4.96037 3.69787 4.96037 3.7955 5.058L8.00001 9.26251L12.2045 5.058C12.3021 4.96037 12.4604 4.96037 12.5581 5.058L13.4419 5.94189C13.5396 6.03952 13.5396 6.19781 13.4419 6.29544L8.17678 11.5606C8.07915 11.6582 7.92086 11.6582 7.82323 11.5606L2.55806 6.29544Z" fill="currentColor"></path></svg></div></div></div></div></div></div></div><div class="padding-global"><div class="container-large">{% paginate collection.products by 24 %}
    <div li-paginate="collection.products" li-paginate:by="24" by="24"><div class="coll_grid" li-for:inside="product in collection.products">
        {% for product in collection.products %}                            <div class="coll_grid-item">{% render 'product_card', product: product %}</div>
                            {% if forloop.index == section.settings.promo1_position %}    <div li-if="forloop.index == section.settings.promo1_position" class="coll_grid-item coll_promo-card">
    <div class="coll_promo-card_inner"><div class="coll_promo-card_content"><h3 class="coll_promo-card_title">
{{ section.settings.text_promo_1_headline }}
</h3><p class="coll_promo-card_desc text-size-regular"> {{ section.settings.textarea_promo_1_text }} </p><a href="{{ section.settings.url_promo_1_link }}" class="coll_promo-card_cta w-button"> <span>{{ section.settings.text_promo_1_button }}</span> </a></div><div class="coll_promo-card_media">{% if section.settings.image_promo_1_bild %}
{{ section.settings.image_promo_1_bild | image_url: width: 500 | image_tag: loading: 'lazy', class: 'coll_promo-card_image' }}
{% else %}
<img src="{{ 'placeholder.svg' | asset_url }}" loading="lazy" alt="" class="coll_promo-card_image">
{% endif %}</div></div>    </div>
{% endif %}
                            {% if forloop.index == section.settings.promo2_position %}    <div li-if="forloop.index == section.settings.promo2_position" class="coll_grid-item coll_promo-card">
    <div class="coll_promo-card_inner"><div class="coll_promo-card_content"><h3 class="coll_promo-card_title">
{{ section.settings.text_promo_2_headline }}
</h3><p class="coll_promo-card_desc text-size-regular"> {{ section.settings.textarea_promo_2_text }} </p><a href="{{ section.settings.url_promo_2_link }}" class="coll_promo-card_cta w-button"> <span>{{ section.settings.text_promo_2_button }}</span> </a></div><div class="coll_promo-card_media">{% if section.settings.image_promo_2_bild %}
{{ section.settings.image_promo_2_bild | image_url: width: 500 | image_tag: loading: 'lazy', class: 'coll_promo-card_image' }}
{% else %}
<img src="{{ 'placeholder.svg' | asset_url }}" loading="lazy" alt="" class="coll_promo-card_image">
{% endif %}</div></div>    </div>
{% endif %}
                    {% endfor %}    </div>{% if collection.products == blank %}    <div li-if="collection.products == blank" class="coll_empty">
    <div class="heading-style-h5">Keine Produkte gefunden.</div><p>Es gibt keine Produkte mit diesen Filterkriterien.</p>    </div>
{% endif %}{% if paginate.pages > 1 %}    <nav li-if="paginate.pages > 1" class="pagination_component">
    <ul role="list" class="pagination_list w-list-unstyled">{% if paginate.previous %}    <li li-if="paginate.previous" class="pagination_item">
    <a li-object:href="paginate.previous.url" href="{{ paginate.previous.url }}" class="button is-secondary is-icon w-inline-block"><div>Zurück</div></a>    </li>
{% endif %}{% for part in paginate.parts %}    <li li-for="part in paginate.parts" class="pagination_item">
                                    {% if part.is_link %}    <div li-if="part.is_link">
    <a li-object:href="part.url" href="{{ part.url }}" class="pagination_count w-inline-block"><div li-object="part.title" class="text-style-link">{{ part.title }}</div></a>    </div>
{% endif %}
                            {% if part.is_link == false %}    <div li-if="part.is_link == false">
    <div li-object="part.title" class="{% if part.title == paginate.current_page %}text-weight-semibold{% endif %}">{{ part.title }}</div>    </div>
{% endif %}
                        </li>
{% endfor %}{% if paginate.next %}    <li li-if="paginate.next" class="pagination_item">
    <a li-object:href="paginate.next.url" href="{{ paginate.next.url }}" class="button is-secondary is-icon w-inline-block"><div>Weiter</div></a>    </li>
{% endif %}</ul>    </nav>
{% endif %}</div>{% endpaginate %}</div></div><div class="hide w-embed w-script"><script>document.querySelector("#sort-by-coll")&&document.querySelector("#sort-by-coll").addEventListener("change",function(e){var p=new URLSearchParams(location.search);p.set("sort_by",e.target.value);location.search=p.toString();});</script></div> {% schema %} {
    "tag": "section",
    "name": "Collection Products",
    "class": "section_collection-products",
    "settings": [
        {
            "id": "text_promo_1_headline",
            "type": "text",
            "label": "Promo 1 Headline",
            "default": "WEIGH DARKER\u2122 MOON BAG RUFFLE"
        },
        {
            "id": "textarea_promo_1_text",
            "type": "textarea",
            "label": "Promo 1 Text",
            "default": "Raffiniertes Design. Recycelte Materialien."
        },
        {
            "id": "url_promo_1_link",
            "type": "url",
            "label": "Promo 1 Link"
        },
        {
            "id": "text_promo_1_button",
            "type": "text",
            "label": "Promo 1 Button",
            "default": "JETZT SHOPPEN"
        },
        {
            "id": "image_promo_1_bild",
            "type": "image_picker",
            "label": "Promo 1 Bild"
        },
        {
            "id": "text_promo_2_headline",
            "type": "text",
            "label": "Promo 2 Headline",
            "default": "WEIGH DARKER\u2122 MOON BAG RUFFLE"
        },
        {
            "id": "textarea_promo_2_text",
            "type": "textarea",
            "label": "Promo 2 Text",
            "default": "Raffiniertes Design. Recycelte Materialien."
        },
        {
            "id": "url_promo_2_link",
            "type": "url",
            "label": "Promo 2 Link"
        },
        {
            "id": "text_promo_2_button",
            "type": "text",
            "label": "Promo 2 Button",
            "default": "JETZT SHOPPEN"
        },
        {
            "id": "image_promo_2_bild",
            "type": "image_picker",
            "label": "Promo 2 Bild"
        },
        {
            "type": "header",
            "content": "Promo-Karten"
        },
        {
            "type": "number",
            "id": "promo1_position",
            "label": "Promo 1 nach Produkt Nr.",
            "default": 10
        },
        {
            "type": "color",
            "id": "promo1_bg",
            "label": "Promo 1 Hintergrundfarbe",
            "default": "#162040"
        },
        {
            "type": "number",
            "id": "promo2_position",
            "label": "Promo 2 nach Produkt Nr.",
            "default": 22
        },
        {
            "type": "color",
            "id": "promo2_bg",
            "label": "Promo 2 Hintergrundfarbe",
            "default": "#162040"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 80,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        }
    ],
    "presets": [
        {
            "name": "Collection Products",
            "category": "Listing",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "collection"
        ]
    }
} {% endschema %}