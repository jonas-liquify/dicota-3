{% endif %}</ul>    </nav>
{% endif %}</div>{% endpaginate %}</div></div><div class="hide w-embed w-script"><script>(function(){
  var SELECTOR='section[data-section-rendering="collection-products"]';
  var DEBUG=true;
  var inflight=null;
  function log(){if(DEBUG&&window.console)console.info.apply(console,['[CollSR]'].concat([].slice.call(arguments)));}
  function warn(){if(window.console)console.warn.apply(console,['[CollSR]'].concat([].slice.call(arguments)));}
  function getSection(){return document.querySelector(SELECTOR);}
  log('script loaded');
  function renderFromUrl(url){
    var section=getSection();
    if(!section){warn('no section in DOM');return;}
    var sectionId=section.dataset.sectionId;
    if(!sectionId||sectionId.indexOf('{'+'{'  )!==-1){warn('sectionId missing or unevaluated:',sectionId,'&mdash; falling back to navigation');location.href=url;return;}
    var target;try{target=new URL(url,location.origin);}catch(e){warn('invalid URL:',url);location.href=url;return;}
    var fetchUrl=new URL(target.toString());
    fetchUrl.searchParams.set('section_id',sectionId);
    log('fetching',fetchUrl.toString());
    if(inflight){inflight.abort();}
    var ctrl=new AbortController();inflight=ctrl;
    section.setAttribute('aria-busy','true');section.classList.add('is-loading');
    fetch(fetchUrl.toString(),{signal:ctrl.signal,headers:{'Accept':'text/html'}})
      .then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.text();})
      .then(function(html){
        var doc=new DOMParser().parseFromString(html,'text/html');
        var fresh=doc.querySelector(SELECTOR);
        if(!fresh){var w=doc.querySelector('[id^="shopify-section-"]');if(w)fresh=w.querySelector(SELECTOR);}
        if(!fresh)throw new Error('section not in response html');
        getSection().replaceWith(fresh);
        log('section replaced');
        target.searchParams.delete('section_id');
        history.pushState({},'',target.toString());
        if(window.Alpine){try{window.Alpine.initTree(getSection());}catch(e){warn('Alpine init err',e);}}
        var topY=getSection().getBoundingClientRect().top+window.pageYOffset-80;
        if(window.scrollY>topY)window.scrollTo({top:topY,behavior:'smooth'});
      })
      .catch(function(err){
        if(err.name==='AbortError'){log('aborted');return;}
        warn('fetch failed:',err.message,'&mdash; full reload as fallback');
        location.href=target.toString();
      })
      .finally(function(){var s=getSection();if(s){s.removeAttribute('aria-busy');s.classList.remove('is-loading');}inflight=null;});
  }
  document.addEventListener('click',function(e){
    var section=getSection();
    if(!section)return;
    if(!section.contains(e.target))return;
    var link=e.target.closest('a[data-coll-filter]');
    if(!link){var pag=e.target.closest('[data-coll-pagination]');if(pag)link=e.target.closest('a');}
    if(!link)return;
    var href=link.getAttribute('href');
    if(!href||href==='#'||href.indexOf('{'+'{'  )!==-1){log('skipped link (no real href):',href);return;}
    log('intercepting click on',href);
    e.preventDefault();
    renderFromUrl(link.href);
  },true);
  document.addEventListener('change',function(e){
    if(!e.target.matches||!e.target.matches('[data-coll-sort]'))return;
    var section=getSection();if(!section||!section.contains(e.target))return;
    log('sort changed to',e.target.value);
    var url=new URL(location.href);
    url.searchParams.set('sort_by',e.target.value);
    renderFromUrl(url.toString());
  });
  window.addEventListener('popstate',function(){log('popstate');renderFromUrl(location.href);});
})();</script></div><div class="hide w-embed"><script type="application/json" id="collection-download-data">{% paginate collection.products by 50 %}{ "collection": {{ collection.title | handle | json }}, "pages": {{ paginate.pages }}, "images": [{% assign cd_first = true %}{% for product in collection.products %}{% assign cd_sku = product.selected_or_first_available_variant.sku | default: product.handle %}{% for image in product.images %}{% assign image_url = image.src | image_url %}{% if image_url contains '_01' or image_url contains '_02' or image_url contains '_03' or image_url contains '_04' or image_url contains '_05' or image_url contains '_06' or image_url contains '_07' or image_url contains '_08' or image_url contains '_09' or image_url contains '_10' or image_url contains '_11' or image_url contains '_12' or image_url contains '_13' or image_url contains '_14' or image_url contains '_15' or image_url contains '_16' or image_url contains '_17' or image_url contains '_18' or image_url contains '_19' %}{% unless cd_first %},{% endunless %}{ "url": "https:{{ image.src | image_url: width: 2000 }}", "sku": {{ cd_sku | json }}, "filename": "{{ cd_sku }}_{{ forloop.index }}.jpg" }{% assign cd_first = false %}{% endif %}{% endfor %}{% endfor %}] }{% endpaginate %}</script></div><div id="collection-download-overlay" class="coll-dl-overlay"><div class="coll-dl-spinner"></div><p class="coll-dl-title text-weight-medium">
{{ section.settings.text_download_titel }}
</p><p id="collection-download-progress" class="coll-dl-progress text-style-muted">Please wait, the ZIP file is being created.</p></div><div class="hide w-embed w-script"><script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script><script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script><script>(function(){function init(){var params=new URLSearchParams(window.location.search);if(params.get('download')!=='true')return;var el=document.getElementById('collection-download-data');if(!el)return;var meta;try{meta=JSON.parse(el.textContent);}catch(e){return;}var section=document.querySelector('section[data-section-rendering="collection-products"]');var sectionId=section&&section.dataset.sectionId;if(sectionId&&sectionId.indexOf('{'+'{')!==-1)sectionId=null;var pages=(meta&&meta.pages)||1;var overlay=document.getElementById('collection-download-overlay');var prog=document.getElementById('collection-download-progress');if(overlay)overlay.style.display='flex';var all=[];function collect(a){if(a&&a.length)all=all.concat(a);}function fetchPage(n){var u=new URL(window.location.href);u.searchParams.set('page',n);u.searchParams.delete('download');if(sectionId)u.searchParams.set('section_id',sectionId);return fetch(u.toString(),{headers:{'Accept':'text/html'}}).then(function(r){return r.text();}).then(function(html){var doc=new DOMParser().parseFromString(html,'text/html');var d=doc.getElementById('collection-download-data');if(d){try{var pd=JSON.parse(d.textContent);collect(pd.images);}catch(e){}}}).catch(function(){});}var chain=Promise.resolve();if(sectionId){for(var p=1;p<=pages;p++){(function(pg){chain=chain.then(function(){if(prog)prog.textContent='Reading page '+pg+' of '+pages+'&hellip;';return fetchPage(pg);});})(p);}}else{collect(meta.images);}chain.then(function(){var seen={},images=[];all.forEach(function(im){if(im&&im.url&&!seen[im.url]){seen[im.url]=1;images.push(im);}});if(!images.length){if(overlay)overlay.style.display='none';return;}var zip=new JSZip();var loaded=0;var tasks=images.map(function(img){var uu=img.url;if(uu.indexOf('//')===0)uu='https:'+uu;return fetch(uu).then(function(r){if(!r.ok)throw new Error('net');return r.blob();}).then(function(blob){zip.folder(img.sku).file(img.filename,blob);loaded++;if(prog)prog.textContent='Loading image '+loaded+' of '+images.length+'&hellip;';}).catch(function(){});});return Promise.all(tasks).then(function(){if(prog)prog.textContent='Generating ZIP&hellip;';return zip.generateAsync({type:'blob'});}).then(function(content){saveAs(content,'Collection_'+(meta.collection||'images')+'.zip');});}).catch(function(e){if(window.console)console.error('Download error:',e);}).finally(function(){if(overlay)overlay.style.display='none';});}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();})();</script></div> {% schema %} {
