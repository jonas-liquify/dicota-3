<div class="padding-global padding-section-medium"><div class="container-large"><div class="w-layout-grid contact_component"><div class="contact_form-box"><h1 class="heading-style-h2">
{{ section.settings.text_heading }}
</h1>{% if section.settings.text_paragraph != blank %}    <div class="li-guard" li-if="section.settings.text_paragraph != blank">
    <p class="text-size-medium">
{{ section.settings.text_paragraph }}
</p>    </div>
{% endif %}<div li-cf-theme-blocks="" class="contact_app-slot">
{% content_for 'blocks' %}
</div></div><div class="contact_content">{% if section.settings.image_contact_photo != blank %}    <div class="li-guard" li-if="section.settings.image_contact_photo != blank">
    <div class="contact_photo-card"><div class="default-bg-wrapper">{% if section.settings.image_contact_photo %}
{{ section.settings.image_contact_photo | image_url: width: 900 | image_tag: loading: 'lazy', class: 'default-bg-image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="default-bg-image">
{% endif %}</div><div class="contact_photo-caption"><div class="heading-style-h3">
{{ section.settings.text_contact_name }}
</div><div class="text-size-medium">
{{ section.settings.text_contact_role }}
</div></div></div>    </div>
{% endif %}<div class="contact_bottom"><div class="contact_bottom-inner"><div class="contact_contact-row"><div class="text-style-subline">
{{ section.settings.text_address_subline }}
</div><div class="text-size-medium"> {{ section.settings.richtext_address_text }} </div></div><div class="contact_trennlinie"></div><div class="contact_contact-row"><div class="text-style-subline">
{{ section.settings.text_contact_subline }}
</div>{% content_for "block", type: "contact-list", id: "contact-list" %}</div>{% if section.settings.text_opening_hours != blank %}    <div class="li-guard" li-if="section.settings.text_opening_hours != blank">
    <div class="text-size-medium">
{{ section.settings.text_opening_hours }}
</div>    </div>
{% endif %}</div></div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Contact Form",
    "class": "section_contact",
    "blocks": [
        {
            "type": "contact-location"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "How can we help you?"
        },
        {
            "id": "text_paragraph",
            "type": "text",
            "label": "Paragraph",
            "default": "Get in touch and we'll get back to you as soon as possible."
        },
        {
            "id": "image_contact_photo",
            "type": "image_picker",
            "label": "Contact Photo"
        },
        {
            "id": "text_contact_name",
            "type": "text",
            "label": "Contact Name",
            "default": "Viktoriia M\u00fcller"
        },
        {
            "id": "text_contact_role",
            "type": "text",
            "label": "Contact Role",
            "default": "Dicota contact person"
        },
        {
            "id": "text_address_subline",
            "type": "text",
            "label": "Address Subline",
            "default": "Headquarters"
        },
        {
            "id": "richtext_address_text",
            "type": "richtext",
            "label": "Address Text",
            "default": "<p>DICOTA SCHWEIZ AG<br\/>Churerstrasse 20<br\/>8808 Pf\u00e4ffikon SZ<br\/>SWITZERLAND<\/p>"
        },
        {
            "id": "text_contact_subline",
            "type": "text",
            "label": "Contact Subline",
            "default": "Regional"
        },
        {
            "id": "text_opening_hours",
            "type": "text",
            "label": "Opening Hours",
            "default": "Monday \u2013 Friday: 08:00 \u2013 17:00"
        }
    ],
    "presets": [
        {
            "name": "Contact Form",
            "category": "Form",
            "blocks": [
                {
                    "type": "contact-list",
                    "static": true,
                    "id": "contact-list",
                    "blocks": [
                        {
                            "type": "contact-location"
                        }
                    ]
                }
            ]
        }
    ]
} {% endschema %}