{% if section.settings.image_bg_image != blank %}    <span class="li-guard" li-if="section.settings.image_bg_image != blank">
    {% if section.settings.image_bg_image %}
{{ section.settings.image_bg_image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'discover_image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="discover_image">
{% endif %}    </span>
{% endif %}<div class="discover_item background-color-primary"><div class="discover_item-content"><h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2><div class="text-size-medium"> {{ section.settings.textarea_text }} </div>{% if section.settings.text_button_text != blank %}    <span class="li-guard" li-if="section.settings.text_button_text != blank">
    <a href="{{ section.settings.url_button_link }}" class="button is-white w-button"> <span>{{ section.settings.text_button_text }}</span> </a>    </span>
{% endif %}</div></div> {% schema %} {
    "tag": "section",
    "name": "Discover Banner",
    "class": "section_discover",
    "settings": [
        {
            "id": "image_bg_image",
            "type": "image_picker",
            "label": "BG Image"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "One for all. All for you."
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "People make the real difference. Top performance comes only from motivated and reliable colleagues. That's what we live by at DICOTA."
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Discover now"
        }
    ],
    "presets": [
        {
            "name": "Discover Banner",
            "category": "Showcase",
            "blocks": []
        }
    ]
} {% endschema %}