<div class="padding-global padding-section-medium" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"><div class="container-large"><div class="faq_wrapper"><div class="default-flex-small faq_sidebar"><h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2><div class="text-size-medium"> {{ section.settings.textarea_text }} </div>{% if section.blocks.size > 1 %}    <nav class="faq_anchor-nav">
    {% for cat in section.blocks %}    <div style="display:contents">
    <a href="#faq-{{ cat.id }}" class="faq_anchor-link"><span>{{ cat.settings.text_kategorie_titel }}</span></a>
    </div>
{% endfor %}    </nav>
{% endif %}</div><div li-cf-theme-blocks="" class="faq_categories">
{% content_for 'blocks' %}
</div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "FAQ Accordion",
    "class": "section_faq",
    "blocks": [
        {
            "type": "faq-kategorie"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Frequently asked questions"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "If you have questions about applying, the selection process or getting started \u2014 we have answers."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 5
        }
    ],
    "presets": [
        {
            "name": "FAQ Accordion",
            "category": "Content",
            "blocks": [
                {
                    "type": "faq-kategorie"
                }
            ]
        }
    ]
} {% endschema %}