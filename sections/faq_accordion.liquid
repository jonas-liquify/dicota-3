<div class="padding-global padding-section-medium"><div class="container-large"><div class="faq_wrapper"><div class="default-flex-small"><h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2><div class="text-size-medium"> {{ section.settings.textarea_text }} </div></div><div class="faq_component">{% for faq in shop.metaobjects.faq.values %}    <div x-data="{open: false}" li-for="faq in shop.metaobjects.faq.values" class="faq_item background-color-alternate">
                                    <div tabindex="0" role="button" x-on:click="open=!open" x-bind:aria-expanded="open?'true':'false'" class="faq_header"><div li-object="faq.frage" class="text-size-medium text-weight-medium">{{ faq.frage }}</div><div class="faq_icon-outer"><div class="faq_icon-line"></div><div x-bind:class="open?'is-open':''" class="faq_icon-line is-rotating"></div></div></div>
                            <div x-bind:class="open?'is-open':''" class="faq_body"><div class="faq_body-content"><div li-object="faq.antwort" class="text-size-regular">{{ faq.antwort }}</div></div></div>
                        </div>
{% endfor %}</div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "FAQ Accordion",
    "class": "section_faq",
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "H\u00e4ufige Fragen"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "Wenn du Fragen zur Bewerbung, zum Auswahlprozess oder zu deinem Start hast \u2014 wir haben Antworten."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        }
    ],
    "presets": [
        {
            "name": "FAQ Accordion",
            "category": "Content",
            "blocks": []
        }
    ]
} {% endschema %}