<div class="padding-global padding-section-medium"><div class="container-large"><div class="default-regular-component"><div class="why-us_grid"><div class="default-flex-small"><div class="text-style-subline">
{{ section.settings.text_subline }}
</div><h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2><div class="text-size-medium"> {{ section.settings.textarea_text }} </div>{% if section.settings.text_button_text != blank %}    <div li-if="section.settings.text_button_text != blank" class="button-wrapper">
    <a href="{{ section.settings.url_button_link }}" class="button w-button"> <span>{{ section.settings.text_button_text }}</span> </a>    </div>
{% endif %}</div>{% content_for "block", type: "feature-cards", id: "feature-cards" %}</div>{% content_for "block", type: "stats-row", id: "stats-row" %}</div></div></div> {% schema %} {
    "tag": "section",
    "name": "Feature Card Grid",
    "class": "section_why-us",
    "blocks": [
        {
            "type": "karte"
        },
        {
            "type": "stats-block"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_subline",
            "type": "text",
            "label": "Subline",
            "default": "Warum DICOTA"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Mehr als nur Produkte"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "Wir kombinieren Schweizer Qualit\u00e4t, durchdachtes Design und Nachhaltigkeit in jedem Detail."
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Unsere Werte"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        }
    ],
    "presets": [
        {
            "name": "Feature Card Grid",
            "category": "Listing",
            "blocks": [
                {
                    "type": "feature-cards",
                    "static": true,
                    "id": "feature-cards",
                    "blocks": [
                        {
                            "type": "karte"
                        }
                    ]
                },
                {
                    "type": "stats-row",
                    "static": true,
                    "id": "stats-row",
                    "blocks": [
                        {
                            "type": "stats-block"
                        }
                    ]
                }
            ]
        }
    ]
} {% endschema %}