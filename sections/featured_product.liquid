<div class="padding-global" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;background-color:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};"><div class="container-large"><article class="feature-product_card" style="background-color:{{ section.settings.card_bg }};"><div class="feature-product_media">{% if section.settings.image_produkt_bild %}
{{ section.settings.image_produkt_bild | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'feature-product_image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="feature-product_image">
{% endif %}<button type="button" class="feature-product_favorite" aria-label="Auf Wunschliste setzen"><div class="icon-embed-xsmall w-embed">{% render 'icon_favorite' %}</div></button></div><div class="feature-product_content"><h2 class="feature-product_title">
{{ section.settings.text_produkt_titel }}
</h2><p class="feature-product_desc"> {{ section.settings.textarea_beschreibung }} </p><a href="{{ section.settings.url_button_link }}" class="button is-outline feature-product_button w-button"> <span>{{ section.settings.text_button_text }}</span> </a></div></article></div></div> {% schema %} {
    "tag": "section",
    "name": "Featured Product",
    "class": "section_feature-product",
    "settings": [
        {
            "id": "image_produkt_bild",
            "type": "image_picker",
            "label": "Produkt-Bild"
        },
        {
            "id": "text_produkt_titel",
            "type": "text",
            "label": "Produkt-Titel",
            "default": "Blickschutzfilter 2-fach magnetisch Universal (16:10)"
        },
        {
            "id": "textarea_beschreibung",
            "type": "textarea",
            "label": "Beschreibung",
            "default": "Der DICOTA 2-Wege-Blickschutzfilter ist ideal f\u00fcr die Arbeit in \u00f6ffentlichen Umgebungen wie Bibliotheken, Gro\u00dfraumb\u00fcros, Flugh\u00e4fen und Z\u00fcgen. Er sch\u00fctzt pers\u00f6nliche und vertrauliche Daten, indem er die rechte und linke Seite des Bildschirms in einem Winkel von +\/- 30 Grad abdunkelt."
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Mehr erfahren"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 100
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Section-Hintergrund",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#0f0f0f"
        },
        {
            "type": "color",
            "id": "card_bg",
            "label": "Karten-Hintergrund",
            "default": "#f6f6f6"
        }
    ],
    "presets": [
        {
            "name": "Featured Product",
            "category": "Showcase",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "collection"
        ]
    }
} {% endschema %}