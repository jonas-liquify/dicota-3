<div class="padding-global" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"><div class="container-large"><div class="featured-products_heading"><h3 class="featured-products_title">
{{ section.settings.text_uberschrift }}
</h3><a href="{{ section.settings.url_button_link }}" class="button is-outline featured-products_button w-button"> <span>{{ section.settings.text_button_text }}</span> </a></div><div class="featured-products_slider-wrapper"><div class="featured-products_swiper swiper"><div role="list" class="swiper-wrapper featured-products_list">{% for product in section.settings.collection_kollektion.products limit: section.settings.collection_kollektion_limit %}
<div role="listitem" class="swiper-slide featured-products_item">
    {% render 'product_card', product: product %}
</div>
{% endfor %}</div><div class="featured-products_scrollbar swiper-scrollbar"></div></div><button type="button" class="featured-products_arrow swiper-button-next" aria-label="Weiter"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_right' %}</div></button><button type="button" class="featured-products_arrow is-prev swiper-button-prev" aria-label="Zurück"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_left' %}</div></button></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Featured Products",
    "class": "section_featured-products",
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "New Releases"
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Alle New Releases"
        },
        {
            "id": "collection_kollektion",
            "type": "collection",
            "label": "Kollektion"
        },
        {
            "type": "range",
            "id": "collection_kollektion_limit",
            "min": 1,
            "max": 99,
            "step": 1,
            "label": "Limit: Kollektion",
            "default": 6
        },
        {
            "type": "paragraph",
            "content": "Tipp: \u00dcber das Kollektions-Setting im Slider-Block oben w\u00e4hlst du, welche Produkte angezeigt werden."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 40
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#0f0f0f"
        }
    ],
    "presets": [
        {
            "name": "Featured Products",
            "category": "Liquify",
            "blocks": []
        }
    ]
} {% endschema %}