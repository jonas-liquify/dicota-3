<div class="padding-global" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem; background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"><div class="container-large"><div class="featured-products_heading"><h3 class="featured-products_title heading-style-h3">
{{ section.settings.text_uberschrift }}
</h3>{% if section.settings.show_view_all %}    <span class="li-guard" li-if="section.settings.show_view_all">
    <a href="{{ section.settings.url_button_link }}" class="button is-outline featured-products_button w-button"> <span>{{ section.settings.text_button_text }}</span> </a>    </span>
{% endif %}</div><div class="featured-products_slider-wrapper"><div class="featured-products_swiper swiper"><div role="list" class="swiper-wrapper featured-products_list">{% for product in section.settings.collection_kollektion.products limit: section.settings.collection_kollektion_limit %}
<div role="listitem" class="swiper-slide featured-products_item">
    {% render 'product_card', product: product %}
</div>
{% endfor %}</div><div class="featured-products_scrollbar swiper-scrollbar"></div></div><button type="button" class="featured-products_arrow swiper-button-next" aria-label="Next"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_right' %}</div></button><button type="button" class="featured-products_arrow is-prev swiper-button-prev" aria-label="Previous"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_left' %}</div></button></div></div></div><div class="hide w-embed w-script"><script>document.addEventListener("DOMContentLoaded", function() { var ensure = function(cb) { if (typeof Swiper !== "undefined") return cb(); if (window.__swiperLoading) return window.__swiperLoading.then(cb); var s = document.createElement("script"); s.src = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"; var link = document.createElement("link"); link.rel = "stylesheet"; link.href = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"; document.head.appendChild(link); window.__swiperLoading = new Promise(function(res) { s.onload = res; }); document.head.appendChild(s); window.__swiperLoading.then(cb); }; ensure(function() { document.querySelectorAll(".featured-products_swiper.swiper").forEach(function(el) { if (el.swiper) return; var root = el.closest(".section_featured-products") || document; new Swiper(el, { slidesPerView: "auto", spaceBetween: 5, navigation: { nextEl: root.querySelector(".featured-products_arrow.swiper-button-next"), prevEl: root.querySelector(".featured-products_arrow.is-prev"), disabledClass: "swiper-button-disabled" }, scrollbar: { el: el.querySelector(".featured-products_scrollbar"), draggable: true } }); }); }); });</script></div> {% schema %} {
    "tag": "section",
    "name": "Featured Products",
    "class": "section_featured-products",
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "You may also like"
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "All new releases"
        },
        {
            "id": "collection_kollektion",
            "type": "collection",
            "label": "Kollektion"
        },
        {
            "type": "range",
            "id": "collection_kollektion_limit",
            "min": 1,
            "max": 99,
            "step": 1,
            "label": "Limit: Kollektion",
            "default": 6
        },
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "checkbox",
            "id": "show_view_all",
            "label": "\"Alle anzeigen\"-Button anzeigen",
            "default": true
        },
        {
            "type": "paragraph",
            "content": "Tipp: \u00dcber das Kollektions-Setting im Slider-Block oben w\u00e4hlst du, welche Produkte angezeigt werden."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 2.5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 5
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#0f0f0f"
        }
    ],
    "presets": [
        {
            "name": "Featured Products",
            "category": "Listing",
            "blocks": []
        }
    ]
} {% endschema %}