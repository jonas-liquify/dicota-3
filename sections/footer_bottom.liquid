<div class="padding-global" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"><div class="container-large"><div class="footer-bottom_row">{% if shop.enabled_payment_types.size > 0 %}    <ul li-if="shop.enabled_payment_types.size > 0" role="list" class="footer-bottom_payments">
    {% for type in shop.enabled_payment_types %}    <li li-for="type in shop.enabled_payment_types" class="footer-bottom_payment-item">
                                    <div li-object="type | payment_type_svg_tag: class: 'footer-bottom_payment-svg'" class="footer-bottom_payment-svg-wrap">{{ type | payment_type_svg_tag: class: 'footer-bottom_payment-svg' }}</div>
                        </li>
{% endfor %}    </ul>
{% endif %}<ul li-cf-theme-blocks="" role="list" class="footer-bottom_socials">
{% content_for 'blocks' %}
</ul></div></div></div><div class="footer-bottom_legal-band"><div class="padding-global"><div class="container-large"><div class="footer-bottom_legal-row"><p class="footer-bottom_copyright">
{{ section.settings.text_copyright }}
</p><nav class="footer-bottom_legal-links">{% for link in linklists[section.settings.legal_menu].links %}    <div li-for="link in linklists[section.settings.legal_menu].links" class="footer-bottom_legal-item">
                                    <a li-object="link.title" li-object:href="link.url" href="{{ link.url }}" class="footer-bottom_legal-link">{{ link.title }}</a>
                        </div>
{% endfor %}</nav>{% render 'localization_picker' %}</div></div></div></div><div class="hide w-embed w-script"><script>
        /* Externe Links (nicht auf die eigene Domain) immer im neuen Tab &ouml;ffnen. */
        (function () {
          function markLink(a) {
            if (!a || a.hasAttribute('target')) return;
            var href = a.getAttribute('href');
            if (!href || href.charAt(0) === '#' || href.indexOf('mailto:') === 0 || href.indexOf('tel:') === 0 || href.indexOf('javascript:') === 0) return;
            var url;
            try { url = new URL(href, window.location.href); } catch (e) { return; }
            if (url.hostname && url.hostname !== window.location.hostname) {
              a.setAttribute('target', '_blank');
              a.setAttribute('rel', ((a.getAttribute('rel') || '') + ' noopener noreferrer').trim());
            }
          }
          function markAll(root) {
            if (!root || !root.querySelectorAll) return;
            root.querySelectorAll('a[href]').forEach(markLink);
          }
          markAll(document);
          new MutationObserver(function (mutations) {
            mutations.forEach(function (m) {
              m.addedNodes.forEach(function (node) {
                if (node.nodeType !== 1) return;
                if (node.matches && node.matches('a[href]')) markLink(node);
                markAll(node);
              });
            });
          }).observe(document.body, { childList: true, subtree: true });
        })();
      </script></div> {% schema %} {
    "tag": "section",
    "name": "Footer Bottom",
    "class": "section_footer-bottom",
    "blocks": [
        {
            "type": "social"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_copyright",
            "type": "text",
            "label": "Copyright",
            "default": "\u00a92026 DCT Group AG"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 2.5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 0
        },
        {
            "type": "header",
            "content": "Legal-Men\u00fc"
        },
        {
            "type": "link_list",
            "id": "legal_menu",
            "label": "Legal Linkliste",
            "default": "footer"
        }
    ],
    "presets": [
        {
            "name": "Footer Bottom",
            "category": "Global",
            "blocks": [
                {
                    "type": "social"
                }
            ]
        }
    ],
    "enabled_on": {
        "groups": [
            "*"
        ]
    }
} {% endschema %}