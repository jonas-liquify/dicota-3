<div class="footer-newsletter_inner"><div class="footer-newsletter_promos">{% if section.settings.text_promo_1_text != blank %}    <span class="li-guard" li-if="section.settings.text_promo_1_text != blank">
    <a href="{{ section.settings.url_promo_1_link }}" class="footer-newsletter_promo"> <div class="footer-newsletter_promo-icon w-embed"><svg width="100%" height="100%" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16.5 12C18.43 12 20 10.43 20 8.5C20 6.57 18.43 5 16.5 5C15.61 5 14.79 5.34 14.18 5.9C15.31 6.97 16 8.46 16 10C16 10.71 15.86 11.39 15.61 12H16.5ZM5 11C5 8.79 6.79 7 9 7C11.21 7 13 8.79 13 11C13 13.21 11.21 15 9 15C6.79 15 5 13.21 5 11ZM2 18C2 15.34 7.33 14 9 14C10.67 14 16 15.34 16 18V19H2V18ZM22 18V19H17V18C17 16.86 16.46 16.04 15.76 15.35C18.27 15.79 22 17.07 22 18ZM16.5 3C18.86 3 20.91 4.49 21.65 6.6C20.6 4.79 18.7 3.5 16.5 3.5C16.21 3.5 15.94 3.53 15.67 3.58C15.91 3.27 16.19 3 16.5 3Z" fill="currentColor"></path></svg></div><span class="footer-newsletter_promo-text">{{ section.settings.text_promo_1_text }}</span> </a>    </span>
{% endif %}{% if section.settings.text_promo_2_text != blank %}    <span class="li-guard" li-if="section.settings.text_promo_2_text != blank">
    <a href="{{ section.settings.url_promo_2_link }}" class="footer-newsletter_promo"> <div class="footer-newsletter_promo-icon w-embed"><svg width="100%" height="100%" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 4H4C2.89 4 2.01 4.89 2.01 6L2 18C2 19.11 2.89 20 4 20H20C21.11 20 22 19.11 22 18V6C22 4.89 21.11 4 20 4ZM20 18H4V12H20V18ZM20 8H4V6H20V8ZM12.5 16C13.61 14.85 15.39 14.85 16.5 16L17.5 15C15.84 13.34 13.16 13.34 11.5 15L12.5 16Z" fill="currentColor"></path></svg></div><span class="footer-newsletter_promo-text">{{ section.settings.text_promo_2_text }}</span> </a>    </span>
{% endif %}</div><div class="footer-newsletter_main"><div class="footer-newsletter_pitch"><h2 class="footer-newsletter_headline">
{{ section.settings.text_headline }}
</h2><p class="footer-newsletter_subtext"> {{ section.settings.textarea_subtext }} </p>{% if section.settings.show_form == true %}    <div li-if="section.settings.show_form == true" class="footer-newsletter_form-block w-form">
    {% form 'customer', return_to: '/', class: 'footer-newsletter_form' %}
<div class="footer-newsletter_form-field"><label for="footer-newsletter-email" class="form_hidden-label">Your email address</label><input class="form_input footer-newsletter_form-input w-input" maxlength="256" name="contact[email]" data-name="Email" placeholder="{{ section.settings.placeholder_text }}" type="email" id="footer-newsletter-email" required=""></div><input type="hidden" name="contact[accepts_marketing]" value="true"><input type="submit" data-wait="Please wait..." class="button footer-newsletter_form-submit w-button" value="Sign up now">{% endform %}<div class="hide w-form-done"><div>Thank you! Your submission has been received.</div></div><div class="hide w-form-fail"><div>Oops! Something went wrong while submitting.</div></div>    </div>
{% endif %}{% unless section.settings.show_form == true %}    <span class="li-guard" li-unless="section.settings.show_form == true">
    <a href="{{ section.settings.url_button_link }}" class="button footer-newsletter_button w-button"> <span>{{ section.settings.text_button_text }}</span> </a>    </span>
{% endunless %}</div><nav class="footer-newsletter_link-grid">{% for link in linklists[section.settings.footer_menu].links %}    <div li-for="link in linklists[section.settings.footer_menu].links" class="footer-newsletter_link-column">
                                    <p li-object="link.title" class="footer-newsletter_link-column-title">{{ link.title }}</p>
                            <ul li-for:inside="child_link in link.links" role="list" class="footer-newsletter_link-list">
        {% for child_link in link.links %}                            <li class="footer-newsletter_link-item"><a li-object="child_link.title" li-object:href="child_link.url" href="{{ child_link.url }}" class="footer-newsletter_link">{{ child_link.title }}</a></li>
                    {% endfor %}    </ul>
                        </div>
{% endfor %}</nav></div></div> {% schema %} {
