;var currency=(window.Shopify&&Shopify.currency&&Shopify.currency.active)||"EUR";try{price.textContent=(variant.price/100).toLocaleString(document.documentElement.lang||"de-DE",{style:"currency",currency:currency});}catch(e){price.textContent=(variant.price/100)+" "+currency;}text.appendChild(name);text.appendChild(price);var form=document.createElement("form");form.method="post";form.action="/cart/add";form.className="mini-cart_crosssell-form";var input=document.createElement("input");input.type="hidden";input.name="id";input.value=variant.id;var btn=document.createElement("button");btn.type="submit";btn.setAttribute("aria-label","Add to cart");btn.className="mini-cart_crosssell-add";btn.innerHTML='<svg width="100%" height="100%" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">';form.appendChild(input);form.appendChild(btn);info.appendChild(text);info.appendChild(form);li.appendChild(img);li.appendChild(info);list.appendChild(li);});container.classList.remove("hide");}).catch(function(){container.classList.add("hide");});}).catch(function(){});}function initCrossSell(){var toggle=document.querySelector('[li-element="mini-cart-toggle"]');if(toggle)toggle.addEventListener("click",fetchCrossSell);}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",initCrossSell);}else{initCrossSell();}})();</script></div> {% schema %} {
