        {
            "type": "range",
            "id": "autoplay_delay",
            "min": 3000,
            "max": 9500,
            "step": 500,
            "unit": "ms",
            "label": "Autoplay-Geschwindigkeit",
            "default": 6000
        },
        {
            "type": "header",
            "content": "Gr\u00f6\u00dfe"
        },
        {
            "type": "range",
            "id": "min_height",
            "min": 60,
            "max": 100,
            "step": 5,
            "unit": "vh",
            "label": "Mindesth\u00f6he",
            "default": 90
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#ffffff"
        }
    ],
    "presets": [
        {
            "name": "Hero Slider",
            "category": "Hero",
            "blocks": [
                {
                    "type": "slide"
                }
            ]
        }
    ]
} {% endschema %}