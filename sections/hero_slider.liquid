<div class="hero_swiper swiper" data-autoplay="{{ section.settings.autoplay }}" data-autoplay-delay="{{ section.settings.autoplay_delay }}" style="--hero-min-height: {{ section.settings.min_height }}vh; color: {{ section.settings.text_color }};"><div li-cf-theme-blocks="" class="swiper-wrapper hero_slides">
{% content_for 'blocks' %}
</div><button type="button" class="hero_arrow hero_arrow-prev swiper-button-prev" aria-label="Previous slide"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_left' %}</div></button><button type="button" class="hero_arrow hero_arrow-next swiper-button-next" aria-label="Next slide"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_right' %}</div></button><div class="hero_pagination"><div class="swiper-pagination hero_dots"></div><button type="button" class="hero_autoplay-toggle" aria-label="Pause autoplay"><span class="hero_autoplay-icon hero_autoplay-icon-pause w-embed" aria-hidden="true"><svg width="100%" height="100%" viewbox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><rect x="4" y="3" width="2.5" height="10"></rect><rect x="9.5" y="3" width="2.5" height="10"></rect></svg></span><span class="hero_autoplay-icon hero_autoplay-icon-play w-embed" aria-hidden="true"><svg width="100%" height="100%" viewbox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M4 3L13 8L4 13V3Z"></path></svg></span></button></div></div><div class="hide w-embed w-script"><script>document.addEventListener("DOMContentLoaded", function() { var ensure = function(cb) { if (typeof Swiper !== "undefined") return cb(); if (window.__swiperLoading) return window.__swiperLoading.then(cb); var s = document.createElement("script"); s.src = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"; var link = document.createElement("link"); link.rel = "stylesheet"; link.href = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"; if(!document.getElementById("swiper-css")){link.id="swiper-css";var _h=document.head,_f=_h.querySelector('link[rel="stylesheet"],style');_f?_h.insertBefore(link,_f):_h.appendChild(link);} window.__swiperLoading = new Promise(function(res) { s.onload = res; }); document.head.appendChild(s); window.__swiperLoading.then(cb); }; ensure(function() { document.querySelectorAll(".hero_swiper.swiper").forEach(function(el) { if (el.swiper) return; var hasAutoplay = el.dataset.autoplay === "true"; var sw = new Swiper(el, { slidesPerView: 1, loop: true, autoplay: hasAutoplay ? { delay: parseInt(el.dataset.autoplayDelay || 5000, 10), disableOnInteraction: false } : false, pagination: { el: el.querySelector(".hero_dots"), clickable: true, bulletClass: "hero_bullet", bulletActiveClass: "is-active", renderBullet: function(i, cls) { return '<button type="button" class="' + cls + '" aria-label="Slide ' + (i+1) + '"><span class="hero_bullet-progress">'; } }, navigation: { nextEl: el.querySelector(".hero_arrow-next"), prevEl: el.querySelector(".hero_arrow-prev"), disabledClass: "swiper-button-disabled" }, keyboard: { enabled: true, onlyInViewport: true }, on: { autoplayTimeLeft: function(swiper, time, progress) { var active = el.querySelector(".hero_bullet.is-active .hero_bullet-progress"); if (active) active.style.transform = "scaleX(" + (1 - progress) + ")"; }, slideChange: function() { el.querySelectorAll(".hero_bullet-progress").forEach(function(p) { p.style.transform = "scaleX(0)"; }); }, autoplayStop: function() { el.querySelectorAll(".hero_bullet-progress").forEach(function(p) { p.style.transform = "scaleX(0)"; }); } } }); var toggle = el.querySelector(".hero_autoplay-toggle"); if (toggle && sw.autoplay) { var update = function() { var running = sw.autoplay.running; toggle.classList.toggle("is-paused", !running); toggle.setAttribute("aria-label", running ? "Pause autoplay" : "Start autoplay"); }; toggle.addEventListener("click", function(e) { e.preventDefault(); if (sw.autoplay.running) sw.autoplay.stop(); else sw.autoplay.start(); update(); }); update(); } }); }); });</script></div> {% schema %} {
    "tag": "section",
    "name": "Hero Slider",
    "class": "section_hero",
    "blocks": [
        {
            "type": "slide"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "type": "header",
            "content": "Slider"
        },
        {
            "type": "checkbox",
            "id": "autoplay",
