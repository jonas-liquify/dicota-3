{% if section.settings.image_hintergrundbild != blank %}    <picture li-if="section.settings.image_hintergrundbild != blank" class="image-banner_bg-picture">
    {% if section.settings.image_hintergrundbild %}
{{ section.settings.image_hintergrundbild | image_url: width: 2400 | image_tag: loading: 'lazy', class: 'image-banner_bg-image' }}
{% else %}
<img src="{{ 'hero-apparel-2.svg' | asset_url }}" loading="lazy" alt="" class="image-banner_bg-image">
{% endif %}    </picture>
{% endif %}<div li-if:inside="section.settings.overlay_strength > 0" style="display:contents" inside="1">
        {% if section.settings.overlay_strength > 0 %}
            <div class="image-banner_overlay" style="background-color: rgba(0,0,0,{{ section.settings.overlay_strength | divided_by: 100.0 }});"></div>        {% endif %}
    </div><div class="image-banner_container{% if section.settings.full_bleed %} is-full-bleed{% endif %}" style="--banner-min-height: {{ section.settings.min_height }}vh; color: {{ section.settings.text_color }}; text-align: {{ section.settings.text_align }}; justify-content: {{ section.settings.content_vertical }}; align-items: {{ section.settings.content_horizontal }};"><div class="image-banner_content"><div class="image-banner_headline"><p class="image-banner_headline-line">
{{ section.settings.text_headline_zeile_1 }}
</p>{% if section.settings.text_headline_zeile_2 != blank %}    <div class="li-guard" li-if="section.settings.text_headline_zeile_2 != blank">
    <p class="image-banner_headline-line">
{{ section.settings.text_headline_zeile_2 }}
</p>    </div>
{% endif %}</div><p class="image-banner_subtext"> {{ section.settings.textarea_subtext }} </p>{% if section.settings.text_button_text != blank %}    <div li-if="section.settings.text_button_text != blank" class="image-banner_actions">
    <a href="{{ section.settings.url_button_link }}" class="button image-banner_button w-button"> <span>{{ section.settings.text_button_text }}</span> </a>    </div>
{% endif %}</div></div> {% schema %} {
    "tag": "section",
    "name": "Image Banner",
    "class": "section_image-banner",
    "settings": [
        {
            "id": "image_hintergrundbild",
            "type": "image_picker",
            "label": "Hintergrundbild"
        },
        {
            "id": "text_headline_zeile_1",
            "type": "text",
            "label": "Headline Zeile 1",
            "default": "Screen Filters"
        },
        {
            "id": "text_headline_zeile_2",
            "type": "text",
            "label": "Headline Zeile 2",
            "default": "By Dicota"
        },
        {
            "id": "textarea_subtext",
            "type": "textarea",
            "label": "Subtext",
            "default": "Refined design. Recycled materials."
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Shop now"
        },
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "range",
            "id": "min_height",
            "min": 30,
            "max": 90,
            "step": 5,
            "unit": "vh",
            "label": "Mindesth\u00f6he",
            "default": 45
        },
        {
            "type": "checkbox",
            "id": "full_bleed",
            "label": "Volle Breite (ohne seitliche Container-Begrenzung)",
            "default": true
        },
        {
            "type": "select",
            "id": "content_horizontal",
            "label": "Inhalt horizontal",
            "options": [
                {
                    "value": "flex-start",
                    "label": "Links"
                },
                {
                    "value": "center",
                    "label": "Zentriert"
                },
                {
                    "value": "flex-end",
                    "label": "Rechts"
                }
            ],
            "default": "flex-start"
        },
        {
            "type": "select",
            "id": "content_vertical",
            "label": "Inhalt vertikal",
            "options": [
                {
                    "value": "flex-start",
                    "label": "Oben"
                },
                {
                    "value": "center",
                    "label": "Mittig"
                },
                {
                    "value": "flex-end",
                    "label": "Unten"
                }
            ],
            "default": "center"
        },
        {
            "type": "select",
            "id": "text_align",
            "label": "Textausrichtung",
            "options": [
                {
                    "value": "left",
                    "label": "Links"
                },
                {
                    "value": "center",
                    "label": "Zentriert"
                },
                {
                    "value": "right",
                    "label": "Rechts"
                }
            ],
            "default": "left"
        },
        {
            "type": "header",
            "content": "Farben & Overlay"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#ffffff"
        },
        {
            "type": "range",
            "id": "overlay_strength",
            "min": 0,
            "max": 80,
            "step": 5,
            "unit": "%",
            "label": "Dunkles Overlay",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "Image Banner",
            "category": "Showcase",
            "blocks": []
        }
    ]
} {% endschema %}