<div class="image-link-list_inner{% if section.settings.image_position == 'right' %} is-image-right{% endif %}" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"><div class="image-link-list_image-side">{% if section.settings.image_bild != blank %}    <picture li-if="section.settings.image_bild != blank" class="image-link-list_picture">
    {% if section.settings.image_bild %}
{{ section.settings.image_bild | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'image-link-list_image' }}
{% else %}
<img src="{{ 'hero-apparel-3.svg' | asset_url }}" loading="lazy" alt="" class="image-link-list_image">
{% endif %}    </picture>
{% endif %}<img data-ill-hover="" src="{{ 'hero-apparel-3.svg' | asset_url }}" alt="" aria-hidden="true" class="image-link-list_hover-image"></div><div class="image-link-list_text-side"><div class="image-link-list_content">{% if section.settings.text_subtitle != blank %}    <div class="li-guard" li-if="section.settings.text_subtitle != blank">
    <p class="image-link-list_subtitle">
{{ section.settings.text_subtitle }}
</p>    </div>
{% endif %}<ul li-cf-theme-blocks="" class="image-link-list_links">
{% content_for 'blocks' %}
</ul><div class="image-link-list_actions">{% if section.settings.text_button_text != blank %}    <span class="li-guard" li-if="section.settings.text_button_text != blank">
    <a href="{{ section.settings.url_button_link }}" class="button is-on-dark"> <span>{{ section.settings.text_button_text }}</span> </a>    </span>
{% endif %}</div></div></div><div class="hide w-embed w-script"><script>(function(){function isDesktop(){return window.matchMedia("(min-width: 992px)").matches;}function initSection(sec){var hoverImg=sec.querySelector("[data-ill-hover]");var list=sec.querySelector(".image-link-list_links");if(!hoverImg||!list||sec.dataset.illBound==="1")return;sec.dataset.illBound="1";var links=sec.querySelectorAll(".image-link-list_link");var preloaded=false;function preload(){if(preloaded)return;preloaded=true;links.forEach(function(l){var u=l.getAttribute("data-hover-img");if(u){var i=new Image();i.src=u;}});}function show(u){if(hoverImg.getAttribute("src")!==u)hoverImg.setAttribute("src",u);hoverImg.classList.add("is-visible");}function hide(){hoverImg.classList.remove("is-visible");}links.forEach(function(l){l.addEventListener("mouseenter",function(){if(!isDesktop())return;preload();var u=l.getAttribute("data-hover-img");if(!u||u.indexOf("{"+"{")!==-1){hide();return;}show(u);});l.addEventListener("focus",function(){if(!isDesktop())return;var u=l.getAttribute("data-hover-img");if(u&&u.indexOf("{"+"{")===-1)show(u);});});list.addEventListener("mouseleave",hide);list.addEventListener("focusout",function(e){if(!list.contains(e.relatedTarget))hide();});window.addEventListener("resize",function(){if(!isDesktop())hide();});}function initAll(){document.querySelectorAll(".section_image-link-list").forEach(initSection);}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",initAll);}else{initAll();}})();</script></div></div> {% schema %} {
    "tag": "section",
    "name": "Image + Link List",
    "class": "section_image-link-list",
    "blocks": [
        {
            "type": "imagelink-list-link"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "image_bild",
            "type": "image_picker",
            "label": "Bild"
        },
        {
            "id": "text_subtitle",
            "type": "text",
            "label": "Subtitle",
            "default": "What are you looking for?"
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Go to product finder"
        },
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "select",
            "id": "image_position",
            "label": "Bild-Position",
            "options": [
                {
                    "value": "left",
                    "label": "Links"
                },
                {
                    "value": "right",
                    "label": "Rechts"
                }
            ],
            "default": "left"
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#0f0f0f"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#ffffff"
        }
    ],
    "presets": [
        {
            "name": "Image + Link List",
            "category": "Showcase",
            "blocks": [
                {
                    "type": "imagelink-list-link"
                }
            ]
        }
    ]
} {% endschema %}