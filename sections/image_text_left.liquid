<div class="split-image_image-block">{% if section.settings.image_bild %}
{{ section.settings.image_bild | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'split-image_image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="split-image_image">
{% endif %}</div><div class="split-image_content-wrapper is-left-image"><h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2><div class="text-size-regular"> {{ section.settings.textarea_text }} </div><div class="margin-top margin-small"><div class="button-group"><div class="button-wrapper"><a href="{{ section.settings.url_button_link }}" class="button is-secondary w-button"> <span>{{ section.settings.text_button_text }}</span> </a></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Image-Text \u2014 Left",
    "class": "section_split-image-left",
    "settings": [
        {
            "id": "image_bild",
            "type": "image_picker",
            "label": "Bild"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Recycelte Materialien"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "Unsere Backpacks bestehen zu gro\u00dfen Teilen aus recyceltem PET. So geben wir gebrauchten Plastikflaschen ein zweites Leben \u2014 als robuster Begleiter im Berufsalltag."
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Mehr erfahren"
        }
    ],
    "presets": [
        {
            "name": "Image-Text \u2014 Left",
            "category": "Showcase",
            "blocks": []
        }
    ]
} {% endschema %}