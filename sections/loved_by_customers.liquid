<div class="loved-by_grid" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.bg_color }};"><div class="loved-by_headline-tile"><picture class="loved-by_headline-picture">{% if section.settings.image_header_bild %}
{{ section.settings.image_header_bild | image_url: width: 800 | image_tag: loading: 'lazy', class: 'loved-by_headline-image' }}
{% else %}
<img src="{{ 'hero-apparel-3.svg' | asset_url }}" loading="lazy" alt="" class="loved-by_headline-image">
{% endif %}</picture><div class="loved-by_headline-overlay"></div><div class="loved-by_headline-content"><h2 class="loved-by_headline-title">
{{ section.settings.text_uberschrift }}
</h2><div class="loved-by_rating"><div class="loved-by_stars" aria-hidden="true"><svg viewbox="0 0 60 12" xmlns="http://www.w3.org/2000/svg"><g fill="currentColor"><polygon points="6,0 7.4,4.3 12,4.3 8.3,7 9.7,11.3 6,8.6 2.3,11.3 3.7,7 0,4.3 4.6,4.3"></polygon><polygon points="18,0 19.4,4.3 24,4.3 20.3,7 21.7,11.3 18,8.6 14.3,11.3 15.7,7 12,4.3 16.6,4.3"></polygon><polygon points="30,0 31.4,4.3 36,4.3 32.3,7 33.7,11.3 30,8.6 26.3,11.3 27.7,7 24,4.3 28.6,4.3"></polygon><polygon points="42,0 43.4,4.3 48,4.3 44.3,7 45.7,11.3 42,8.6 38.3,11.3 39.7,7 36,4.3 40.6,4.3"></polygon><polygon points="54,0 55.4,4.3 60,4.3 56.3,7 57.7,11.3 54,8.6 50.3,11.3 51.7,7 48,4.3 52.6,4.3"></polygon></g></svg></div><p class="loved-by_rating-text">
{{ section.settings.text_bewertungstext }}
</p></div></div></div><div class="loved-by_slider-wrapper"><div class="loved-by_swiper swiper"><div li-cf-theme-blocks="" class="swiper-wrapper loved-by_slides">
{% content_for 'blocks' %}
</div><button type="button" class="loved-by_arrow swiper-button-next" aria-label="Weiter"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_right' %}</div></button><button type="button" class="loved-by_arrow is-prev swiper-button-prev" aria-label="Zurück"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_left' %}</div></button></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Loved by Customers",
    "class": "section_loved-by",
    "blocks": [
        {
            "type": "foto"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "image_header_bild",
            "type": "image_picker",
            "label": "Header-Bild"
        },
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Loved by 350.000 Customers DACH"
        },
        {
            "id": "text_bewertungstext",
            "type": "text",
            "label": "Bewertungstext",
            "default": "4,9\/5.0 Sterne bei 80.000+ Bewertungen"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 60
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        }
    ],
    "presets": [
        {
            "name": "Loved by Customers",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "foto"
                }
            ]
        }
    ]
} {% endschema %}