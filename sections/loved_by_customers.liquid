<div class="loved-by_grid" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem; background-color: {{ section.settings.bg_color }};"><div class="loved-by_headline-tile">{% if section.settings.image_header_bild != blank %}    <picture li-if="section.settings.image_header_bild != blank" class="loved-by_headline-picture">
    {% if section.settings.image_header_bild %}
{{ section.settings.image_header_bild | image_url: width: 800 | image_tag: loading: 'lazy', class: 'loved-by_headline-image' }}
{% else %}
<img src="{{ 'hero-apparel-3.svg' | asset_url }}" loading="lazy" alt="" class="loved-by_headline-image">
{% endif %}    </picture>
{% endif %}<div class="loved-by_headline-overlay"></div><div class="loved-by_headline-content"><h2 class="loved-by_headline-title heading-style-h2">
{{ section.settings.text_uberschrift }}
</h2><div class="loved-by_rating"><div class="loved-by_stars" aria-hidden="true"><svg viewbox="0 0 60 12" xmlns="http://www.w3.org/2000/svg"><g fill="currentColor"><polygon points="6,0 7.4,4.3 12,4.3 8.3,7 9.7,11.3 6,8.6 2.3,11.3 3.7,7 0,4.3 4.6,4.3"></polygon><polygon points="18,0 19.4,4.3 24,4.3 20.3,7 21.7,11.3 18,8.6 14.3,11.3 15.7,7 12,4.3 16.6,4.3"></polygon><polygon points="30,0 31.4,4.3 36,4.3 32.3,7 33.7,11.3 30,8.6 26.3,11.3 27.7,7 24,4.3 28.6,4.3"></polygon><polygon points="42,0 43.4,4.3 48,4.3 44.3,7 45.7,11.3 42,8.6 38.3,11.3 39.7,7 36,4.3 40.6,4.3"></polygon><polygon points="54,0 55.4,4.3 60,4.3 56.3,7 57.7,11.3 54,8.6 50.3,11.3 51.7,7 48,4.3 52.6,4.3"></polygon></g></svg></div>{% if section.settings.text_bewertungstext != blank %}    <div class="li-guard" li-if="section.settings.text_bewertungstext != blank">
    <p class="loved-by_rating-text">
{{ section.settings.text_bewertungstext }}
</p>    </div>
{% endif %}</div></div></div><div class="loved-by_slider-wrapper"><div class="loved-by_swiper swiper"><div li-cf-theme-blocks="" class="swiper-wrapper loved-by_slides">
{% content_for 'blocks' %}
</div><button type="button" class="loved-by_arrow swiper-button-next" aria-label="Next"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_right' %}</div></button><button type="button" class="loved-by_arrow is-prev swiper-button-prev" aria-label="Previous"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_left' %}</div></button></div></div></div><div class="hide w-embed w-script"><script>document.addEventListener("DOMContentLoaded", function() {
  var ensure = function(cb) {
    if (typeof Swiper !== "undefined") return cb();
    if (window.__swiperLoading) return window.__swiperLoading.then(cb);
    var s = document.createElement("script"); s.src = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js";
    var link = document.createElement("link"); link.rel = "stylesheet"; link.href = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css";
    document.head.appendChild(link);
    window.__swiperLoading = new Promise(function(res) { s.onload = res; });
    document.head.appendChild(s);
    window.__swiperLoading.then(cb);
  };
  ensure(function() {
    document.querySelectorAll(".loved-by_swiper.swiper").forEach(function(el) {
      var root = el.closest(".section_loved-by") || document;
      var headlineTile = root.querySelector(".loved-by_headline-tile");
      var wrapper = el.querySelector(".swiper-wrapper");
      function buildSlider() {
        var isDesktop = window.innerWidth >= 992;
        if (el.swiper) el.swiper.destroy(true, true);
        var prev = wrapper.querySelector(".loved-by_slide-headline");
        if (prev) prev.remove();
        if (headlineTile) headlineTile.style.display = isDesktop ? "" : "none";
        if (!isDesktop && headlineTile) {
          var slide = document.createElement("div");
          slide.className = "swiper-slide loved-by_slide-headline";
          slide.innerHTML = headlineTile.innerHTML;
          wrapper.insertBefore(slide, wrapper.firstChild);
        }
        new Swiper(el, {
          slidesPerView: 1.4,
          spaceBetween: 4,
          breakpoints: { 480: { slidesPerView: 2.4 }, 768: { slidesPerView: 3.5 }, 992: { slidesPerView: 3, spaceBetween: 8 } },
          navigation: { nextEl: root.querySelector(".loved-by_arrow.swiper-button-next"), prevEl: root.querySelector(".loved-by_arrow.is-prev"), disabledClass: "swiper-button-disabled" }
        });
      }
      buildSlider();
      var t; window.addEventListener("resize", function() { clearTimeout(t); t = setTimeout(buildSlider, 250); });
    });
  });
});</script></div> {% schema %} {
    "tag": "section",
    "name": "Loved by Customers",
    "class": "section_loved-by",
    "blocks": [
        {
            "type": "foto"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "image_header_bild",
            "type": "image_picker",
            "label": "Header-Bild"
        },
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Loved by 350,000 customers"
        },
        {
            "id": "text_bewertungstext",
            "type": "text",
            "label": "Bewertungstext",
            "default": "4.9\/5.0 stars from 80,000+ reviews"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 4
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 4
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        }
    ],
    "presets": [
        {
            "name": "Loved by Customers",
            "category": "Listing",
            "blocks": [
                {
                    "type": "foto"
                }
            ]
        }
    ]
} {% endschema %}