<div class="padding-global padding-section-medium"><div class="container-large"><div class="owner_grid"><div class="default-flex-small"><h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2><div class="text-size-medium"> {{ section.settings.textarea_text }} </div></div><div class="owner_main-component"><div li-cf-theme-blocks="" class="owner_text-wrapper">
{% content_for 'blocks' %}
</div><div class="default-bg-wrapper">{% if section.settings.image_image %}
{{ section.settings.image_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'default-bg-image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="default-bg-image">
{% endif %}</div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Owner Spotlight",
    "class": "section_owner",
    "blocks": [
        {
            "type": "zitat"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Inhabergef\u00fchrt seit Tag eins"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "Unsere Eigent\u00fcmerstruktur garantiert langfristige Entscheidungen, Verantwortung und pers\u00f6nliche N\u00e4he zu unseren Partnern."
        },
        {
            "id": "image_image",
            "type": "image_picker",
            "label": "Image"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        }
    ],
    "presets": [
        {
            "name": "Owner Spotlight",
            "category": "Showcase",
            "blocks": [
                {
                    "type": "zitat"
                }
            ]
        }
    ]
} {% endschema %}