<div class="padding-global padding-section-medium"><div class="container-large"><div class="owner_grid"><div class="default-flex-small"><h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2><div class="text-size-medium"> {{ section.settings.textarea_text }} </div></div><div class="owner_main-component"><div li-cf-theme-blocks="" class="owner_text-wrapper">
{% content_for 'blocks' %}
</div>{% if section.settings.image_image != blank %}    <div li-if="section.settings.image_image != blank" class="default-bg-wrapper">
    {% if section.settings.image_image %}
{{ section.settings.image_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'default-bg-image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="default-bg-image">
{% endif %}    </div>
{% endif %}</div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Owner Spotlight",
    "class": "section_owner",
    "blocks": [
        {
            "type": "zitat"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Owner-led from day one"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "Our ownership structure guarantees long-term decisions, accountability and a personal connection with our partners."
        },
        {
            "id": "image_image",
            "type": "image_picker",
            "label": "Image"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 5
        }
    ],
    "presets": [
        {
            "name": "Owner Spotlight",
            "category": "Showcase",
            "blocks": [
                {
                    "type": "zitat"
                }
            ]
        }
    ]
} {% endschema %}