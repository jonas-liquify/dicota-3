{% if section.settings.image_background != blank %}    <span class="li-guard" li-if="section.settings.image_background != blank">
    {% if section.settings.image_background %}
{{ section.settings.image_background | image_url: width: 2000 | image_tag: loading: 'lazy', class: 'password_bg-image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="password_bg-image">
{% endif %}    </span>
{% endif %}<div class="password_overlay"></div><div class="password_content">{% if section.settings.image_logo != blank %}    <span class="li-guard" li-if="section.settings.image_logo != blank">
    <div class="password_logo-box">{% if section.settings.image_logo %}
{{ section.settings.image_logo | image_url: width: 300 | image_tag: loading: 'lazy', class: 'password_logo' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="password_logo">
{% endif %}</div>    </span>
{% endif %}<h1 class="heading-style-h2 text-align-center password_heading">
{{ section.settings.text_heading }}
</h1>{% if section.settings.textarea_text != blank %}    <div class="li-guard" li-if="section.settings.textarea_text != blank">
    <div class="text-size-medium text-align-center password_text"> {{ section.settings.richtext_text }} </div>    </div>
{% endif %}<div x-data="{open: false}" class="password_toggle-wrapper"><button type="button" x-on:click="open = !open" x-bind:aria-expanded="open ? 'true' : 'false'" class="password_toggle"><span>
{{ section.settings.text_toggle_text }}
</span><div class="password_toggle-icon" x-bind:class="open ? 'is-open' : ''">{% render 'icon_chevron_down' %}</div></button><div class="password_form-body" x-bind:class="open ? 'is-open' : ''"><div class="password_form-body-content"><div class="login_form w-form">{% form 'storefront_password', class: 'form_form' %}
<div class="form_field-wrapper"><input class="form_input w-input" maxlength="256" name="password" data-name="password" placeholder="Password" type="password" id="password" required=""></div><div class="button-group"><input type="submit" data-wait="" class="button max-width-full w-button" value="Login"></div>{% endform %}<div class="w-form-done"><div li-object="'general.form.success' | t">{{ 'general.form.success' | t }}</div></div><div class="w-form-fail"><div li-object="'general.form.error' | t">{{ 'general.form.error' | t }}</div></div></div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Password",
    "class": "section_under-construction",
    "settings": [
        {
            "id": "image_background",
            "type": "image_picker",
            "label": "Background"
        },
        {
            "id": "image_logo",
            "type": "image_picker",
            "label": "Logo"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "We'll be back online soon"
        },
        {
            "id": "richtext_text",
            "type": "richtext",
            "label": "Text",
            "default": "<p>We're working on something new. Thanks for your patience \u2014 see you again shortly.<\/p>"
        },
        {
            "id": "text_toggle_text",
            "type": "text",
            "label": "Toggle Text",
            "default": "Enter password"
        }
    ],
    "presets": [
        {
            "name": "Password",
            "category": "Liquify",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "password"
        ]
    }
} {% endschema %}