<div x-show="!searchQuery || searchQuery.length === 0" class="nav_search-empty-grid"><div class="nav_search-empty-col"><div class="nav_search-empty-header"><div class="text-style-subline">Popular searches</div></div><div class="nav_search-pills">{% for block in section.blocks %}
    {% if block.type == "nav-search-suggestion" %}
                    <div li-block="Nav Search Suggestion" style="display:contents">
                                    <a href="{{ block.settings.url_link }}" class="nav_search-pill-item"> <span>{{ block.settings.text_text }}</span> </a>
                            </div>
            {% endif %}
{% endfor %}</div></div><div class="nav_search-empty-col"><div class="nav_search-empty-header"><div class="text-style-subline">Recently viewed</div><a href="#" class="text-style-link">Clear</a></div><div class="nav_search-recent">{% for product in section.settings.collection_search_recent.products limit: section.settings.collection_search_recent_limit %}
<div class="nav_search-recent-item">
    <a li-object:href="product.url" href="{{ product.url }}" class="nav_search-recent-link"><img li-object:src="product.featured_image | image_url: width: 400" li-object:alt="product.featured_image.alt" src="{{ product.featured_image | image_url: width: 400 }}" loading="lazy" alt="{{ product.featured_image.alt }}" class="nav_search-recent-image"></a>
</div>
{% endfor %}</div></div></div><div x-cloak="" x-show="searchQuery && searchQuery.length > 0" class="nav_search-results-grid"><div class="nav_search-empty-col"><div class="text-style-subline">Suggestions</div><ul role="list" class="nav_search-suggestion-list w-list-unstyled"><template x-for="s in suggestions" :key="(s.text || s.title)"></template><li x-show="!loading && suggestions.length === 0" class="nav_search-suggestion-item"><span class="nav_search-suggestion-link" style="opacity:.55">No suggestions</span></li></ul></div><div class="nav_search-empty-col"><ul role="list" class="nav_search-product-grid w-list-unstyled"><template x-for="p in results" :key="p.id"></template><li x-show="loading" role="listitem" class="nav_search-product-status">Searching…</li><li x-show="!loading && results.length === 0" role="listitem" class="nav_search-product-status">No products found.</li></ul><a x-bind:href="'/search?q=' + encodeURIComponent(searchQuery)" href="/search" class="button is-outline nav_search-results-cta w-button"><span>View all products</span></a></div></div> {% schema %} {
    "tag": "div",
    "name": "predictive_search",
    "class": "nav_search-overlay-states",
    "blocks": [
        {
            "name": "Nav Search Suggestion",
            "type": "nav-search-suggestion",
            "settings": [
                {
                    "id": "url_link",
                    "type": "url",
                    "label": "Link"
                },
                {
                    "id": "text_text",
                    "type": "text",
                    "label": "Text",
                    "default": "Backpacks"
                }
            ]
        }
    ],
    "settings": [
        {
            "id": "collection_search_recent",
            "type": "collection",
            "label": "Search - Recent"
        },
        {
            "type": "range",
            "id": "collection_search_recent_limit",
            "min": 1,
            "max": 99,
            "step": 1,
            "label": "Limit: Search - Recent",
            "default": 6
        }
    ],
    "presets": [
        {
            "name": "predictive_search",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "nav-search-suggestion"
                }
            ]
        }
    ]
} {% endschema %}