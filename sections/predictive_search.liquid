<div x-show="!searchQuery || searchQuery.length === 0" class="nav_search-empty-grid"><div class="nav_search-empty-col"><div class="nav_search-empty-header"><div li-object="'search.popular' | t" class="text-style-subline">{{ 'search.popular' | t }}</div></div><div class="nav_search-pills">{% for block in section.blocks %}
    {% if block.type == "nav-search-suggestion" %}
                    <div li-block="Nav Search Suggestion" style="display:contents">
                                    <a href="{{ block.settings.url_link }}" class="nav_search-pill-item"> <span>{{ block.settings.text_text }}</span> </a>
                            </div>
            {% endif %}
{% endfor %}</div></div><div class="nav_search-empty-col"><div class="nav_search-empty-header"><div li-object="'search.recently_viewed' | t" class="text-style-subline">{{ 'search.recently_viewed' | t }}</div><a li-object="'general.clear' | t" href="#" class="text-style-link">{{ 'general.clear' | t }}</a></div><div class="nav_search-recent">{% for product in section.settings.collection_search_recent.products limit: section.settings.collection_search_recent_limit %}
<div class="nav_search-recent-item">
    <a li-object:href="product.url" href="{{ product.url }}" class="nav_search-recent-link"><img li-object:src="product.featured_image | image_url: width: 400" li-object:alt="product.featured_image.alt" src="{{ product.featured_image | image_url: width: 400 }}" loading="lazy" alt="{{ product.featured_image.alt }}" class="nav_search-recent-image"></a>
</div>
{% endfor %}</div></div></div><div x-cloak="" x-show="loading" class="nav_search-results-loading"><span li-object="'search.searching' | t">{{ 'search.searching' | t }}</span></div><div x-cloak="" x-show="searchQuery && searchQuery.length > 0" data-ps-results="" class="nav_search-results-grid"><div class="nav_search-empty-col"><div li-object="'search.suggestions' | t" class="text-style-subline">{{ 'search.suggestions' | t }}</div><ul role="list" class="nav_search-suggestion-list w-list-unstyled">{% for suggestion in predictive_search.resources.results.queries %}    <li li-for="suggestion in predictive_search.resources.results.queries" class="nav_search-suggestion-item">
                                    <a li-object:href="suggestion.url" href="{{ suggestion.url }}" class="nav_search-suggestion-link"><span li-object="suggestion.text">{{ suggestion.text }}</span></a>
                        </li>
{% endfor %}{% if predictive_search.performed and predictive_search.resources.results.queries == blank %}    <li li-if="predictive_search.performed and predictive_search.resources.results.queries == blank" class="nav_search-suggestion-item">
    <span li-object="'search.no_suggestions' | t" class="nav_search-suggestion-link" style="opacity:.55">{{ 'search.no_suggestions' | t }}</span>    </li>
{% endif %}</ul></div><div class="nav_search-empty-col"><ul role="list" class="nav_search-product-grid w-list-unstyled">{% for product in predictive_search.resources.results.products %}    <li li-for="product in predictive_search.resources.results.products" role="listitem">
                                    <a li-object:href="product.url" href="{{ product.url }}" class="nav_search-product-link"><div class="nav_search-product-image-wrap"><img li-object:src="product.featured_image | image_url: width: 400" li-object:alt="product.title" src="{{ product.featured_image | image_url: width: 400 }}" loading="lazy" alt="{{ product.title }}" class="nav_search-product-image"></div><div class="nav_search-product-info"><span li-object="product.title" class="nav_search-product-title">{{ product.title }}</span>{% if product.metafields.sl_ART.extra_CATEGORY != blank %}    <span class="li-guard" li-if="product.metafields.sl_ART.extra_CATEGORY != blank">
    <span li-object="product.metafields.sl_ART.extra_CATEGORY" class="nav_search-product-category">{{ product.metafields.sl_ART.extra_CATEGORY }}</span>    </span>
{% endif %}<span li-object="product.price | money" class="nav_search-product-price">{{ product.price | money }}</span></div></a>
                        </li>
{% endfor %}{% if predictive_search.performed and predictive_search.resources.results.products == blank %}    <li li-if="predictive_search.performed and predictive_search.resources.results.products == blank" role="listitem" class="nav_search-product-status">
    <span li-object="'collection.no_products' | t">{{ 'collection.no_products' | t }}</span>    </li>
{% endif %}</ul><a href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}" class="button is-outline nav_search-results-cta w-button"><span li-object="'search.view_all' | t">{{ 'search.view_all' | t }}</span></a></div></div> {% schema %} {
    "tag": "div",
    "name": "predictive_search",
    "class": "nav_search-overlay-states",
    "blocks": [
        {
            "name": "Nav Search Suggestion",
            "type": "nav-search-suggestion",
            "settings": [
                {
                    "id": "url_link",
                    "type": "url",
                    "label": "Link"
                },
                {
                    "id": "text_text",
                    "type": "text",
                    "label": "Text",
                    "default": "Backpacks"
                }
            ]
        }
    ],
    "settings": [
        {
            "id": "collection_search_recent",
            "type": "collection",
            "label": "Search - Recent"
        },
        {
            "type": "range",
            "id": "collection_search_recent_limit",
            "min": 1,
            "max": 99,
            "step": 1,
            "label": "Limit: Search - Recent",
            "default": 6
        }
    ],
    "presets": [
        {
            "name": "predictive_search",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "nav-search-suggestion"
                }
            ]
        }
    ]
} {% endschema %}