{% if predictive_search.performed %}    <div li-if="predictive_search.performed" class="nav_search-results-grid">
    {% if predictive_search.resources.queries.size > 0 or predictive_search.resources.collections.size > 0 %}    <div li-if="predictive_search.resources.queries.size > 0 or predictive_search.resources.collections.size > 0" class="nav_search-results-suggestions">
    <div class="text-style-subline">
{{ section.settings.text_suggestions_label }}
</div><ul role="list" class="nav_search-suggestion-list w-list-unstyled">{% for query in predictive_search.resources.queries %}    <li li-for="query in predictive_search.resources.queries" class="nav_search-suggestion-item">
                                    <a li-object:href="query.url" href="{{ query.url }}" class="nav_search-suggestion-link"><div li-object="query.styled_text">{{ query.styled_text }}</div></a>
                        </li>
{% endfor %}{% for collection in predictive_search.resources.collections %}    <li li-for="collection in predictive_search.resources.collections" class="nav_search-suggestion-item">
                                    <a li-object:href="collection.url" href="{{ collection.url }}" class="nav_search-suggestion-link"><div li-object="collection.title">{{ collection.title }}</div></a>
                        </li>
{% endfor %}</ul>    </div>
{% endif %}{% if predictive_search.resources.products.size > 0 %}    <div li-if="predictive_search.resources.products.size > 0" class="nav_search-results-products">
    <ul role="list" class="nav_search-product-grid w-list-unstyled">{% for product in predictive_search.resources.products %}    <li li-for="product in predictive_search.resources.products" class="nav_search-product-item">
                                    <a li-object:href="product.url" href="{{ product.url }}" class="nav_search-product-link"><div class="nav_search-product-image-wrap"><img li-object:src="product.featured_media | image_url: width: 400" li-object:alt="product.featured_image.alt" src="{{ product.featured_media | image_url: width: 400 }}" loading="lazy" alt="{{ product.featured_image.alt }}" class="nav_search-product-image"></div><div class="nav_search-product-info"><div li-object="product.title" class="nav_search-product-title text-size-regular text-weight-bold">{{ product.title }}</div>{% if product.vendor %}    <div li-if="product.vendor" li-object="product.vendor" class="nav_search-product-brand text-size-small text-style-muted">
    Brand    </div>
{% endif %}<div li-object="product.price | money" class="nav_search-product-price text-size-small">{{ product.price | money }}</div></div></a>
                        </li>
{% endfor %}</ul><a href="/search?q={{ predictive_search.terms }}" class="button is-outline nav_search-results-cta w-button"><span>Alle Produkte anzeigen (<span li-object="predictive_search.resources.products.size">{{ predictive_search.resources.products.size }}</span>)</span></a>    </div>
{% endif %}    </div>
{% endif %}{% if predictive_search.performed and predictive_search.resources.products.size == 0 %}    <div li-if="predictive_search.performed and predictive_search.resources.products.size == 0" class="nav_search-no-results">
    <div class="text-style-muted">Keine Treffer für "<span li-object="predictive_search.terms">{{ predictive_search.terms }}</span>"</div>    </div>
{% endif %} {% schema %} {
    "tag": "div",
    "name": "predictive_search",
    "class": "nav_search-results-section",
    "settings": [
        {
            "id": "text_suggestions_label",
            "type": "text",
            "label": "Suggestions Label",
            "default": "Vorschl\u00e4ge"
        }
    ],
    "presets": [
        {
            "name": "predictive_search",
            "category": "Liquify",
            "blocks": []
        }
    ]
} {% endschema %}