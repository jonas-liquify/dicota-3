<div x-show="!searchQuery || searchQuery.length === 0" class="nav_search-empty-grid"><div class="nav_search-empty-col"><div class="nav_search-empty-header"><div li-object="'search.popular' | t" class="text-style-subline">{{ 'search.popular' | t }}</div></div>{% content_for "block", type: "search-suggestions", id: "search-suggestions" %}</div><div class="nav_search-empty-col"><div class="nav_search-empty-header"><div li-object="'search.recently_viewed' | t" class="text-style-subline">{{ 'search.recently_viewed' | t }}</div><a li-object="'general.clear' | t" href="#" class="text-style-link">{{ 'general.clear' | t }}</a></div><div class="nav_search-recent">{% for product in collections[section.settings.text_search_recent].products limit: section.settings.search_recent_limit %}    <div li-for="product in collections[section.settings.text_search_recent].products limit: section.settings.search_recent_limit" class="nav_search-recent-item">
                                    <a li-object:href="product.url" href="{{ product.url }}" class="nav_search-recent-link"><img li-object:src="product.featured_image | image_url: width: 400" li-object:alt="product.featured_image.alt" src="{{ product.featured_image | image_url: width: 400 }}" loading="lazy" alt="{{ product.featured_image.alt }}" class="nav_search-recent-image"></a>
                        </div>
{% endfor %}</div></div></div><div x-cloak="" x-show="loading" class="nav_search-results-loading"><span li-object="'search.searching' | t">{{ 'search.searching' | t }}</span></div><div x-cloak="" x-show="searchQuery && searchQuery.length > 0" data-ps-results="" class="nav_search-results-grid"><div class="nav_search-empty-col"><div li-object="'search.suggestions' | t" class="text-style-subline">{{ 'search.suggestions' | t }}</div><ul role="list" class="nav_search-suggestion-list w-list-unstyled"></ul><div class="nav_search-articles w-embed">{% if predictive_search.resources.articles.size > 0 %}<div class="nav_search-article-head">{{ 'search.articles' | t }}</div><ul role="list" class="nav_search-article-list">{% for article in predictive_search.resources.articles %}<li role="listitem" class="nav_search-article-item"><a href="{{ article.url }}" class="nav_search-article-link"><div class="nav_search-article-media">{% if article.image != blank %}<img src="{{ article.image | image_url: width: 200 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy" class="nav_search-article-image">{% endif %}</div><div class="nav_search-article-info"><span class="nav_search-article-title">{{ article.title }}</span><span class="nav_search-article-date">{{ article.published_at | date: '%d.%m.%Y' }}</span></div></a></li>{% endfor %}</ul>{% endif %}</div></div><div class="nav_search-empty-col"><div class="w-embed"><ul role="list" class="nav_search-product-grid w-list-unstyled">{% for product in predictive_search.resources.products %}<li role="listitem"><a href="{{ product.url }}" class="nav_search-product-link"><div class="nav_search-product-image-wrap"><img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy" class="nav_search-product-image"></div><div class="nav_search-product-info"><span class="nav_search-product-title">{{ product.title }}</span>{% assign ps_tagline = product.metafields.custom.filter_image_set.value.product_tagline | default: product.metafields.custom.product_tagline | default: product.metafields.sl_ART.extra_CATEGORY %}{% if ps_tagline != blank %}<span class="nav_search-product-category">{{ ps_tagline }}</span>{% endif %}<span class="nav_search-product-price">{{ product.price | money }}</span></div></a></li>{% endfor %}{% if predictive_search.performed and predictive_search.resources.products == blank %}<li role="listitem" class="nav_search-product-status">{{ 'collection.no_products' | t }}</li>{% endif %}</ul></div><a href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}" class="button is-outline nav_search-results-cta w-button"><span li-object="'search.view_all' | t">{{ 'search.view_all' | t }}</span></a></div></div> {% schema %} {
    "tag": "div",
    "name": "predictive_search",
    "class": "nav_search-overlay-states",
    "blocks": [
        {
            "type": "nav-search-suggestion"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "type": "header",
            "content": "Suche \u2014 Zuletzt angesehen"
        },
        {
            "type": "text",
            "id": "text_search_recent",
            "label": "Kollektion (Handle)",
            "info": "Handle der Kollektion f\u00fcr die Zeile \u201eZuletzt angesehen\u201c im Suchoverlay, z.\u202fB. bestseller. Leer = Zeile bleibt leer. Bewusst ein Textfeld: der eine Kollektions-Picker, den Shopify pro Section erlaubt, geh\u00f6rt jetzt den Mini-Cart-Empfehlungen."
        },
        {
            "type": "range",
            "id": "search_recent_limit",
            "min": 1,
            "max": 12,
            "step": 1,
            "label": "Anzahl",
            "default": 6
        }
    ],
    "presets": [
        {
            "name": "predictive_search",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "search-suggestions",
                    "static": true,
                    "id": "search-suggestions",
                    "blocks": [
                        {
                            "type": "nav-search-suggestion"
                        }
                    ]
                }
            ]
        }
    ]
} {% endschema %}