<div class="padding-global" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;background-color:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};"><div class="container-large"><nav class="product-breadcrumb_nav" aria-label="Breadcrumb"><a href="{{ routes.root_url }}" li-object:href="routes.root_url" class="product-breadcrumb_link">Home</a><span class="product-breadcrumb_sep">›</span><a href="/collections" class="product-breadcrumb_link">Produkte</a><span class="product-breadcrumb_sep">›</span><span li-object="collection.title" class="product-breadcrumb_current">{{ collection.title }}</span></nav></div></div> {% schema %} {
    "tag": "section",
    "name": "Product Breadcrumb",
    "class": "section_product-breadcrumb",
    "settings": [
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 40,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 8
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 40,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 8
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#0f0f0f"
        }
    ],
    "presets": [
        {
            "name": "Product Breadcrumb",
            "category": "Liquify",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}