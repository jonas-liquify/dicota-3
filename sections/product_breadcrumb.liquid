<div class="padding-global" style="padding-top:{{ section.settings.padding_top }}rem;padding-bottom:{{ section.settings.padding_bottom }}rem;background-color:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};"><div class="container-large"><nav class="product-breadcrumb_nav" aria-label="Breadcrumb"><a href="{{ routes.root_url }}" li-object:href="routes.root_url" class="product-breadcrumb_link"><span>
{{ section.settings.text_home_label }}
</span></a>{% if template.name == 'product' %}    <span li-if="template.name == 'product'">
    <span class="product-breadcrumb_sep">›</span>{% if collection.url != blank %}    <span li-if="collection.url != blank">
    <a li-object:href="collection.url" href="{{ collection.url }}" class="product-breadcrumb_link"><span li-object="collection.metafields.custom.collection_name | default: collection.title">{{ collection.metafields.custom.collection_name | default: collection.title }}</span></a><span class="product-breadcrumb_sep">›</span>    </span>
{% endif %}<span class="product-breadcrumb_current" li-object="product.title">{{ product.title }}</span>    </span>
{% endif %}{% if template.name == 'collection' %}    <span li-if="template.name == 'collection'">
    <span class="product-breadcrumb_sep">›</span><a href="{{ routes.collections_url }}" li-object:href="routes.collections_url" class="product-breadcrumb_link"><span>
{{ section.settings.text_kollektionen_label }}
</span></a><span class="product-breadcrumb_sep">›</span><span class="product-breadcrumb_current" li-object="collection.metafields.custom.collection_name | default: collection.title">{{ collection.metafields.custom.collection_name | default: collection.title }}</span>    </span>
{% endif %}{% if template.name == 'list-collections' %}    <span li-if="template.name == 'list-collections'">
    <span class="product-breadcrumb_sep">›</span><span class="product-breadcrumb_current"><span>
{{ section.settings.text_kollektionen_label }}
</span></span>    </span>
{% endif %}{% if template.name == 'article' %}    <span li-if="template.name == 'article'">
    <span class="product-breadcrumb_sep">›</span><a li-object:href="blog.url" href="{{ blog.url }}" class="product-breadcrumb_link"><span li-object="blog.title">{{ blog.title }}</span></a><span class="product-breadcrumb_sep">›</span><span class="product-breadcrumb_current" li-object="article.title">{{ article.title }}</span>    </span>
{% endif %}{% if template.name == 'blog' %}    <span li-if="template.name == 'blog'">
    <span class="product-breadcrumb_sep">›</span><span class="product-breadcrumb_current" li-object="blog.title">{{ blog.title }}</span>    </span>
{% endif %}{% if template.name == 'page' %}    <span li-if="template.name == 'page'">
    <span class="product-breadcrumb_sep">›</span><span class="product-breadcrumb_current" li-object="page.title">{{ page.title }}</span>    </span>
{% endif %}{% if template.name == 'search' %}    <span li-if="template.name == 'search'">
    <span class="product-breadcrumb_sep">›</span><span class="product-breadcrumb_current"><span>
{{ section.settings.text_suche_label }}
</span></span>    </span>
{% endif %}{% if template.name == 'cart' %}    <span li-if="template.name == 'cart'">
    <span class="product-breadcrumb_sep">›</span><span class="product-breadcrumb_current"><span>
{{ section.settings.text_warenkorb_label }}
</span></span>    </span>
{% endif %}{% if template.name == '404' %}    <span li-if="template.name == '404'">
    <span class="product-breadcrumb_sep">›</span><span class="product-breadcrumb_current"><span>
{{ section.settings.text_404_label }}
</span></span>    </span>
{% endif %}</nav></div></div> {% schema %} {
    "tag": "section",
    "name": "Product Breadcrumb",
    "class": "section_product-breadcrumb",
    "settings": [
        {
            "id": "text_home_label",
            "type": "text",
            "label": "Home-Label",
            "default": "Home"
        },
        {
            "id": "text_kollektionen_label",
            "type": "text",
            "label": "Kollektionen-Label",
            "default": "Collections"
        },
        {
            "id": "text_suche_label",
            "type": "text",
            "label": "Suche-Label",
            "default": "Search"
        },
        {
            "id": "text_warenkorb_label",
            "type": "text",
            "label": "Warenkorb-Label",
            "default": "Cart"
        },
        {
            "id": "text_404_label",
            "type": "text",
            "label": "404-Label",
            "default": "Page not found"
        },
        {
            "type": "header",
            "content": "Beschriftung"
        },
        {
            "type": "paragraph",
            "content": "Die Breadcrumbs werden je nach Template (Produkt, Kollektion, Blog, Artikel, Statische Seite, Suche, Warenkorb, 404) automatisch generiert. Die Texte hier sind nur Fallback-Labels f\u00fcr Home \/ Kollektionen \/ Suche \/ Warenkorb \/ 404."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 0.5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 0.5
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#0f0f0f"
        }
    ],
    "presets": [
        {
            "name": "Product Breadcrumb",
            "category": "Global",
            "blocks": []
        }
    ]
} {% endschema %}