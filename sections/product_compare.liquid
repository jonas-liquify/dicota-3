<div class="padding-global padding-section-medium" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"><div class="container-large"><div class="compare_head"><div class="compare_head-text"><h1 class="heading-style-h2">
{{ section.settings.text_heading }}
</h1>{% if section.settings.text_subline != blank %}    <div class="li-guard" li-if="section.settings.text_subline != blank">
    <p class="text-size-medium">
{{ section.settings.text_subline }}
</p>    </div>
{% endif %}</div><div class="compare_head-actions"><label class="compare_diff-toggle"><input type="checkbox" data-compare-diffonly=""><span li-object="'products.compare_diff_only' | t">{{ 'products.compare_diff_only' | t }}</span></label><button type="button" class="button is-secondary compare_print" data-compare-print=""><span li-object="'products.compare_print' | t">{{ 'products.compare_print' | t }}</span></button></div></div><div class="compare_root" data-compare-root="" data-label-atc="{{ 'products.add_to_cart' | t }}" data-label-unavailable="{{ 'products.out_of_stock' | t }}"><div class="compare_empty" data-compare-empty="" hidden=""><p li-object="'products.compare_empty' | t" class="text-size-medium">{{ 'products.compare_empty' | t }}</p>{% if section.settings.url_weiter_shoppen_link != blank %}    <span class="li-guard" li-if="section.settings.url_weiter_shoppen_link != blank">
    <a href="{{ section.settings.url_weiter_shoppen_link }}" class="button"> <span>{{ section.settings.text_weiter_shoppen_text }}</span> </a>    </span>
{% endif %}</div><div class="compare_grid" data-compare-grid=""></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Product Compare",
    "class": "section_compare",
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Produktvergleich"
        },
        {
            "id": "text_subline",
            "type": "text",
            "label": "Subline",
            "default": "Bis zu drei Produkte nebeneinander."
        },
        {
            "id": "url_weiter_shoppen_link",
            "type": "url",
            "label": "Weiter shoppen Link"
        },
        {
            "id": "text_weiter_shoppen_text",
            "type": "text",
            "label": "Weiter shoppen Text",
            "default": "Produkte entdecken"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 2.5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 5
        }
    ],
    "presets": [
        {
            "name": "Product Compare",
            "category": "Content",
            "blocks": []
        }
    ]
} {% endschema %}