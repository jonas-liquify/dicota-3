<div class="padding-global" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.bg_color }};"><div class="container-large"><h2 class="product-family_headline heading-style-h2">
{{ section.settings.text_uberschrift }}
</h2><div class="product-family_img-wrap" li-for:inside="image in product.images">
        {% for image in product.images %}                            <div li-if:inside="image.src contains '_30'" inside="1">
        {% if image.src contains '_30' %}
            <img li-object:src="image | image_url: width: 1600" li-object:alt="image.alt" src="{{ image | image_url: width: 1600 }}" alt="{{ image.alt }}" loading="lazy" class="product-family_img">        {% endif %}
    </div>
                    {% endfor %}    </div></div></div> {% schema %} {
    "tag": "section",
    "name": "Product Family",
    "class": "section_product-family",
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Die Produktfamilie auf einen Blick"
        },
        {
            "type": "paragraph",
            "content": "Das \u00dcbersichtsbild wird automatisch aus den Produkt-Bildern gezogen: das Bild dessen Dateiname '_30' enth\u00e4lt (z.B. D32163-RPET_30.webp) wird hier als Family-Shot gerendert. Damit die Sektion was anzeigt, lade ein Produktbild mit '_30' im Dateinamen hoch."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#f5f5f5"
        }
    ],
    "presets": [
        {
            "name": "Product Family",
            "category": "Product",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}