<div class="padding-global" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"><div class="container-large"><h2 class="product-faq_headline heading-style-h2">
{{ section.settings.text_titel }}
</h2><div class="product-faq_list"><div class="product-faq_items" li-for:inside="faq in section.settings.faqs">
        {% for faq in section.settings.faqs %}                            <div class="product-faq_item" x-data="{open:false}"><button class="product-faq_question" x-on:click="open=!open" :aria-expanded="open"><span li-object="faq.frage" class="product-faq_question-text">{{ faq.frage }}</span><span class="product-faq_icon" :class="{'is-open':open}">{% render 'icon_chevron_down' %}</span></button><div class="product-faq_answer" x-show="open" x-collapse=""><p li-object="faq.antwort" class="product-faq_answer-text">{{ faq.antwort }}</p></div></div>
                    {% endfor %}    </div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Product FAQ",
    "class": "section_product-faq",
    "settings": [
        {
            "id": "text_titel",
            "type": "text",
            "label": "Titel",
            "default": "FAQ"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#000000"
        },
        {
            "type": "header",
            "content": "FAQ-Auswahl"
        },
        {
            "type": "metaobject_list",
            "id": "faqs",
            "label": "FAQs",
            "metaobject_type": "faq",
            "limit": 50,
            "info": "W\u00e4hle manuell die FAQ-Eintr\u00e4ge aus dem Metaobjekt \"faq\". Jeder Eintrag braucht die Felder frage (single_line_text) und antwort (multi_line_text oder rich_text)."
        },
        {
            "type": "paragraph",
            "content": "Vorgehen: Zuerst in Shopify Admin \u2192 Einstellungen \u2192 Benutzerdefinierte Daten \u2192 Metaobjekte ein Metaobjekt vom Typ \"faq\" mit den Feldern frage + antwort anlegen, dann hier die produktspezifischen Eintr\u00e4ge ausw\u00e4hlen. Reihenfolge im Theme-Editor wird zur Darstellungs-Reihenfolge."
        }
    ],
    "presets": [
        {
            "name": "Product FAQ",
            "category": "Product",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}