<div class="padding-global" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"><div class="container-large">{% if product.metafields.custom.faqs_category != blank %}    <div li-if="product.metafields.custom.faqs_category != blank">
    <h2 class="product-faq_headline heading-style-h2">
{{ section.settings.text_titel }}
</h2><div class="product-faq_list"><div class="product-faq_items" li-for:inside="faq in product.metafields.custom.faqs_category.value.faq.value">
        {% for faq in product.metafields.custom.faqs_category.value.faq.value %}                            <div class="product-faq_item" x-data="{open:false}"><button class="product-faq_question" x-on:click="open=!open" x-bind:aria-expanded="open"><span li-object="faq.frage" class="product-faq_question-text">{{ faq.frage }}</span><span class="product-faq_icon" x-bind:class="{'is-open':open}">{% render 'icon_chevron_down' %}</span></button><div class="product-faq_answer" x-show="open" x-collapse=""><div li-object="faq.antwort" class="product-faq_answer-text text-rich-text w-richtext">{{ faq.antwort }}</div></div></div>
                    {% endfor %}    </div></div>    </div>
{% endif %}</div></div> {% schema %} {
    "tag": "section",
    "name": "Product FAQ",
    "class": "section_product-faq",
    "settings": [
        {
            "id": "text_titel",
            "type": "text",
            "label": "Titel",
            "default": "FAQ"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#000000"
        },
        {
            "type": "paragraph",
            "content": "Die FAQs werden automatisch aus dem Produkt-Metafeld custom.faqs_category geladen (Referenz auf ein Metaobjekt vom Typ faqs_category). Dessen Feld faq (Liste von faqs-Eintraegen mit den Feldern frage + antwort) liefert Fragen und Antworten."
        }
    ],
    "presets": [
        {
            "name": "Product FAQ",
            "category": "Product",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}