<div class="padding-global" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem; background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"><div class="container-large">{% if faq_items != blank %}    <div li-if="faq_items != blank">
    <h2 class="product-faq_headline heading-style-h2">
{{ section.settings.text_titel }}
</h2><div class="product-faq_list">{% if section.settings.faq_set != blank %}    <div li-if="section.settings.faq_set != blank">
    <div class="faq_component" li-for:inside="faq in section.settings.faq_set.wich_faq.value">
        {% for faq in section.settings.faq_set.wich_faq.value %}                            <div x-data="{open: false}" class="faq_item background-color-alternate"><div tabindex="0" role="button" x-on:click="open=!open" x-bind:aria-expanded="open?'true':'false'" class="faq_header"><div li-object="faq.question" class="text-size-medium text-weight-medium">{{ faq.question }}</div><div class="faq_icon-outer"><div class="faq_icon-line"></div><div x-bind:class="open?'is-open':''" class="faq_icon-line is-rotating"></div></div></div><div x-bind:class="open?'is-open':''" class="faq_body"><div class="faq_body-content"><div li-object="faq.faq_answer | metafield_tag" class="text-size-regular">{{ faq.faq_answer | metafield_tag }}</div></div></div></div>
                    {% endfor %}    </div>    </div>
{% endif %}{% if section.settings.faq_set == blank %}    <div li-if="section.settings.faq_set == blank">
    <div class="faq_component" li-for:inside="faq in section.settings.faq_entries">
        {% for faq in section.settings.faq_entries %}                            <div x-data="{open: false}" class="faq_item background-color-alternate"><div tabindex="0" role="button" x-on:click="open=!open" x-bind:aria-expanded="open?'true':'false'" class="faq_header"><div li-object="faq.question" class="text-size-medium text-weight-medium">{{ faq.question }}</div><div class="faq_icon-outer"><div class="faq_icon-line"></div><div x-bind:class="open?'is-open':''" class="faq_icon-line is-rotating"></div></div></div><div x-bind:class="open?'is-open':''" class="faq_body"><div class="faq_body-content"><div li-object="faq.faq_answer | metafield_tag" class="text-size-regular">{{ faq.faq_answer | metafield_tag }}</div></div></div></div>
                    {% endfor %}    </div>    </div>
{% endif %}</div>    </div>
{% endif %}</div></div> {% schema %} {
    "tag": "section",
    "name": "Product FAQ",
    "class": "section_product-faq",
    "settings": [
        {
            "id": "text_titel",
            "type": "text",
            "label": "Titel",
            "default": "FAQ"
        },
        {
            "type": "header",
            "content": "FAQ-Quelle"
        },
        {
            "type": "metaobject",
            "id": "faq_set",
            "label": "FAQ-Set (Kategorie)",
            "metaobject_type": "faqs_category",
            "info": "Entweder ein FAQ-Set waehlen ODER unten einzelne FAQs. Ist ein Set gewaehlt, hat es Vorrang."
        },
        {
            "type": "metaobject_list",
            "id": "faq_entries",
            "label": "Einzelne FAQs",
            "metaobject_type": "faqs_filters",
            "limit": 50
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 5
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#000000"
        }
    ],
    "presets": [
        {
            "name": "Product FAQ",
            "category": "Product",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}