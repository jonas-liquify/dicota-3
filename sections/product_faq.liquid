<div class="padding-global" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem; background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"><div class="container-large">{% if faq_items != blank %}    <div li-if="faq_items != blank">
    <h2 class="product-faq_headline heading-style-h2">
{{ section.settings.text_titel }}
</h2><div class="product-faq_list">{% if section.settings.faq_set != blank %}    <div li-if="section.settings.faq_set != blank">
    <div class="product-faq_items" li-for:inside="faq in section.settings.faq_set.wich_faq.value">
        {% for faq in section.settings.faq_set.wich_faq.value %}                            <div class="product-faq_item" x-data="{open:false}"><button class="product-faq_question" x-on:click="open=!open" x-bind:aria-expanded="open"><span li-object="faq.question" class="product-faq_question-text">{{ faq.question }}</span><span class="product-faq_icon" x-bind:class="{'is-open':open}">{% render 'icon_chevron_down' %}</span></button><div class="product-faq_answer" x-show="open" x-collapse=""><div li-object="faq.faq_answer" class="product-faq_answer-text text-rich-text w-richtext">{{ faq.faq_answer }}</div></div></div>
                    {% endfor %}    </div>    </div>
{% endif %}{% if section.settings.faq_set == blank %}    <div li-if="section.settings.faq_set == blank">
    <div class="product-faq_items" li-for:inside="faq in section.settings.faq_entries">
        {% for faq in section.settings.faq_entries %}                            <div class="product-faq_item" x-data="{open:false}"><button class="product-faq_question" x-on:click="open=!open" x-bind:aria-expanded="open"><span li-object="faq.question" class="product-faq_question-text">{{ faq.question }}</span><span class="product-faq_icon" x-bind:class="{'is-open':open}">{% render 'icon_chevron_down' %}</span></button><div class="product-faq_answer" x-show="open" x-collapse=""><div li-object="faq.faq_answer" class="product-faq_answer-text text-rich-text w-richtext">{{ faq.faq_answer }}</div></div></div>
                    {% endfor %}    </div>    </div>
{% endif %}</div>    </div>
{% endif %}</div></div> {% schema %} {
    "tag": "section",
    "name": "Product FAQ",
    "class": "section_product-faq",
    "settings": [
        {
            "id": "text_titel",
            "type": "text",
            "label": "Titel",
            "default": "FAQ"
        },
        {
            "type": "header",
            "content": "FAQ-Quelle"
        },
        {
            "type": "metaobject",
            "id": "faq_set",
            "label": "FAQ-Set (Kategorie)",
            "metaobject_type": "faqs_category",
            "info": "Entweder ein FAQ-Set waehlen ODER unten einzelne FAQs. Ist ein Set gewaehlt, hat es Vorrang."
        },
        {
            "type": "metaobject_list",
            "id": "faq_entries",
            "label": "Einzelne FAQs",
            "metaobject_type": "faqs_filters",
            "limit": 50
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 5
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#000000"
        }
    ],
    "presets": [
        {
            "name": "Product FAQ",
            "category": "Product",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}