<div class="padding-global" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"><div class="container-large"><h2 class="product-features_headline">
{{ section.settings.text_uberschrift }}
</h2><div class="swiper is-product-features"><div li-cf-theme-blocks="" class="swiper-wrapper is-product-features">
{% content_for 'blocks' %}
</div></div></div></div><div class="hide w-embed w-script"><script>document.addEventListener("DOMContentLoaded", function() {  new Swiper(".swiper.is-product-features", {    slidesPerView: "auto",    spaceBetween: 24,    freeMode: true,    grabCursor: true,    breakpoints: { 0: { spaceBetween: 16 }, 768: { spaceBetween: 24 } }  });});</script></div> {% schema %} {
    "tag": "section",
    "name": "Product Feature Gall",
    "class": "section_product-features",
    "blocks": [
        {
            "type": "feature"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Entdecke die Features"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#000000"
        }
    ],
    "presets": [
        {
            "name": "Product Feature Gall",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "feature"
                }
            ]
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}