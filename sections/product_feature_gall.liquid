<div class="li-tag w-embed">{% assign ph_kf = product.metafields.custom.key_features.value %}{% if product.metafields.custom.filter_image_set != blank and product.metafields.custom.filter_image_set.value.key_features.value != blank %}{% assign ph_kf = product.metafields.custom.filter_image_set.value.key_features.value %}{% endif %}</div><div li-if:inside="ph_kf != blank" style="display:contents" inside="1">
        {% if ph_kf != blank %}
            <div class="padding-global" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem; background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"><div class="container-large"><h2 class="product-features_headline heading-style-h2">
{{ section.settings.text_uberschrift }}
</h2><div class="swiper is-product-features"><div class="swiper-wrapper is-product-features">{% for feature in ph_kf %}    <div li-for="feature in ph_kf" class="swiper-slide is-product-features product-features_item">
                                    <div class="product-features_img-wrap"><img li-object:src="feature.image | image_url: width: 800" li-object:alt="feature.headline" src="{{ feature.image | image_url: width: 800 }}" loading="lazy" alt="{{ feature.headline }}" class="product-features_img"></div>
                            <div class="product-features_content"><h3 li-object="feature.headline" class="product-features_title heading-style-h4">{{ feature.headline }}</h3><div li-object="feature.description | metafield_tag" class="product-features_text text-size-regular">{{ feature.description | metafield_tag }}</div></div>
                        </div>
{% endfor %}</div></div></div></div>        {% endif %}
    </div><div class="hide w-embed w-script"><script>document.addEventListener("DOMContentLoaded", function() { var ensure = function(cb) { if (typeof Swiper !== "undefined") return cb(); if (window.__swiperLoading) return window.__swiperLoading.then(cb); var s = document.createElement("script"); s.src = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"; var link = document.createElement("link"); link.rel = "stylesheet"; link.href = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"; document.head.appendChild(link); window.__swiperLoading = new Promise(function(res) { s.onload = res; }); document.head.appendChild(s); window.__swiperLoading.then(cb); }; ensure(function() { document.querySelectorAll(".swiper.is-product-features").forEach(function(el) { if (el.swiper) return; new Swiper(el, { slidesPerView: "auto", spaceBetween: 24, freeMode: true, grabCursor: true, breakpoints: { 0: { spaceBetween: 16 }, 768: { spaceBetween: 24 } } }); }); }); });</script></div> {% schema %} {
    "tag": "section",
    "name": "Product Feature Gall",
    "class": "section_product-features",
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Discover the features"
        },
        {
            "type": "paragraph",
            "content": "Diese Sektion zieht ihre Inhalte automatisch aus dem Produkt-Metafeld custom.key_features (Liste von Key-Feature-Metaobjekten). Felder pro Eintrag: Headline \u00b7 Category \u00b7 Description \u00b7 Image. Ist das Metafeld auf einem Produkt leer, wird die Sektion ausgeblendet."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 5
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#000000"
        }
    ],
    "presets": [
        {
            "name": "Product Feature Gall",
            "category": "Product",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}