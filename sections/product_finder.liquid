<div class="padding-global padding-section-medium"><div class="container-large"><div class="default-flex-small product-finder_intro"><h1 class="heading-style-h1">
{{ section.settings.text_heading }}
</h1><div class="text-size-medium"> {{ section.settings.textarea_text }} </div></div><div class="product-finder_embed w-embed">{{ section.settings.productfinder_iframe }}</div></div></div> {% schema %} {
    "tag": "section",
    "name": "Product Finder",
    "class": "section_product-finder-page",
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Product Finder"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "Beantworte ein paar Fragen und wir empfehlen dir das passende DICOTA-Produkt f\u00fcr deine Anforderungen."
        },
        {
            "type": "header",
            "content": "Productfinder"
        },
        {
            "type": "html",
            "id": "productfinder_iframe",
            "label": "Productfinder iFrame Code (HTML)"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        }
    ],
    "presets": [
        {
            "name": "Product Finder",
            "category": "Content",
            "blocks": []
        }
    ]
} {% endschema %}