<div class="padding-global padding-section-medium" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"><div class="container-large"><div class="default-flex-small product-finder_intro"><h1 class="heading-style-h1">
{{ section.settings.text_heading }}
</h1><div class="text-size-medium"> {{ section.settings.textarea_text }} </div></div><div class="product-finder_embed w-embed">{{ section.settings.productfinder_iframe }}</div></div></div> {% schema %} {
    "tag": "section",
    "name": "Product Finder",
    "class": "section_product-finder",
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Product Finder"
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "Answer a few questions and we'll recommend the right DICOTA product for your needs."
        },
        {
            "type": "header",
            "content": "Productfinder"
        },
        {
            "type": "html",
            "id": "productfinder_iframe",
            "label": "Productfinder iFrame",
            "default": "&lt;iframe name=\"external\" src=\"https:\/\/www.upgradebox.eu\/v3\/?customer=ch-de.shopify.dicota.com&amp;sl=2\" frameborder=\"0\" scrolling=\"no\" width=\"100%\" height=\"2080pix\"&gt;&lt;\/iframe&gt;"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 5
        }
    ],
    "presets": [
        {
            "name": "Product Finder",
            "category": "Content",
            "blocks": []
        }
    ]
} {% endschema %}