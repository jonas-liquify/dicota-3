new Swiper(".swiper.is-we-care", {slidesPerView: 1, loop: true,autoplay: { delay: 5000, disableOnInteraction: false },pagination: { el: ".ph_we-care-dots", clickable: true }});new Swiper(".swiper.is-upsell", {slidesPerView: 1,navigation: { nextEl: ".ph_upsell-next", prevEl: ".ph_upsell-prev" }});var tabs = document.querySelectorAll(".ph_tab");var dynPanels = document.querySelectorAll(".ph_tab-panels > .ph_tab-panel");var dlPanel = document.querySelector(".ph_tab-panel-downloads");var seeMoreLink = document.querySelector(".ph_see-more");function activateTab(key) {tabs.forEach(function(t){ t.classList.toggle("is-active", t.getAttribute("data-tab") === key); });dynPanels.forEach(function(p,i){ p.style.display = (String(i) === key) ? "block" : "none"; });if (dlPanel) dlPanel.style.display = (key === "downloads") ? "block" : "none";if (seeMoreLink) seeMoreLink.style.display = (key === "downloads") ? "none" : "";}(function(){ var dm = document.querySelector("[data-ph-dim-modal]"); if(dm && dm.parentNode !== document.body) document.body.appendChild(dm); window.__phOpenDim = function(){ if(!dm) return; dm.classList.add("is-open"); dm.setAttribute("aria-hidden","false"); document.documentElement.style.overflow="hidden"; }; window.__phCloseDim = function(){ if(!dm) return; dm.classList.remove("is-open"); dm.setAttribute("aria-hidden","true"); document.documentElement.style.overflow=""; }; if(dm){ dm.querySelectorAll("[data-ph-dim-close]").forEach(function(b){ b.addEventListener("click", window.__phCloseDim); }); dm.addEventListener("click", function(e){ if(e.target===dm) window.__phCloseDim(); }); document.addEventListener("keydown", function(e){ if(e.key==="Escape" && dm.classList.contains("is-open")) window.__phCloseDim(); }); } })();tabs.forEach(function(tab) { tab.addEventListener("click", function(e){ var key = tab.getAttribute("data-tab"); if (key === "dimensions") { if(e && e.preventDefault) e.preventDefault(); if(window.__phOpenDim) window.__phOpenDim(); return; } activateTab(key); }); });(function(){ var active = document.querySelector(".ph_tab.is-active"); activateTab(active ? active.getAttribute("data-tab") : "0"); })();var seeMore = document.querySelector(".ph_see-more");if (seeMore) {seeMore.addEventListener("click", function(e) {e.preventDefault();var panel = document.querySelector(".ph_tab-panel[style*='block']") || document.querySelector(".ph_tab-panel");if (panel) { panel.classList.toggle("is-expanded"); }this.textContent = panel && panel.classList.contains("is-expanded") ? "Show less" : "Show more";});}}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",__phInit);}else{__phInit();}})();</script></div><div class="hide w-embed w-script"><script type="application/json" id="pdf-datasheet-data">{% liquid
