<script src="{{ 'li_custom.js' | asset_url }}" type="text/javascript"></script>
<div li-element="product-variant-container" class="product-header_layout" x-data="handleVariant({{ product | json | escape }}, {{ product.options_by_name | json | escape }}, {{ product.selected_or_first_available_variant | json | escape }})" x-init="$nextTick(() => { activateVariants() })" @setbundleitem.window="updateBundleItem($event.detail.product, $event.detail.quantity)"><div class="product-header_gallery"><div data-ph-lightbox="" aria-hidden="true" class="ph-lightbox"><button type="button" aria-label="Schließen" data-ph-close="" class="ph-lightbox_close"><span class="ph-lightbox_icon w-embed"><svg width="100%" height="100%" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></span></button><button type="button" aria-label="Vorheriges Bild" data-ph-prev="" class="ph-lightbox_nav is-prev"><span class="ph-lightbox_icon w-embed"><svg width="100%" height="100%" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span></button><img data-ph-img="" alt="" class="ph-lightbox_img"><button type="button" aria-label="Nächstes Bild" data-ph-next="" class="ph-lightbox_nav is-next"><span class="ph-lightbox_icon w-embed"><svg width="100%" height="100%" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span></button><div data-ph-counter="" class="ph-lightbox_counter"><span data-ph-current="">1</span> / <span data-ph-total="">1</span></div></div><div class="hide w-embed w-script"><script>(function(){function init(){var gallery=document.querySelector(".product-header_gallery");var lb=document.querySelector("[data-ph-lightbox]");if(!gallery||!lb)return;if(lb.parentNode!==document.body){document.body.appendChild(lb);}var imgEl=lb.querySelector("[data-ph-img]");var curEl=lb.querySelector("[data-ph-current]");var totEl=lb.querySelector("[data-ph-total]");var counter=lb.querySelector("[data-ph-counter]");var prevBtn=lb.querySelector("[data-ph-prev]");var nextBtn=lb.querySelector("[data-ph-next]");var closeBtn=lb.querySelector("[data-ph-close]");var images=[];var index=0;function collect(){var nodes=gallery.querySelectorAll("img.product-header_gallery-image");var seen={};images=[];Array.prototype.forEach.call(nodes,function(i){var src=i.currentSrc||i.src;if(src&&!seen[src]){seen[src]=1;images.push(src);}});}function render(){if(!images.length)return;if(index<0)index=images.length-1;if(index>=images.length)index=0;imgEl.src=images[index];curEl.textContent=index+1;totEl.textContent=images.length;var multi=images.length>1;prevBtn.style.display=multi?"":"none";nextBtn.style.display=multi?"":"none";counter.style.display=multi?"":"none";}function open(src){collect();var i=images.indexOf(src);index=i<0?0:i;render();lb.classList.add("is-open");lb.setAttribute("aria-hidden","false");document.documentElement.style.overflow="hidden";}function close(){lb.classList.remove("is-open");lb.setAttribute("aria-hidden","true");document.documentElement.style.overflow="";}function next(){index++;render();}function prev(){index--;render();}gallery.addEventListener("click",function(e){var trigger=e.target.closest(".product-header_gallery-lightbox.is-clickable");if(!trigger||!gallery.contains(trigger))return;var img=trigger.querySelector("img.product-header_gallery-image");if(!img)return;open(img.currentSrc||img.src);});closeBtn.addEventListener("click",close);prevBtn.addEventListener("click",function(e){e.stopPropagation();prev();});nextBtn.addEventListener("click",function(e){e.stopPropagation();next();});lb.addEventListener("click",function(e){if(e.target===lb)close();});document.addEventListener("keydown",function(e){if(!lb.classList.contains("is-open"))return;if(e.key==="Escape")close();else if(e.key==="ArrowRight")next();else if(e.key==="ArrowLeft")prev();});}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",init);}else{init();}})();</script></div><div class="swiper is-product-gallery"><div li-for:inside="media in product.media" class="swiper-wrapper is-product-gallery">
        {% for media in product.media %}                            {% if media.media_type == 'image' %}    <div li-if="media.media_type == 'image'" class="swiper-slide is-product-gallery">
    <div class="product-header_gallery-lightbox is-clickable"><img li-object:src="media | image_url: width: 1200" li-object:alt="media.alt" alt="{{ media.alt }}" src="{{ media | image_url: width: 1200 }}" loading="lazy" class="product-header_gallery-image"></div>    </div>
{% endif %}
                            {% if media.media_type == 'video' %}    <div li-if="media.media_type == 'video'" class="swiper-slide is-product-gallery">
    <div class="product-header_gallery-lightbox"><div li-object="media | video_tag: controls: true, image_size: '1200x'" class="product-header_gallery-image is-video">{{ media | video_tag: controls: true, image_size: '1200x' }}</div></div>    </div>
{% endif %}
                            {% if media.media_type == 'external_video' %}    <div li-if="media.media_type == 'external_video'" class="swiper-slide is-product-gallery">
    <div class="product-header_gallery-lightbox"><div li-object="media | external_video_tag" class="product-header_gallery-image is-external-video">{{ media | external_video_tag }}</div></div>    </div>
{% endif %}
                            {% if media.media_type == 'model' %}    <div li-if="media.media_type == 'model'" class="swiper-slide is-product-gallery">
    <div class="product-header_gallery-lightbox"><div li-object="media | model_viewer_tag" class="product-header_gallery-image is-model">{{ media | model_viewer_tag }}</div></div>    </div>
{% endif %}
                    {% endfor %}    </div><div class="swiper-pagination ph_gallery-progress"></div></div></div><div li-content-for-theme-blocks="" class="product-header_details">
{% content_for 'blocks' %}
</div></div><div class="hide w-embed w-script"><script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script><script>document.addEventListener("DOMContentLoaded", function() {
var galleryEl = document.querySelector(".swiper.is-product-gallery");
var gallerySwiper = null;
function isDesktop() { return window.matchMedia("(min-width: 992px)").matches; }
function initGallerySwipers() {
  if (!galleryEl) return;
  /* Desktop: gestapeltes Layout per CSS &mdash; kein Swiper.
     Mobile: 1-Slide-Swiper mit Progressbar. */
  if (isDesktop()) {
    if (gallerySwiper) { try { gallerySwiper.destroy(true, true); } catch(e){} gallerySwiper = null; }
    return;
  }
  if (gallerySwiper) return;
  gallerySwiper = new Swiper(galleryEl, {
    slidesPerView: 1,
    spaceBetween: 0,
    keyboard: { enabled: true, onlyInViewport: true },
    pagination: { el: galleryEl.querySelector(".ph_gallery-progress"), type: "progressbar" }
  });
}
initGallerySwipers();
var lastDesktop = isDesktop();
var resizeTimer;
window.addEventListener("resize", function() {
  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(function() {
    var nowDesktop = isDesktop();
    if (nowDesktop !== lastDesktop) { lastDesktop = nowDesktop; initGallerySwipers(); }
  }, 150);
});
new Swiper(".swiper.is-we-care", {slidesPerView: 1, loop: true,autoplay: { delay: 5000, disableOnInteraction: false },pagination: { el: ".ph_we-care-dots", clickable: true }});new Swiper(".swiper.is-upsell", {slidesPerView: 1,navigation: { nextEl: ".ph_upsell-next", prevEl: ".ph_upsell-prev" }});var tabs = document.querySelectorAll(".ph_tab");var panels = document.querySelectorAll(".ph_tab-panel");function activateTab(idx) {tabs.forEach(function(t,i){ t.classList.toggle("is-active", i===idx); });panels.forEach(function(p,i){ p.style.display = i===idx ? "block" : "none"; });}tabs.forEach(function(tab, i) { tab.addEventListener("click", function(){ activateTab(i); }); });(function(){ var activeIdx = Array.from(tabs).findIndex(function(t){ return t.classList.contains("is-active"); }); activateTab(activeIdx >= 0 ? activeIdx : 0); })();var seeMore = document.querySelector(".ph_see-more");if (seeMore) {seeMore.addEventListener("click", function(e) {e.preventDefault();var panel = document.querySelector(".ph_tab-panel[style*='block']") || document.querySelector(".ph_tab-panel");if (panel) { panel.classList.toggle("is-expanded"); }this.textContent = panel && panel.classList.contains("is-expanded") ? "Weniger anzeigen" : "Mehr anzeigen";});}});</script></div> {% schema %} {
