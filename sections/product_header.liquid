scape")close();else if(e.key==="ArrowRight")next();else if(e.key==="ArrowLeft")prev();});}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",init);}else{init();}})();</script></div>{% if product.metafields.custom.filter_image_set != blank %}    <div li-if="product.metafields.custom.filter_image_set != blank" class="swiper is-product-gallery">
