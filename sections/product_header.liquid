function removeGalleryMore() { var root = galleryRootEl(); if (!root) return; var b = root.querySelector(".ph_gallery-more"); if (b) b.remove(); root.classList.remove("is-expanded"); }
function addGalleryMoreIfNeeded() {
  /* Desktop: ab dem 5. Bild ein "More Images"-Text-Link UNTER der Galerie.
