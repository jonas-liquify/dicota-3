ocument.body.appendChild(lb);}var imgEl=lb.querySelector("[data-ph-img]");var curEl=lb.querySelector("[data-ph-current]");var totEl=lb.querySelector("[data-ph-total]");var counter=lb.querySelector("[data-ph-counter]");var prevBtn=lb.querySelector("[data-ph-prev]");var nextBtn=lb.querySelector("[data-ph-next]");var closeBtn=lb.querySelector("[data-ph-close]");var images=[];var index=0;function collect(){var nodes=gallery.querySelectorAll("img.product-header_gallery-image");var seen={};images=[];Array.prototype.forEach.call(nodes,function(i){var src=i.currentSrc||i.src;if(src&&!seen[src]){seen[src]=1;images.push(src);}});}function render(){if(!images.length)return;if(index<0)index=images.length-1;if(index>=images.length)index=0;imgEl.src=images[index];curEl.textContent=index+1;totEl.textContent=images.length;var multi=images.length>1;prevBtn.style.display=multi?"":"none";nextBtn.style.display=multi?"":"none";counter.style.display=multi?"":"none";}function open(src){collect();var i=images.indexOf(src);index=i<0?0:i;render();lb.classList.add("is-open");lb.setAttribute("aria-hidden","false");document.documentElement.style.overflow="hidden";}function close(){lb.classList.remove("is-open");lb.setAttribute("aria-hidden","true");document.documentElement.style.overflow="";}function next(){index++;render();}function prev(){index--;render();}gallery.addEventListener("click",function(e){var trigger=e.target.closest(".product-header_gallery-lightbox.is-clickable");if(!trigger||!gallery.contains(trigger))return;var img=trigger.querySelector("img.product-header_gallery-image");if(!img)return;open(img.currentSrc||img.src);});closeBtn.addEventListener("click",close);prevBtn.addEventListener("click",function(e){e.stopPropagation();prev();});nextBtn.addEventListener("click",function(e){e.stopPropagation();next();});lb.addEventListener("click",function(e){if(e.target===lb)close();});document.addEventListener("keydown",function(e){if(!lb.classList.contains("is-open"))return;if(e.key==="Escape")close();else if(e.key==="ArrowRight")next();else if(e.key==="ArrowLeft")prev();});}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",init);}else{init();}})();</script></div>{% if product.metafields.custom.filter_image_set != blank %}    <div li-if="product.metafields.custom.filter_image_set != blank" class="swiper is-product-gallery">
