<div class="hide w-embed">{% assign loved_gallery = false %}{% for image in product.images %}{% if image.src contains '_40' %}{% assign loved_gallery = true %}{% break %}{% endif %}{% endfor %}</div>{% if loved_gallery %}    <div li-if="loved_gallery" class="padding-global">
    <div class="container-large"><h2 class="product-loved-by_headline">
{{ section.settings.text_uberschrift }}
</h2><div class="product-loved-by_grid" li-for:inside="image in product.images">
        {% for image in product.images %}                            <div li-if:inside="image.src contains '_40'" inside="1">
        {% if image.src contains '_40' %}
            <img class="product-loved-by_img" li-object:src="image | image_url: width: 800" li-object:alt="image.alt" src="{{ image | image_url: width: 800 }}" loading="lazy" alt="{{ image.alt }}">        {% endif %}
    </div>
                            <div li-if:inside="image.src contains '_41'" inside="1">
        {% if image.src contains '_41' %}
            <img class="product-loved-by_img" li-object:src="image | image_url: width: 800" li-object:alt="image.alt" src="{{ image | image_url: width: 800 }}" loading="lazy" alt="{{ image.alt }}">        {% endif %}
    </div>
                            <div li-if:inside="image.src contains '_42'" inside="1">
        {% if image.src contains '_42' %}
            <img class="product-loved-by_img is-big" li-object:src="image | image_url: width: 1200" li-object:alt="image.alt" src="{{ image | image_url: width: 1200 }}" loading="lazy" alt="{{ image.alt }}">        {% endif %}
    </div>
                            <div li-if:inside="image.src contains '_43'" inside="1">
        {% if image.src contains '_43' %}
            <img class="product-loved-by_img" li-object:src="image | image_url: width: 800" li-object:alt="image.alt" src="{{ image | image_url: width: 800 }}" loading="lazy" alt="{{ image.alt }}">        {% endif %}
    </div>
                            <div li-if:inside="image.src contains '_44'" inside="1">
        {% if image.src contains '_44' %}
            <img class="product-loved-by_img" li-object:src="image | image_url: width: 800" li-object:alt="image.alt" src="{{ image | image_url: width: 800 }}" loading="lazy" alt="{{ image.alt }}">        {% endif %}
    </div>
                            <div li-if:inside="image.src contains '_45'" inside="1">
        {% if image.src contains '_45' %}
            <img class="product-loved-by_img is-big" li-object:src="image | image_url: width: 1200" li-object:alt="image.alt" src="{{ image | image_url: width: 1200 }}" loading="lazy" alt="{{ image.alt }}">        {% endif %}
    </div>
                    {% endfor %}    </div></div>    </div>
{% endif %} {% schema %} {
    "tag": "section",
    "name": "Product Loved-by Gal",
    "class": "section_product-loved-by",
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "How People Wear It"
        },
        {
            "type": "paragraph",
            "content": "Die Galerie zieht ihre Bilder automatisch aus den Produkt-Bildern (Dateiname enth\u00e4lt _40 bis _45, z.B. D32163_40.webp). _42 und _45 werden im gro\u00dfen Bento-Format gerendert (doppelte H\u00f6he). Ist KEIN Bild mit _40 vorhanden, wird die ganze Sektion ausgeblendet."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#0f0f0f"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#ffffff"
        }
    ],
    "presets": [
        {
            "name": "Product Loved-by Gal",
            "category": "Product",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}