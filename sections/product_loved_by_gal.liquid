<div class="hide w-embed">{% assign loved_gallery = false %}{% if product.metafields.custom.images_lifestyle_shooting != blank %}{% assign loved_gallery = true %}{% endif %}</div><div li-if:inside="loved_gallery" style="display:contents" inside="1">
        {% if loved_gallery %}
            <div class="padding-global" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem; background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"><div class="container-large"><h2 class="product-loved-by_headline">
{{ section.settings.text_uberschrift }}
</h2><div class="product-loved-by_grid" li-for:inside="image in product.metafields.custom.images_lifestyle_shooting.value">
        {% for image in product.metafields.custom.images_lifestyle_shooting.value %}                            <div class="product-loved-by_item"><img class="product-loved-by_img" li-object:src="image | image_url: width: 1000" src="{{ image | image_url: width: 1000 }}" loading="lazy" alt=""></div>
                    {% endfor %}    </div></div></div>        {% endif %}
    </div> {% schema %} {
    "tag": "section",
    "name": "Product Loved-by Gal",
    "class": "section_product-loved-by",
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "How People Wear It"
        },
        {
            "type": "paragraph",
            "content": "Bilder kommen aus dem Produkt-Metafeld custom.images_lifestyle_shooting (Liste). Ohne Bilder wird die Sektion ausgeblendet."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 5
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#0f0f0f"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#ffffff"
        }
    ],
    "presets": [
        {
            "name": "Product Loved-by Gal",
            "category": "Product",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}