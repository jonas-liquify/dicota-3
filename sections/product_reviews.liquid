<div class="padding-global" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;background-color:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};"><div class="container-large"><div class="product-reviews_layout"><div class="product-reviews_summary"><div class="product-reviews_rating-block"><div class="product-reviews_stars"><svg width="16" height="16" viewbox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg><svg width="16" height="16" viewbox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg><svg width="16" height="16" viewbox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg><svg width="16" height="16" viewbox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg><svg width="16" height="16" viewbox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg></div><p class="product-reviews_score">
{{ section.settings.text_score }}
</p><p class="product-reviews_count">
{{ section.settings.text_anzahl }}
</p></div><div class="product-reviews_breakdown"><p class="product-reviews_breakdown-title">
{{ section.settings.text_breakdown_titel }}
</p><div class="product-reviews_bars"><div class="product-reviews_bar-row"><span class="product-reviews_bar-label">5</span><div class="product-reviews_bar-track"><div class="product-reviews_bar-fill" style="width: {{ section.settings.stars_5_pct }}%"></div></div></div><div class="product-reviews_bar-row"><span class="product-reviews_bar-label">4</span><div class="product-reviews_bar-track"><div class="product-reviews_bar-fill" style="width: {{ section.settings.stars_4_pct }}%"></div></div></div><div class="product-reviews_bar-row"><span class="product-reviews_bar-label">3</span><div class="product-reviews_bar-track"><div class="product-reviews_bar-fill" style="width: {{ section.settings.stars_3_pct }}%"></div></div></div><div class="product-reviews_bar-row"><span class="product-reviews_bar-label">2</span><div class="product-reviews_bar-track"><div class="product-reviews_bar-fill" style="width: {{ section.settings.stars_2_pct }}%"></div></div></div><div class="product-reviews_bar-row"><span class="product-reviews_bar-label">1</span><div class="product-reviews_bar-track"><div class="product-reviews_bar-fill" style="width: {{ section.settings.stars_1_pct }}%"></div></div></div></div></div><a href="{{ section.settings.url_rezension_schreiben_link }}" class="button product-reviews_write-btn"> Write a review </a></div><div class="product-reviews_list"><div li-cf-theme-blocks="" class="product-reviews_items">
{% content_for 'blocks' %}
</div><a href="{{ section.settings.url_mehr_bewertungen_link }}" class="button is-secondary product-reviews_more-btn"> Load more reviews </a></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Product Reviews",
    "class": "section_product-reviews",
    "blocks": [
        {
            "type": "rezension"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_score",
            "type": "text",
            "label": "Score",
            "default": "4.9\/5.0 rating"
