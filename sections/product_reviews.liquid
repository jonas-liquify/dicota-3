        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#000000"
        }
    ],
    "presets": [
        {
            "name": "Product Reviews",
            "category": "Product",
            "blocks": [
                {
                    "type": "rezension"
                }
            ]
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}