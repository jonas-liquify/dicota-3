            "label": "Rezension schreiben Link"
        },
        {
            "id": "url_mehr_bewertungen_link",
            "type": "url",
            "label": "Mehr Bewertungen Link"
        },
        {
            "type": "header",
            "content": "Bewertungs\u00fcbersicht"
        },
        {
            "type": "text",
            "id": "stars_5_pct",
            "label": "5-Sterne Prozent 0-100",
            "default": "80"
        },
        {
            "type": "text",
            "id": "stars_4_pct",
            "label": "4-Sterne Prozent 0-100",
            "default": "20"
        },
        {
            "type": "text",
            "id": "stars_3_pct",
            "label": "3-Sterne Prozent 0-100",
            "default": "0"
        },
        {
            "type": "text",
            "id": "stars_2_pct",
            "label": "2-Sterne Prozent 0-100",
            "default": "0"
        },
        {
            "type": "text",
            "id": "stars_1_pct",
            "label": "1-Sterne Prozent 0-100",
            "default": "0"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
