<div class="section_product-sticky padding-global product-sticky_bar" data-product-sticky="" aria-hidden="true" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"><div class="container-large product-sticky_inner"><div class="product-sticky_media"><img li-object:src="product.featured_image | image_url: width: 220" li-object:alt="product.title" src="{{ product.featured_image | image_url: width: 220 }}" loading="lazy" alt="{{ product.title }}" class="product-sticky_image"></div><div class="product-sticky_info"><p li-object="product.title" class="product-sticky_title">{{ product.title }}</p><div class="product-sticky_meta"><span li-object="product.selected_or_first_available_variant.price | money" class="product-sticky_price">{{ product.selected_or_first_available_variant.price | money }}</span>{% if product.metafields.judgeme.review_widget_data.value.number_of_reviews > 0 %}    <a li-if="product.metafields.judgeme.review_widget_data.value.number_of_reviews > 0" href="#bewertungen" class="product-sticky_rating">
    <span class="product-card_stars" aria-hidden="true" style="--rating: {{ product.metafields.judgeme.review_widget_data.value.average_rating }}"></span><strong li-object="product.metafields.judgeme.review_widget_data.value.average_rating | times: 1 | round: 1" class="product-sticky_rating-score">{{ product.metafields.judgeme.review_widget_data.value.average_rating | times: 1 | round: 1 }}</strong><span class="product-sticky_rating-count">(<span li-object="product.metafields.judgeme.review_widget_data.value.number_of_reviews">{{ product.metafields.judgeme.review_widget_data.value.number_of_reviews }}</span>)</span>    </a>
{% endif %}</div></div><div class="product-sticky_action">{% if product.selected_or_first_available_variant.available %}    <div li-if="product.selected_or_first_available_variant.available">
    <form method="post" action="/cart/add" class="product-sticky_form"><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><script src="{{ 'li_custom.js' | asset_url }}" type="text/javascript"></script>
<button type="submit" li-element="direct-add-to-cart" class="product-sticky_btn" x-data="handleVariant({{ product | json | escape }}, {{ product.options_by_name | json | escape }}, {{ product.selected_or_first_available_variant | json | escape }})" @click="addToCart($event, true)"><span li-object="settings.text_add_to_cart | default: 'In den Warenkorb'">{{ settings.text_add_to_cart | default: 'In den Warenkorb' }}</span></button></form>    </div>
{% endif %}{% unless product.selected_or_first_available_variant.available %}    <div li-unless="product.selected_or_first_available_variant.available">
    <span li-object="settings.text_unavailable | default: 'Nicht verfügbar'" class="product-sticky_btn is-disabled">{{ settings.text_unavailable | default: 'Nicht verfügbar' }}</span>    </div>
{% endunless %}</div></div></div><div class="hide w-embed w-script"><script>(function(){function init(){var bar=document.querySelector("[data-product-sticky]");var hero=document.querySelector(".section_product-header");if(!bar||!hero)return;var nav=document.querySelector(".section_navbar .nav_component");function syncTop(){var h=nav?Math.round(nav.getBoundingClientRect().height):0;bar.style.setProperty("--product-sticky-top",h+"px");}syncTop();window.addEventListener("resize",syncTop);function setVisible(v){bar.classList.toggle("is-visible",v);bar.setAttribute("aria-hidden",v?"false":"true");}if("IntersectionObserver" in window){var io=new IntersectionObserver(function(entries){entries.forEach(function(e){setVisible(!e.isIntersecting&&e.boundingClientRect.top<0);});},{rootMargin:"0px",threshold:0});io.observe(hero);var foot=document.querySelector(".section_footer-group,[class*=\"section_footer-newsletter\"]");if(foot){var atFoot=false;var io2=new IntersectionObserver(function(es){es.forEach(function(e){atFoot=e.isIntersecting;if(atFoot)setVisible(false);});},{threshold:0});io2.observe(foot);var origSetVisible=setVisible;setVisible=function(v){origSetVisible(v&&!atFoot);};}}else{window.addEventListener("scroll",function(){var r=hero.getBoundingClientRect();setVisible(r.bottom<0);},{passive:true});}}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",init);}else{init();}})();</script></div> {% schema %} {
    "tag": "section",
    "name": "Product Sticky Bar",
    "settings": [
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#0f0f0f"
        }
    ],
    "presets": [
        {
            "name": "Product Sticky Bar",
            "category": "Product",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}