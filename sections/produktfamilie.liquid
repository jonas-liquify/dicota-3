<div class="padding-global" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.bg_color }};"><div class="container-large"><h2 class="product-family_headline">
{{ section.settings.text_uberschrift }}
</h2><div class="product-family_img-wrap">{% if section.settings.image_ubersichtsbild %}
{{ section.settings.image_ubersichtsbild | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'product-family_img' }}
{% else %}
<img src="{{ 'placeholder.svg' | asset_url }}" loading="lazy" alt="" class="product-family_img">
{% endif %}</div></div></div> {% schema %} {
    "tag": "section",
    "name": "Produktfamilie",
    "class": "section_product-family",
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Die Produktfamilie auf einen Blick"
        },
        {
            "id": "image_ubersichtsbild",
            "type": "image_picker",
            "label": "\u00dcbersichtsbild"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#f5f5f5"
        }
    ],
    "presets": [
        {
            "name": "Produktfamilie",
            "category": "Liquify",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}