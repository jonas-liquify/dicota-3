<div class="li-tag w-embed">{% assign jm_r_raw = shop.metafields.judgeme.all_reviews_rating.value | default: shop.metafields.judgeme.all_reviews_rating %}{% assign jm_c_raw = shop.metafields.judgeme.all_reviews_count.value | default: shop.metafields.judgeme.all_reviews_count %}{% assign jm_rating = jm_r_raw | plus: 0 %}{% assign rb_count = jm_c_raw | plus: 0 %}{% assign rb_score = section.settings.text_bewertung_zahl %}{% if jm_rating > 0 %}{% assign rb_score = jm_rating | round: 2 %}{% endif %}{% assign rb_stars = rb_score | replace: ',', '.' | plus: 0 %}{% if rb_stars <= 0 %}{% assign rb_stars = 5 %}{% endif %}</div><div class="padding-global" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem; background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; --rating-stars-color: {{ section.settings.stars_color }};"><div class="container-large"><div class="rating-bar_inner{% if section.settings.alignment == 'left' %} is-align-left{% elsif section.settings.alignment == 'right' %} is-align-right{% endif %}"><div class="rating-bar_stars" aria-hidden="true"><div class="rating-bar_star-mask" style="--rating: {{ rb_stars }}"></div></div><span class="rating-bar_score" data-jm-num="" data-jm-decimals="2" li-object="rb_score">{{ rb_score }}</span>{% if section.settings.text_bewertung_label != blank %}    <span class="li-guard" li-if="section.settings.text_bewertung_label != blank">
    <span class="rating-bar_label">
{{ section.settings.text_bewertung_label }}
</span>    </span>
{% endif %}<span class="rating-bar_divider" aria-hidden="true"></span>{% if rb_count > 0 %}    <span class="li-guard" li-if="rb_count > 0">
    <span class="rating-bar_count"><span data-jm-num="" data-jm-decimals="0" li-object="rb_count">{{ rb_count }}</span><span li-object="'reviews.count_label' | t">{{ 'reviews.count_label' | t }}</span></span>    </span>
{% endif %}{% if rb_count == 0 %}    <span class="li-guard" li-if="rb_count == 0">
    {% if section.settings.text_anzahl_bewertungen != blank %}    <span class="li-guard" li-if="section.settings.text_anzahl_bewertungen != blank">
    <span class="rating-bar_count">
{{ section.settings.text_anzahl_bewertungen }}
</span>    </span>
{% endif %}    </span>
{% endif %}<a href="{{ section.settings.url_provider_link }}" class="rating-bar_provider w-inline-block"> {% if section.settings.image_provider_logo != blank %} <span class="li-guard" li-if="section.settings.image_provider_logo != blank"> {% if section.settings.image_provider_logo %} {{ section.settings.image_provider_logo | image_url: width: 60 | image_tag: loading: 'lazy', class: 'rating-bar_logo' }} {% else %} <img src="{{ 'placeholder.svg' | asset_url }}" loading="lazy" alt="" class="rating-bar_logo"> {% endif %} </span>{% endif %} </a></div></div></div><div class="hide w-embed w-script"><script>
(function(){
  /* judge.me liefert rohe Zahlen (4.8333 / 17982). Liquid hat keinen
     Locale-Zahlenformatter, deshalb wird die Anzeige hier nach der
     Seitensprache formatiert. Ohne JS bleibt die rohe, korrekte Zahl stehen. */
  if (window.__dicotaJmNum) return;
  window.__dicotaJmNum = true;
  var NUMERIC = /^-?\d+(\.\d+)?$/;
  function format(root){
    var lang = document.documentElement.getAttribute('lang') || 'de';
    var els = (root || document).querySelectorAll('[data-jm-num]');
    for (var i = 0; i < els.length; i++) {
      var el = els[i];
      var raw = (el.textContent || '').trim();
      /* Nur reine Zahlen anfassen &mdash; ein manuell gepflegter Fallback wie
         "4,83" oder "17.982 reviews" bleibt unver&auml;ndert. */
      if (!NUMERIC.test(raw)) continue;
      var dec = parseInt(el.getAttribute('data-jm-decimals') || '0', 10);
      if (isNaN(dec)) dec = 0;
      try {
        el.textContent = new Intl.NumberFormat(lang, {
          minimumFractionDigits: dec,
          maximumFractionDigits: dec
        }).format(parseFloat(raw));
      } catch (e) {}
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ format(); });
  else format();
  /* Theme-Editor rendert Sektionen einzeln neu. */
  document.addEventListener('shopify:section:load', function(e){ format(e.target); });
})();
</script></div> {% schema %} {
