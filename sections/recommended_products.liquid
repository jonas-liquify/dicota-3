<div data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=10&intent=related" class="padding-global padding-section-medium product-recommendations"><div class="container-large"><div class="headline-wrapper"><h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2></div><div class="recommended-products_slider-wrapper"><div class="recommended-products_swiper swiper"><div role="list" class="swiper-wrapper recommended-products_list">{% for product in recommendations.products %}    <div li-for="product in recommendations.products" role="listitem" class="swiper-slide recommended-products_item">
                                    {% render 'product_card', product: product %}
                        </div>
{% endfor %}</div><div class="recommended-products_scrollbar swiper-scrollbar"></div></div><button type="button" class="recommended-products_arrow swiper-button-next" aria-label="Next"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_right' %}</div></button><button type="button" class="recommended-products_arrow is-prev swiper-button-prev" aria-label="Previous"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_left' %}</div></button></div></div></div><div class="hide w-embed w-script"><script>
              document.addEventListener('DOMContentLoaded', function() {
                const productRecommendationsSection = document.querySelector('.product-recommendations');
                const url = productRecommendationsSection.dataset.url;
                var ensureSwiper = function(cb) { if (typeof Swiper !== "undefined") return cb(); if (window.__swiperLoading) return window.__swiperLoading.then(cb); var s = document.createElement("script"); s.src = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"; var link = document.createElement("link"); link.rel = "stylesheet"; link.href = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"; document.head.appendChild(link); window.__swiperLoading = new Promise(function(res) { s.onload = res; }); document.head.appendChild(s); window.__swiperLoading.then(cb); };
                function initRecommendedSlider() {
                  var el = productRecommendationsSection.querySelector(".recommended-products_swiper.swiper");
                  if (!el || el.swiper) return;
                  ensureSwiper(function() {
                    var root = el.closest(".product-recommendations") || document;
                    new Swiper(el, { slidesPerView: "auto", spaceBetween: 5, navigation: { nextEl: root.querySelector(".recommended-products_arrow.swiper-button-next"), prevEl: root.querySelector(".recommended-products_arrow.is-prev"), disabledClass: "swiper-button-disabled" }, scrollbar: { el: el.querySelector(".recommended-products_scrollbar"), draggable: true } });
                  });
                }
                fetch(url)
                  .then(response => response.text())
                  .then(text => {
                    const html = document.createElement('div');
                    html.innerHTML = text;
                    const recommendations = html.querySelector('.product-recommendations');
                    if (recommendations && recommendations.innerHTML.trim().length) {
                      productRecommendationsSection.innerHTML = recommendations.innerHTML;
                      initRecommendedSlider();
                    }
                  })
                  .catch(e => {
                    console.error(e);
                  });
              });
            </script></div> {% schema %} {
    "tag": "section",
    "name": "Recommended Products",
    "class": "section_product-recommended",
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Recommended"
        }
    ],
    "presets": [
        {
            "name": "Recommended Products",
            "category": "Product",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}