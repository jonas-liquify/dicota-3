<div class="section_announcement-bar section_b2b-announcement-bar reseller-header_top"><div class="announcement-bar_container"><div li-cf-theme-blocks="" class="announcement-bar_items">
{% content_for 'blocks' %}
</div>{% content_for "block", type: "reseller-rechte-seite", id: "reseller-rechte-seite" %}</div></div><div class="reseller-header_nav"><div class="reseller-header_nav-inner"><div class="reseller-header_left"><a href="{{ routes.root_url }}" li-object:href="routes.root_url" class="reseller-header_brand" aria-label="To the homepage">{% if section.settings.image_logo %}
{{ section.settings.image_logo | image_url: width: 300 | image_tag: loading: 'lazy', class: 'reseller-header_logo' }}
{% else %}
<img src="{{ 'liquify-logo-black.svg' | asset_url }}" loading="lazy" alt="" class="reseller-header_logo">
{% endif %}<span li-if="section.settings.text_sublabel != blank" class="reseller-header_sublabel">
{{ section.settings.text_sublabel }}
</span></a>{% content_for "block", type: "reseller-menu", id: "reseller-menu" %}</div><div class="reseller-header_actions"><a li-if="section.settings.text_contact_sales_text != blank" href="{{ section.settings.url_contact_sales_link }}" class="button reseller-header_btn-outline w-button"> <span>{{ section.settings.text_contact_sales_text }}</span> </a><a li-if="section.settings.text_login_text != blank" href="{{ section.settings.url_login_link }}" class="button reseller-header_btn-solid w-button"> <span class="reseller-header_btn-icon w-embed"><svg width="100%" height="100%" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 12C10.9 12 9.95833 11.6083 9.175 10.825C8.39167 10.0417 8 9.1 8 8C8 6.9 8.39167 5.95833 9.175 5.175C9.95833 4.39167 10.9 4 12 4C13.1 4 14.0417 4.39167 14.825 5.175C15.6083 5.95833 16 6.9 16 8C16 9.1 15.6083 10.0417 14.825 10.825C14.0417 11.6083 13.1 12 12 12ZM4 20V17.2C4 16.6333 4.14583 16.1125 4.4375 15.6375C4.72917 15.1625 5.11667 14.8 5.6 14.55C6.63333 14.0333 7.68333 13.6458 8.75 13.3875C9.81667 13.1292 10.9 13 12 13C13.1 13 14.1833 13.1292 15.25 13.3875C16.3167 13.6458 17.3667 14.0333 18.4 14.55C18.8833 14.8 19.2708 15.1625 19.5625 15.6375C19.8542 16.1125 20 16.6333 20 17.2V20H4Z" fill="currentColor"></path></svg></span><span>{{ section.settings.text_login_text }}</span> </a></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Reseller Header",
    "class": "section_reseller-header",
    "blocks": [
        {
            "type": "reseller-header-usp"
        },
        {
            "type": "reseller-header-link"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "image_logo",
            "type": "image_picker",
            "label": "Logo"
        },
        {
            "id": "text_sublabel",
            "type": "text",
            "label": "Sublabel",
            "default": "Reseller"
        },
        {
            "id": "url_contact_sales_link",
            "type": "url",
            "label": "Contact-Sales Link"
        },
        {
            "id": "text_contact_sales_text",
            "type": "text",
            "label": "Contact-Sales Text",
            "default": "Contact Sales"
        },
        {
            "id": "url_login_link",
            "type": "url",
            "label": "Login Link"
        },
        {
            "id": "text_login_text",
            "type": "text",
            "label": "Login Text",
            "default": "myDCT Login"
        },
        {
            "type": "header",
            "content": "Reseller-Men\u00fc"
        },
        {
            "type": "link_list",
            "id": "reseller_menu",
            "label": "Reseller-Men\u00fc"
        },
        {
            "type": "paragraph",
            "content": "Diese Section kombiniert eine B2B-Announcement-Bar (dark, Theme Blocks f\u00fcr USPs und Links) mit einer eigenen Reseller-Navigation (Logo + RESELLER-Sublabel, Men\u00fc aus separater Linkliste, Contact-Sales + myDCT-Login Buttons). Auf der Reseller-Hub-Page als ERSTE Section in den Main-Content einf\u00fcgen \u2014 die globale Header-Group erscheint trotzdem davor, ausser du blendest sie per Theme-Editor auf dieser Page aus."
        }
    ],
    "presets": [
        {
            "name": "Reseller Header",
            "category": "_B2B",
            "blocks": [
                {
                    "type": "reseller-header-usp"
                },
                {
                    "type": "reseller-rechte-seite",
                    "static": true,
                    "id": "reseller-rechte-seite",
                    "blocks": [
                        {
                            "type": "reseller-header-link"
                        }
                    ]
                },
                {
                    "type": "reseller-menu",
                    "static": true,
                    "id": "reseller-menu"
                }
            ]
        }
    ]
} {% endschema %}