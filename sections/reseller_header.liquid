});}if(sug){var sref=sug.querySelector(".nav_search-suggestion-item");queries.forEach(function(s){var li=document.createElement("li");li.setAttribute("data-ps-injected","");li.className="nav_search-suggestion-item";var a=document.createElement("a");a.className="nav_search-suggestion-link";var txt=s.text||"";a.setAttribute("href",s.url||("/search?q="+encodeURIComponent(txt)));a.textContent=txt;li.appendChild(a);sug.insertBefore(li,sref);});}}).catch(function(){c.loading=false;});};</script></div><button type="button" x-on:click="open = !open" x-bind:aria-expanded="open ? 'true' : 'false'" aria-label="Menu" class="reseller-header_menu-button{% if customer %} is-adjacent{% endif %}"><div class="reseller-header_menu-icon" x-show="!open"><svg width="100%" height="100%" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M3 6H21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path><path d="M3 12H21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path><path d="M3 18H21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg></div><div class="reseller-header_menu-icon" x-show="open" x-cloak="">{% render 'icon_close' %}</div></button></div></div> {% schema %} {
