<div class="reseller-hero_bg">{% if section.settings.image_hintergrundbild != blank %}    <span class="li-guard" li-if="section.settings.image_hintergrundbild != blank">
    {% if section.settings.image_hintergrundbild %}
{{ section.settings.image_hintergrundbild | image_url: width: 2400 | image_tag: loading: 'eager', class: 'reseller-hero_bg-image' }}
{% else %}
<img src="{{ 'hero-apparel-1.svg' | asset_url }}" loading="eager" alt="" class="reseller-hero_bg-image">
{% endif %}    </span>
{% endif %}<div class="reseller-hero_overlay"></div></div><div class="padding-global reseller-hero_padding" style="--reseller-hero-min-height: {{ section.settings.min_height }}vh; color: {{ section.settings.text_color }};"><div class="container-large reseller-hero_inner"><div class="reseller-hero_content"><h1 class="reseller-hero_title heading-style-h1">
{{ section.settings.text_headline }}
</h1><p class="reseller-hero_subtext text-size-medium"> {{ section.settings.textarea_subtext }} </p><form action="/search" method="get" role="search" class="reseller-hero_search"><div class="reseller-hero_search-cat"><span>
{{ section.settings.text_kategorie_label }}
</span><div class="reseller-hero_search-cat-icon w-embed">{% render 'icon_chevron_down' %}</div></div><input type="search" name="q" placeholder="Search for articles, categories or application area" autocomplete="off" class="reseller-hero_search-input"><button type="submit" aria-label="Search" class="reseller-hero_search-btn"><div class="reseller-hero_search-btn-icon w-embed"><svg width="100%" height="100%" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M19.6 21L13.3 14.7C12.8 15.1 12.225 15.4167 11.575 15.65C10.925 15.8833 10.2333 16 9.5 16C7.68333 16 6.14583 15.3708 4.8875 14.1125C3.62917 12.8542 3 11.3167 3 9.5C3 7.68333 3.62917 6.14583 4.8875 4.8875C6.14583 3.62917 7.68333 3 9.5 3C11.3167 3 12.8542 3.62917 14.1125 4.8875C15.3708 6.14583 16 7.68333 16 9.5C16 10.2333 15.8833 10.925 15.65 11.575C15.4167 12.225 15.1 12.8 14.7 13.3L21 19.6L19.6 21Z" fill="currentColor"></path></svg></div></button></form><div class="reseller-hero_trends"><span li-object="'general.trending' | t" class="reseller-hero_trends-label">{{ 'general.trending' | t }}</span><div li-cf-theme-blocks="" class="reseller-hero_trend-list">
{% content_for 'blocks' %}
</div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Reseller Hero",
    "class": "section_reseller-hero",
    "blocks": [
        {
            "type": "trend-tag"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "image_hintergrundbild",
            "type": "image_picker",
            "label": "Hintergrundbild"
        },
        {
            "id": "text_headline",
            "type": "text",
            "label": "Headline",
            "default": "Welcome to DICOTA myDCT"
        },
        {
            "id": "textarea_subtext",
            "type": "textarea",
            "label": "Subtext",
            "default": "Benefit from attractive prices and offers for your end customers"
        },
        {
            "id": "text_kategorie_label",
            "type": "text",
            "label": "Kategorie Label",
            "default": "Categories"
        },
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "range",
            "id": "min_height",
            "min": 40,
            "max": 100,
            "step": 2,
            "unit": "vh",
            "label": "Mindesth\u00f6he",
            "default": 78
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#ffffff"
        }
    ],
    "presets": [
        {
            "name": "Reseller Hero",
            "category": "Hero",
            "blocks": [
                {
                    "type": "trend-tag"
                }
            ]
        }
    ]
} {% endschema %}