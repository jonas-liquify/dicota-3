<div class="reseller-hub_grid"><div class="reseller-hub_media">{% if section.settings.image_bild %}
{{ section.settings.image_bild | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'reseller-hub_image' }}
{% else %}
<img src="{{ 'hero-apparel-2.svg' | asset_url }}" loading="lazy" alt="" class="reseller-hub_image">
{% endif %}</div><div class="reseller-hub_panel" x-data="{ open: 1, count: 0 }"><div class="reseller-hub_panel-inner"><h2 class="reseller-hub_title heading-style-h2">
{{ section.settings.text_heading }}
</h2><div li-cf-theme-blocks="" class="reseller-hub_accordion">
{% content_for 'blocks' %}
</div><div class="reseller-hub_actions"><a href="{{ section.settings.url_button_1_link }}" class="button reseller-hub_btn w-button"> <span>{{ section.settings.text_button_1_text }}</span> </a><a href="{{ section.settings.url_button_2_link }}" class="button is-on-dark reseller-hub_btn w-button"> <span>{{ section.settings.text_button_2_text }}</span> </a></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Reseller Hub",
    "class": "section_reseller-hub",
    "blocks": [
        {
            "type": "vorteil"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "image_bild",
            "type": "image_picker",
            "label": "Bild"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "DICOTA Reseller Hub. Ein No-Brainer, f\u00fcr alle die Vorteile geniessen wollen"
        },
        {
            "id": "url_button_1_link",
            "type": "url",
            "label": "Button 1 Link"
        },
        {
            "id": "text_button_1_text",
            "type": "text",
            "label": "Button 1 Text",
            "default": "Einloggen"
        },
        {
            "id": "url_button_2_link",
            "type": "url",
            "label": "Button 2 Link"
        },
        {
            "id": "text_button_2_text",
            "type": "text",
            "label": "Button 2 Text",
            "default": "Registrieren"
        }
    ],
    "presets": [
        {
            "name": "Reseller Hub",
            "category": "Showcase",
            "blocks": [
                {
                    "type": "vorteil"
                }
            ]
        }
    ]
} {% endschema %}