{% endfor %}</div><div class="coll-filter-modal_footer"><a href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=product,article" class="text-style-link coll-filter-modal_clear"><span li-object="'general.clear' | t">{{ 'general.clear' | t }}</span></a><button type="button" class="button is-blue coll-filter-modal_apply" x-on:click="filterModalOpen = false"><span li-object="'collection.show_results' | t">{{ 'collection.show_results' | t }}</span></button></div></div></div><div class="hide w-embed w-script"><script>(function(){
  var SELECTOR='[data-section-rendering="search-products"]';
  var DEBUG=true;
  var inflight=null;
  function log(){if(DEBUG&&window.console)console.info.apply(console,['[CollSR]'].concat([].slice.call(arguments)));}
  function warn(){if(window.console)console.warn.apply(console,['[CollSR]'].concat([].slice.call(arguments)));}
  function getSection(){return document.querySelector(SELECTOR);}
  /* Absicherung: die aktive Sortierung steht serverseitig als data-active-sort
     am Select (Attributwert, wird vom Build nicht angetastet). Falls das
     selected-Attribut im Markup verloren geht, wird die Auswahl hier gesetzt. */
  function syncSort(){
    var root=getSection();if(!root)return;
    var sel=root.querySelector('[data-coll-sort]');if(!sel)return;
    var want=sel.getAttribute('data-active-sort')||'';
    if(!want||want.indexOf('{'+'{')!==-1)return;
    for(var i=0;i<sel.options.length;i++){
      if(sel.options[i].value===want){
        if(sel.selectedIndex!==i){log('sort select korrigiert auf',want);sel.selectedIndex=i;}
        return;
      }
    }
  }
  log('script loaded');
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',syncSort);else syncSort();
  function renderFromUrl(url){
    var section=getSection();
    if(!section){warn('no section in DOM');return;}
    var sectionId=section.dataset.sectionId;
    if(!sectionId||sectionId.indexOf('{'+'{'  )!==-1){warn('sectionId missing or unevaluated:',sectionId,'&mdash; falling back to navigation');location.href=url;return;}
    var target;try{target=new URL(url,location.origin);}catch(e){warn('invalid URL:',url);location.href=url;return;}
    var fetchUrl=new URL(target.toString());
    fetchUrl.searchParams.set('section_id',sectionId);
    log('fetching',fetchUrl.toString());
    if(inflight){inflight.abort();}
    var ctrl=new AbortController();inflight=ctrl;
    section.setAttribute('aria-busy','true');section.classList.add('is-loading');
    fetch(fetchUrl.toString(),{signal:ctrl.signal,headers:{'Accept':'text/html'}})
      .then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.text();})
      .then(function(html){
        var doc=new DOMParser().parseFromString(html,'text/html');
        var fresh=doc.querySelector(SELECTOR);
        if(!fresh){var w=doc.querySelector('[id^="shopify-section-"]');if(w)fresh=w.querySelector(SELECTOR);}
        if(!fresh)throw new Error('section not in response html');
        getSection().replaceWith(fresh);
        log('section replaced');
        syncSort();
        target.searchParams.delete('section_id');
        history.pushState({},'',target.toString());
        if(window.Alpine){try{window.Alpine.initTree(getSection());}catch(e){warn('Alpine init err',e);}}
        var topY=getSection().getBoundingClientRect().top+window.pageYOffset-80;
        if(window.scrollY>topY)window.scrollTo({top:topY,behavior:'smooth'});
      })
      .catch(function(err){
        if(err.name==='AbortError'){log('aborted');return;}
        warn('fetch failed:',err.message,'&mdash; full reload as fallback');
        location.href=target.toString();
      })
      .finally(function(){var s=getSection();if(s){s.removeAttribute('aria-busy');s.classList.remove('is-loading');}inflight=null;});
  }
  document.addEventListener('click',function(e){
    var section=getSection();
    if(!section)return;
    if(!section.contains(e.target))return;
    var link=e.target.closest('a[data-coll-filter]');
    if(!link){var pag=e.target.closest('[data-coll-pagination]');if(pag)link=e.target.closest('a');}
    if(!link)return;
    var href=link.getAttribute('href');
    if(!href||href==='#'||href.indexOf('{'+'{'  )!==-1){log('skipped link (no real href):',href);return;}
    log('intercepting click on',href);
    e.preventDefault();
    renderFromUrl(link.href);
  },true);
  document.addEventListener('change',function(e){
    if(!e.target.matches||!e.target.matches('[data-coll-sort]'))return;
    var section=getSection();if(!section||!section.contains(e.target))return;
    log('sort changed to',e.target.value);
    var url=new URL(location.href);
    url.searchParams.set('sort_by',e.target.value);
    renderFromUrl(url.toString());
  });
  window.addEventListener('popstate',function(){log('popstate');renderFromUrl(location.href);});
})();</script></div></div></div></div><div class="hide w-embed w-script"><script>
              /* sortierung */
              Shopify.queryParams = {};
              /* Preserve existing query parameters */
              if (location.search.length) {
                var params = location.search.substr(1).split('&');
                for (var i = 0; i < params.length; i++) {
                  var keyValue = params[i].split('=');
                  if (keyValue.length) {
                    Shopify.queryParams[decodeURIComponent(keyValue[0])] = decodeURIComponent(keyValue[1]);
                  }
                }
              }
              /* Absicherung: aktive Sortierung aus data-active-sort setzen,
                 falls das selected-Attribut im Markup verloren geht. */
              (function(){
                var s = document.querySelector('#sort-by');
                if (!s) return;
                var want = s.getAttribute('data-active-sort') || '';
                if (!want || want.indexOf('{'+'{') !== -1) return;
                for (var i = 0; i < s.options.length; i++) {
                  if (s.options[i].value === want) { s.selectedIndex = i; return; }
                }
              })();
              /* Update sort_by query parameter on select change */
              document.querySelector('#sort-by').addEventListener('change', function(e) {
                var value = e.target.value;
                Shopify.queryParams.sort_by = value;
                location.search = new URLSearchParams(Shopify.queryParams).toString();
              });
            </script></div> {% schema %} {
