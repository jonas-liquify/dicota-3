<div class="padding-global" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem; background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; text-align: {{ section.settings.text_align }};"><div class="container-large"><div class="section-headline_inner"><div class="section-headline_titles">{% if section.settings.text_vortitel != blank %}    <div class="li-guard" li-if="section.settings.text_vortitel != blank">
    <p class="section-headline_pretitle heading-style-h1">
{{ section.settings.text_vortitel }}
</p>    </div>
{% endif %}<h2 class="section-headline_title heading-style-h1">
{{ section.settings.text_uberschrift }}
</h2></div><p class="section-headline_subtext text-size-regular"> {{ section.settings.textarea_beschreibung }} </p></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Section Headline",
    "class": "section_section-headline",
    "settings": [
        {
            "id": "text_vortitel",
            "type": "text",
            "label": "Vortitel",
            "default": "[DI:CO:TA]"
        },
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "The Computer Bag"
        },
        {
            "id": "textarea_beschreibung",
            "type": "textarea",
            "label": "Beschreibung",
            "default": "Bags are everywhere. Bags with a laptop compartment too. But true Computer Bags? Those you'll only find at Dicota."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 2.5
        },
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "select",
            "id": "text_align",
            "label": "Textausrichtung",
            "options": [
                {
                    "value": "left",
                    "label": "Links"
                },
                {
                    "value": "center",
                    "label": "Zentriert"
                },
                {
                    "value": "right",
                    "label": "Rechts"
                }
            ],
            "default": "center"
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#0f0f0f"
        }
    ],
    "presets": [
        {
            "name": "Section Headline",
            "category": "Content",
            "blocks": []
        }
    ]
} {% endschema %}