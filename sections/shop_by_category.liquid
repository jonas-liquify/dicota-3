<div class="padding-global" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"><div class="container-large"><div class="shop-by-category_heading"><h2 class="shop-by-category_title">
{{ section.settings.text_uberschrift }}
</h2></div><div class="shop-by-category_slider-wrapper"><div class="shop-by-category_swiper swiper"><div li-cf-theme-blocks="" class="swiper-wrapper shop-by-category_list">
{% content_for 'blocks' %}
</div><div class="shop-by-category_scrollbar swiper-scrollbar"></div></div><button type="button" class="shop-by-category_arrow swiper-button-next" aria-label="Weiter"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_right' %}</div></button><button type="button" class="shop-by-category_arrow is-prev swiper-button-prev" aria-label="Zurück"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_left' %}</div></button></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Shop by Category",
    "class": "section_shop-by-category",
    "blocks": [
        {
            "type": "kategorie"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Shop by Category"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 60
        },
        {
            "type": "header",
            "content": "Farben"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Textfarbe",
            "default": "#0f0f0f"
        }
    ],
    "presets": [
        {
            "name": "Shop by Category",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "kategorie"
                }
            ]
        }
    ]
} {% endschema %}