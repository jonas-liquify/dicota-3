<div class="padding-global padding-section-medium" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"><div class="container-large"><div class="default-medium-component"><div class="team_heading"><h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2><div class="text-size-medium"> {{ section.settings.textarea_text }} </div></div><div class="team_grid">{% if section.settings.image_bild != blank %}    <span class="li-guard" li-if="section.settings.image_bild != blank">
    {% if section.settings.image_bild %}
{{ section.settings.image_bild | image_url: width: 900 | image_tag: loading: 'lazy', class: 'team_image' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" loading="lazy" alt="" class="team_image">
{% endif %}    </span>
{% endif %}<div li-cf-theme-blocks="" class="team_cards-grid">
{% content_for 'blocks' %}
</div></div><div class="button-group is-center">{% if section.settings.text_button_text != blank %}    <span class="li-guard" li-if="section.settings.text_button_text != blank">
    <a href="{{ section.settings.url_button_link }}" class="button w-button"> <span>{{ section.settings.text_button_text }}</span> </a>    </span>
{% endif %}</div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Team Grid",
    "class": "section_team",
    "blocks": [
        {
            "type": "team-karte"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "One for all. All for you."
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "As a trusted leader in premium bag solutions, we deliver innovative products with a strong commitment to our customers. Our employees are the heart of our success, and we empower them to excel with pride and passion, consistently surpassing expectations."
        },
        {
            "id": "image_bild",
            "type": "image_picker",
            "label": "Bild"
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Read more"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 5
        }
    ],
    "presets": [
        {
            "name": "Team Grid",
            "category": "Listing",
            "blocks": [
                {
                    "type": "team-karte"
                }
            ]
        }
    ]
} {% endschema %}