        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "The Dicota Difference. Even more reasons to become a reseller."
        },
        {
            "id": "url_button_1_link",
            "type": "url",
            "label": "Button 1 Link"
        },
        {
            "id": "text_button_1_text",
            "type": "text",
            "label": "Button 1 Text",
            "default": "Einloggen"
        },
        {
            "id": "url_button_2_link",
            "type": "url",
            "label": "Button 2 Link"
        },
        {
            "id": "text_button_2_text",
            "type": "text",
            "label": "Button 2 Text",
            "default": "Registrieren"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
