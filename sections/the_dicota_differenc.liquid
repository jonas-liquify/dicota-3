<div class="padding-global dicota-difference_padding" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem; background-color: {{ section.settings.bg_color }};"><div class="container-large"><h2 class="dicota-difference_title heading-style-h2">
{{ section.settings.text_heading }}
</h2><div class="dicota-difference_slider-wrapper"><div class="dicota-difference_swiper swiper"><div li-cf-theme-blocks="" class="swiper-wrapper dicota-difference_list">
{% content_for 'blocks' %}
</div></div><button type="button" class="dicota-difference_arrow is-prev swiper-button-prev" aria-label="Zurück"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_left' %}</div></button><button type="button" class="dicota-difference_arrow swiper-button-next" aria-label="Weiter"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_right' %}</div></button></div><div class="dicota-difference_actions">{% if section.settings.text_button_1_text != blank %}    <span class="li-guard" li-if="section.settings.text_button_1_text != blank">
    <a href="{{ section.settings.url_button_1_link }}" class="button dicota-difference_btn w-button"> <span>{{ section.settings.text_button_1_text }}</span> </a>    </span>
{% endif %}{% if section.settings.text_button_2_text != blank %}    <span class="li-guard" li-if="section.settings.text_button_2_text != blank">
    <a href="{{ section.settings.url_button_2_link }}" class="button is-outline dicota-difference_btn w-button"> <span>{{ section.settings.text_button_2_text }}</span> </a>    </span>
{% endif %}</div></div></div><div class="hide w-embed w-script"><script>document.addEventListener("DOMContentLoaded", function() { var ensure = function(cb) { if (typeof Swiper !== "undefined") return cb(); if (window.__swiperLoading) return window.__swiperLoading.then(cb); var s = document.createElement("script"); s.src = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"; var link = document.createElement("link"); link.rel = "stylesheet"; link.href = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"; if(!document.getElementById("swiper-css")){link.id="swiper-css";var _h=document.head,_f=_h.querySelector('link[rel="stylesheet"],style');_f?_h.insertBefore(link,_f):_h.appendChild(link);} window.__swiperLoading = new Promise(function(res) { s.onload = res; }); document.head.appendChild(s); window.__swiperLoading.then(cb); }; ensure(function() { document.querySelectorAll(".dicota-difference_swiper.swiper").forEach(function(el){ if(el.swiper) return; var root=el.closest(".section_dicota-difference")||document; new Swiper(el,{ slidesPerView:"auto", spaceBetween:12, navigation:{ nextEl:root.querySelector(".dicota-difference_arrow.swiper-button-next"), prevEl:root.querySelector(".dicota-difference_arrow.is-prev"), disabledClass:"swiper-button-disabled" } }); }); }); });</script></div> {% schema %} {
    "tag": "section",
    "name": "The Dicota Differenc",
