<div class="padding-global the-latest_padding" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"><div class="container-large"><h2 class="the-latest_title heading-style-h2">
{{ section.settings.text_heading }}
</h2><div class="the-latest_slider-wrapper"><div class="the-latest_swiper swiper"><div li-cf-theme-blocks="" class="swiper-wrapper the-latest_list">
{% content_for 'blocks' %}
</div></div><button type="button" class="the-latest_arrow is-prev swiper-button-prev" aria-label="Zurück"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_left' %}</div></button><button type="button" class="the-latest_arrow swiper-button-next" aria-label="Weiter"><div class="icon-embed-xsmall w-embed">{% render 'icon_chevron_right' %}</div></button></div></div></div><div class="hide w-embed w-script"><script>document.addEventListener("DOMContentLoaded", function() { var ensure = function(cb) { if (typeof Swiper !== "undefined") return cb(); if (window.__swiperLoading) return window.__swiperLoading.then(cb); var s = document.createElement("script"); s.src = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"; var link = document.createElement("link"); link.rel = "stylesheet"; link.href = "https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"; document.head.appendChild(link); window.__swiperLoading = new Promise(function(res) { s.onload = res; }); document.head.appendChild(s); window.__swiperLoading.then(cb); }; ensure(function() { document.querySelectorAll(".the-latest_swiper.swiper").forEach(function(el){ if(el.swiper) return; var root=el.closest(".section_the-latest")||document; new Swiper(el,{ slidesPerView:"auto", spaceBetween:16, navigation:{ nextEl:root.querySelector(".the-latest_arrow.swiper-button-next"), prevEl:root.querySelector(".the-latest_arrow.is-prev"), disabledClass:"swiper-button-disabled" } }); }); }); });</script></div> {% schema %} {
    "tag": "section",
    "name": "The Latest",
    "class": "section_the-latest",
    "blocks": [
        {
            "type": "latest-slide"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "The Latest. Take a look at what's new, right now."
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        }
    ],
    "presets": [
        {
            "name": "The Latest",
            "category": "Listing",
            "blocks": [
                {
                    "type": "latest-slide"
                }
            ]
        }
    ]
} {% endschema %}