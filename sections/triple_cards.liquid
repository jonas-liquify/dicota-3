<div class="padding-global padding-section-large"><div class="container-large"><div class="default-regular-component"><div class="default-space-between"><h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2>{% if section.settings.text_button_text != blank %}    <div li-if="section.settings.text_button_text != blank" class="button-wrapper">
    <a href="{{ section.settings.url_button_link }}" class="button w-button"> <span>{{ section.settings.text_button_text }}</span> </a>    </div>
{% endif %}</div><div li-cf-theme-blocks="" class="solutions_grid is-3-columns">
{% content_for 'blocks' %}
</div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Triple Cards",
    "class": "section_solutions",
    "blocks": [
        {
            "type": "karte"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Entdecke unsere Welt"
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Alle ansehen"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 120
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 120
        }
    ],
    "presets": [
        {
            "name": "Triple Cards",
            "category": "Listing",
            "blocks": [
                {
                    "type": "karte"
                }
            ]
        }
    ]
} {% endschema %}