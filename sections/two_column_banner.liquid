<div li-cf-theme-blocks="" class="two-column-banner_grid" style="--banner-min-height: {{ section.settings.min_height }}vh;">
{% content_for 'blocks' %}
</div> {% schema %} {
    "tag": "section",
    "name": "Two Column Banner",
    "class": "section_two-column-banner",
    "blocks": [
        {
            "type": "banner"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "range",
            "id": "min_height",
            "min": 40,
            "max": 90,
            "step": 5,
            "unit": "vh",
            "label": "Mindesth\u00f6he je Spalte",
            "default": 70
        },
        {
            "type": "header",
            "content": "Overlay"
        },
        {
            "type": "color",
            "id": "overlay_color",
            "label": "Overlay-Farbe",
            "default": "#0F0F0F",
            "info": "Farbe des Fade-Overlays \u2014 verl\u00e4uft von transparent (oben) zur eingestellten Intensit\u00e4t (unten)."
        },
        {
            "type": "range",
            "id": "overlay_strength",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "%",
            "label": "Overlay-Intensit\u00e4t (unten)",
            "default": 70,
            "info": "Deckkraft am unteren Bildrand. 0 = kein Overlay."
        },
        {
            "type": "range",
            "id": "overlay_start",
            "min": 0,
            "max": 80,
            "step": 5,
            "unit": "%",
            "label": "Fade-Start (von oben)",
            "default": 30,
            "info": "Bis zu dieser H\u00f6he bleibt das Bild vollst\u00e4ndig sichtbar; ab hier beginnt der Verlauf."
        }
    ],
    "presets": [
        {
            "name": "Two Column Banner",
            "category": "Showcase",
            "blocks": [
                {
                    "type": "banner"
                }
            ]
        }
    ]
} {% endschema %}