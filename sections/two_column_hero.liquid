<div class="padding-global padding-section-small" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"><div class="container-large"><div class="heading-h1_grid"><h1 class="heading-style-h1">
{{ section.settings.text_heading }}
</h1><div class="default-flex-small"><div class="text-size-medium"> {{ section.settings.textarea_text }} </div>{% if section.settings.text_button_text != blank %}    <div li-if="section.settings.text_button_text != blank" class="button-wrapper">
    <a href="{{ section.settings.url_button_link }}" class="button w-button"> <span>{{ section.settings.text_button_text }}</span> </a>    </div>
{% endif %}</div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Two-Column Hero",
    "class": "section_heading-h1",
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "At DICOTA, you are more than an employee."
        },
        {
            "id": "textarea_text",
            "type": "textarea",
            "label": "Text",
            "default": "People make the famous difference. Top performance can only be achieved by motivated and reliable colleagues. The individual task area plays less of a role than the daily motivation to make everything just that little bit better. This is what we live at DICOTA. We prioritize understanding your needs, fostering collaboration, and creating a workplace where your contributions truly matter."
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button Text",
            "default": "Lorem Ipsum"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 2.5
        }
    ],
    "presets": [
        {
            "name": "Two-Column Hero",
            "category": "Hero",
            "blocks": []
        }
    ]
} {% endschema %}