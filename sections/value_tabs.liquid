<div class="padding-global padding-section-medium" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"><div class="container-large"><div x-data="{tab: 1, count: 0}" role="tablist" class="value-tabs_component"><div class="value-tabs_menu"><h2 class="heading-style-h2">
{{ section.settings.text_heading }}
</h2></div><div li-cf-theme-blocks="" class="value-tabs_blocks">
{% content_for 'blocks' %}
</div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Value Tabs",
    "class": "section_value-tabs",
    "blocks": [
        {
            "type": "tab"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Our values"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 5
        }
    ],
    "presets": [
        {
            "name": "Value Tabs",
            "category": "Content",
            "blocks": [
                {
                    "type": "tab"
                }
            ]
        }
    ]
} {% endschema %}