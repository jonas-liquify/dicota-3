<div class="padding-global more-stories_padding" style="padding-top: {{ section.settings.padding_top }}rem; padding-bottom: {{ section.settings.padding_bottom }}rem;"><div class="container-large"><h2 class="more-stories_title heading-style-h4">
{{ section.settings.text_uberschrift }}
</h2><div role="list" class="more-stories_grid w-dyn-items"><div li-for:inside="article in blog.articles limit: 3" style="display:contents">
        {% for article in blog.articles limit: 3 %}                            <a li-object:href="article.url" href="{{ article.url }}" role="listitem" class="story-card w-inline-block"><div class="story-card_image-wrap"><img li-object:src="article.image | image_url: width: 700" li-object:alt="article.image.alt" src="{{ article.image | image_url: width: 700 }}" loading="lazy" alt="{{ article.image.alt }}" class="story-card_image"></div><div class="story-card_body"><div class="story-card_head"><div class="story-card_meta"><span li-object="article.tags.first">{{ article.tags.first }}</span><span class="blog-meta_dot">·</span><span li-object="article.published_at | date: '%-d. %B %Y'">{{ article.published_at | date: '%-d. %B %Y' }}</span></div><h3 li-object="article.title" class="story-card_title">{{ article.title }}</h3></div><p li-object="article.excerpt" class="story-card_excerpt">{{ article.excerpt }}</p><span class="story-card_link">Learn more</span></div></a>
                    {% endfor %}    </div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Weitere Storys",
    "class": "section_more-stories",
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "More stories"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand oben",
            "default": 2.5
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 12,
            "step": 0.5,
            "unit": "rem",
            "label": "Abstand unten",
            "default": 5
        }
    ],
    "presets": [
        {
            "name": "Weitere Storys",
            "category": "Liquify",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "article"
        ]
    }
} {% endschema %}