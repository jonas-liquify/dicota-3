{% if localization.available_languages.size > 1 or localization.available_countries.size > 1 %}    <div li-if="localization.available_languages.size > 1 or localization.available_countries.size > 1" class="li-lang_wrapper">
    <div data-hover="true" data-delay="200" class="li-lang_dropdown w-dropdown"><div class="li-lang_dd-toggle announcement-bar_lang w-dropdown-toggle"><div class="announcement-bar_lang-flag"></div><div li-object="localization.language.iso_code | upcase">{{ localization.language.iso_code | upcase }}</div><span class="li-lang_sep">|</span><div li-object="localization.country.currency.symbol">{{ localization.country.currency.symbol }}</div><div class="dropdown-icon w-embed">{% render 'icon_chevron_down' %}</div></div><nav class="li-lang_dd-list w-dropdown-list">{% if localization.available_languages.size > 1 %}    <div li-if="localization.available_languages.size > 1" class="li-lang_dd-group">
    {% form 'localization', class: 'li-lang_form' %}
<input type="hidden" name="return_to" value="{{ request.path }}"><div li-for:inside="language in localization.available_languages" class="li-lang_dd-items">
        {% for language in localization.available_languages %}                            <button type="submit" name="language_code" class="li-lang_dd-link{% if language.iso_code == localization.language.iso_code %} is-active{% endif %}" value="{{ language.iso_code }}"><span li-object="language.endonym_name">{{ language.endonym_name }}</span></button>
                    {% endfor %}    </div>{% endform %}    </div>
{% endif %}{% if localization.available_countries.size > 1 %}    <div li-if="localization.available_countries.size > 1" class="li-lang_dd-group">
    {% form 'localization', class: 'li-lang_form' %}
<input type="hidden" name="return_to" value="{{ request.path }}"><div li-for:inside="country in localization.available_countries" class="li-lang_dd-items">
        {% for country in localization.available_countries %}                            <button type="submit" name="country_code" class="li-lang_dd-link{% if country.iso_code == localization.country.iso_code %} is-active{% endif %}" value="{{ country.iso_code }}"><span li-object="country.name">{{ country.name }}</span><span class="li-lang_dd-currency"><span li-object="country.currency.symbol">{{ country.currency.symbol }}</span></span></button>
                    {% endfor %}    </div>{% endform %}    </div>
{% endif %}</nav></div>    </div>
{% endif %}
