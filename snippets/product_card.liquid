<script src="{{ 'li_custom.js' | asset_url }}" type="text/javascript"></script>
<article li-element="product-variant-container" class="product-card" x-data="handleVariant({{ product | json | escape }}, {{ product.options_by_name | json | escape }}, {{ product.selected_or_first_available_variant | json | escape }})" x-init="$nextTick(() => { activateVariants() })" @setbundleitem.window="updateBundleItem($event.detail.product, $event.detail.quantity)"><div class="hide w-embed">{% assign card_url = product.url %}{% if collection != blank %}{% assign card_url = product.url | within: collection %}{% endif %}{% assign card_from = product.metafields.sl_ART.extra_COMPDEVSIZEINCHFROM.value %}{% assign card_to = product.metafields.sl_ART.extra_COMPDEVSIZEINCHTO.value %}{% assign card_fits = '' %}{% if card_from != blank and card_to != blank %}{% assign card_fits = 'products.fits_short' | t: from: card_from, to: card_to %}{% endif %}{% assign card_prop = product.metafields.sl_ART.extra_ITEMPROPERTY %}</div><button li-element="wishlist-button" type="button" class="product-card_favorite" aria-label="Add to wishlist" data-variant-id="{{ product.selected_or_first_available_variant.id }}"><div class="icon-embed-xxsmall w-embed">{% render 'icon_favorite' %}</div></button><a li-object:href="card_url" href="{{ card_url }}" class="product-card_image-link w-inline-block"><div class="product-card_image-wrapper"><img li-object:src="product.featured_image | image_url: width: 600" li-object:alt="product.featured_image.alt" src="{{ product.featured_image | image_url: width: 600 }}" loading="lazy" alt="{{ product.featured_image.alt }}" class="product-card_image"><div class="product-card_badges">{% if product.compare_at_price_max > product.price %}    <div li-if="product.compare_at_price_max > product.price" class="product-card_badge">
    <span li-object="'products.on_sale' | t" class="product-card_badge-text">{{ 'products.on_sale' | t }}</span>    </div>
{% endif %}{% if card_prop == 'End of Life' or card_prop == 'EOL' %}    <div class="li-guard" li-if="card_prop == 'End of Life' or card_prop == 'EOL'">
    <div class="product-card_badge is-dark"><span li-object="'products.discontinued' | t" class="product-card_badge-text">{{ 'products.discontinued' | t }}</span></div>    </div>
{% endif %}{% unless product.available %}    <div class="li-guard" li-unless="product.available">
    <div class="product-card_badge is-dark"><span li-object="'products.out_of_stock' | t" class="product-card_badge-text">{{ 'products.out_of_stock' | t }}</span></div>    </div>
{% endunless %}{% if card_fits != blank %}    <div class="li-guard" li-if="card_fits != blank">
    <div class="product-card_fits is-on-image"><span class="product-card_fits-icon w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 13 14" fill="none" aria-hidden="true"><path d="M2.83276 12.3139V11.2874H10.7615V12.3139H2.83276ZM6.79712 10.7742L4.81494 8.72123L5.50871 8.00269L6.30158 8.79822V5.56479L5.50871 6.36031L4.81494 5.64177L6.79712 3.5888L8.7793 5.64177L8.08554 6.36031L7.29267 5.56479V8.79822L8.08554 8.00269L8.7793 8.72123L6.79712 10.7742ZM2.83276 3.07556V2.04907H10.7615V3.07556H2.83276Z" fill="currentColor"></path></svg></span><span li-object="card_fits">{{ card_fits }}</span></div>    </div>
{% endif %}</div>{% if product.metafields.judgeme.review_widget_data.value.number_of_reviews > 0 %}    <div li-if="product.metafields.judgeme.review_widget_data.value.number_of_reviews > 0" class="product-card_rating">
    <div class="product-card_stars" style="--rating: {{ product.metafields.judgeme.review_widget_data.value.average_rating }}"></div><span li-object="product.metafields.judgeme.review_widget_data.value.average_rating | times: 1 | round: 1" class="product-card_rating-count">{{ product.metafields.judgeme.review_widget_data.value.average_rating | times: 1 | round: 1 }}</span>    </div>
{% endif %}<div class="product-card_hover-cta"><button li-object="'products.add_to_cart' | t" li-element="add-to-cart" type="button" class="button product-card_add-button w-button">{{ 'products.add_to_cart' | t }}</button></div></div>{% if product.images.size > 1 %}    <div li-if="product.images.size > 1">
    <img li-object:src="product.images[1] | image_url: width: 600" li-object:alt="product.title" src="{{ product.images[1] | image_url: width: 600 }}" loading="lazy" alt="{{ product.title }}" class="product-card_image is-hover">    </div>
{% endif %}</a><a li-object:href="card_url" href="{{ card_url }}" class="product-card_text-link w-inline-block"><h4 li-object="product.title" class="product-card_title">{{ product.title }}</h4><div class="product-card_price-row">{% if product.compare_at_price_max > product.price %}    <div li-if="product.compare_at_price_max > product.price">
    <span li-object="product.compare_at_price | money" class="product-card_price is-original">{{ product.compare_at_price | money }}</span>    </div>
{% endif %}<span li-object="product.price | money" class="product-card_price{% if product.compare_at_price_max > product.price %} is-sale{% endif %}">{{ product.price | money }}</span></div></a></article>
