<script src="{{ 'li_custom.js' | asset_url }}" type="text/javascript"></script>
<article li-element="product-variant-container" class="product-card" x-data="handleVariant({{ product | json | escape }}, {{ product.options_by_name | json | escape }}, {{ product.selected_or_first_available_variant | json | escape }})" x-init="$nextTick(() => { activateVariants() })" @setbundleitem.window="updateBundleItem($event.detail.product, $event.detail.quantity)"><a li-object:href="product.url" href="{{ product.url }}" class="product-card_image-link w-inline-block"><div class="product-card_image-wrapper"><img li-object:src="product.featured_image | image_url: width: 600" li-object:alt="product.featured_image.alt" src="{{ product.featured_image | image_url: width: 600 }}" loading="lazy" alt="{{ product.featured_image.alt }}" class="product-card_image">{% if product.images.size > 1 %}    <div li-if="product.images.size > 1">
    <img li-object:src="product.images[1] | image_url: width: 600" li-object:alt="product.title" src="{{ product.images[1] | image_url: width: 600 }}" loading="lazy" alt="{{ product.title }}" class="product-card_image is-hover">    </div>
{% endif %}{% if product.compare_at_price_max > product.price %}    <div li-if="product.compare_at_price_max > product.price" class="product-card_badge">
    <span class="product-card_badge-text">On sale</span>    </div>
{% endif %}<button li-element="wishlist-button" type="button" class="product-card_favorite" aria-label="Add to wishlist" data-variant-id="{{ product.selected_or_first_available_variant.id }}"><div class="icon-embed-xxsmall w-embed">{% render 'icon_favorite' %}</div></button>{% if product.metafields.reviews.rating %}    <div li-if="product.metafields.reviews.rating" class="product-card_rating">
    <div class="product-card_stars"><div class="product-card_star" style="--rating: {{ product.metafields.reviews.rating.value }}"></div></div><span li-object="product.metafields.reviews.rating.value | round: 1" class="product-card_rating-count">{{ product.metafields.reviews.rating.value | round: 1 }}</span>    </div>
{% endif %}<div class="product-card_hover-cta"><button li-element="add-to-cart" type="button" class="button product-card_add-button w-button" @click="addToCart($event, true)" :disabled="!addToCartButton">
                        Add to cart
                      </button></div></div></a><a li-object:href="product.url" href="{{ product.url }}" class="product-card_text-link w-inline-block"><h4 li-object="product.title" class="product-card_title">{{ product.title }}</h4><div class="product-card_price-row">{% if product.compare_at_price_max > product.price %}    <div li-if="product.compare_at_price_max > product.price">
    <span li-object="product.compare_at_price | money" class="product-card_price is-original">{{ product.compare_at_price | money }}</span>    </div>
{% endif %}<span li-object="product.price | money" class="product-card_price{% if product.compare_at_price_max > product.price %} is-sale{% endif %}">{{ product.price | money }}</span></div></a></article>
