accessories_arrow.swiper-button-next", prevEl: ".accessories_arrow.is-prev", disabledClass: "swiper-button-disabled" }, scrollbar: { el: ".accessories_scrollbar", draggable: true } }); /* Loved by Customers */ init(".loved-by_swiper.swiper", { slidesPerView: 1.4, spaceBetween: 12, breakpoints: { 480: { slidesPerView: 2.4 }, 768: { slidesPerView: 3.5 }, 992: { slidesPerView: 5 } }, navigation: { nextEl: ".loved-by_arrow.swiper-button-next", prevEl: ".loved-by_arrow.is-prev", disabledClass: "swiper-button-disabled" } }); /* Testimonials */ init(".testimonials_swiper.swiper", { slidesPerView: 1.1, spaceBetween: 16, breakpoints: { 480: { slidesPerView: 2.2 }, 768: { slidesPerView: 3 }, 992: { slidesPerView: 4 } }, navigation: { nextEl: ".testimonials_arrow.swiper-button-next", prevEl: ".testimonials_arrow.is-prev", disabledClass: "swiper-button-disabled" } }); });</script>
