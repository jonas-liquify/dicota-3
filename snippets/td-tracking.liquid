<script data-cookieconsent="ignore">
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }
  gtag('consent', 'default', {
    'ad_personalization': 'denied',
    'ad_storage': 'denied',
    'ad_user_data': 'denied',
    'analytics_storage': 'denied',
    'functionality_storage': 'denied',
    'personalization_storage': 'denied',
    'security_storage': 'granted',
    'wait_for_update': 500
  });
  gtag('set', 'ads_data_redaction', true);
  gtag('set', 'url_passthrough', false);
</script>

<script
  id="Cookiebot"
  src="https://consent.cookiebot.com/uc.js"
  data-cbid="057e0fd0-a6a6-4191-9c9f-1c17756db7b8"
  type="text/javascript"></script>

<script data-cookieconsent="ignore">
  (function () {
    var DEBUG = false;
    function log() { if (DEBUG && window.console) console.log.apply(console, ['[TD bridge]'].concat([].slice.call(arguments))); }

    var pending = null;
    var apiReady = false;
    var tries = 0;

    function capture() {
      var c = window.Cookiebot && window.Cookiebot.consent;
      if (!c) { log('kein Cookiebot.consent'); return; }
      pending = {
        analytics:    !!c.statistics,
        marketing:    !!c.marketing,
        preferences:  !!c.preferences,
        sale_of_data: !!c.marketing
      };
      log('consent erfasst', pending);
      send();
    }

    function send() {
      if (!apiReady || !pending) return;
      try {
        window.Shopify.customerPrivacy.setTrackingConsent(pending, function (r) {
          log('setTrackingConsent ok', r);
        });
        pending = null;
      } catch (e) {
        log('setTrackingConsent fehlgeschlagen', e);
      }
    }

    window.addEventListener('CookiebotOnConsentReady', capture);
    window.addEventListener('CookiebotOnAccept', capture);
    window.addEventListener('CookiebotOnDecline', capture);

    (function waitForShopify() {
      if (window.Shopify && window.Shopify.loadFeatures) {
        log('Shopify.loadFeatures gefunden nach', tries * 100, 'ms');
        window.Shopify.loadFeatures(
          [{ name: 'consent-tracking-api', version: '0.1' }],
          function (err) {
            if (err) { log('loadFeatures Fehler', err); return; }
            apiReady = true;
            log('Privacy API bereit');
            send();
          }
        );
        return;
      }
      if (++tries > 100) { log('Shopify.loadFeatures nach 10s nicht verfuegbar'); return; }
      setTimeout(waitForShopify, 100);
    })();

    if (window.Cookiebot && window.Cookiebot.hasResponse) capture();
  })();
</script>

<script data-cookieconsent="ignore">
  window.tdEcom = {
    currency: {{ cart.currency.iso_code | json }},
    viewItem: null,
    viewItemList: null
  };
</script>

{%- if page_type == 'product' and product -%}
  {%- assign td_v = product.selected_or_first_available_variant -%}
  {%- if td_v -%}
<script data-cookieconsent="ignore">
  window.tdEcom.viewItem = {
    currency: {{ cart.currency.iso_code | json }},
    value: {{ td_v.price | divided_by: 100.0 | json }},
    items: [{
      item_id: {{ td_v.sku | default: td_v.id | json }},
      item_name: {{ product.title | json }},
      item_brand: {{ product.vendor | json }},
      item_category: {{ product.type | json }},
      item_variant: {{ td_v.title | json }},
      price: {{ td_v.price | divided_by: 100.0 | json }},
      quantity: 1,
      index: 0
    }]
  };
</script>
  {%- endif -%}
{%- endif -%}

{%- if page_type == 'collection' and collection -%}
<script data-cookieconsent="ignore">
  window.tdEcom.viewItemList = {
    item_list_id: {{ collection.handle | json }},
    item_list_name: {{ collection.title | json }},
    items: [
      {%- for td_p in collection.products limit: 12 -%}
      {%- assign td_pv = td_p.selected_or_first_available_variant -%}
      {
        item_id: {{ td_pv.sku | default: td_pv.id | json }},
        item_name: {{ td_p.title | json }},
        item_brand: {{ td_p.vendor | json }},
        item_category: {{ td_p.type | json }},
        item_variant: {{ td_pv.title | json }},
        price: {{ td_pv.price | divided_by: 100.0 | json }},
        quantity: 1,
        index: {{ forloop.index0 }},
        item_list_id: {{ collection.handle | json }},
        item_list_name: {{ collection.title | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  };
</script>
{%- endif -%}

<script data-cookieconsent="ignore">
  (function () {
    var GTM_ID = 'GTM-MF5WT4ZG';
    var SNAP_KEY = 'td_cart_snapshot';
    var CART_ENDPOINTS = /\/cart\/(add|change|update|clear)(\.js)?(\?|$)/;

    function push(payload) {
      window.dataLayer.push({ ecommerce: null });
      window.dataLayer.push(payload);
    }

    function readSnapshot() {
      try { return JSON.parse(sessionStorage.getItem(SNAP_KEY)); }
      catch (e) { return null; }
    }

    function writeSnapshot(s) {
      try { sessionStorage.setItem(SNAP_KEY, JSON.stringify(s)); } catch (e) {}
    }

    function mapCartItem(i) {
      var unit = (i.final_price != null ? i.final_price : i.price) / 100;
      return {
        item_id: i.sku || String(i.variant_id || i.id),
        item_name: i.product_title || i.title,
        item_brand: i.vendor || '',
        item_category: i.product_type || undefined,
        item_variant: i.variant_title || '',
        price: Math.round(unit * 100) / 100
      };
    }

    function snapshotOf(cart) {
      var map = {};
      (cart.items || []).forEach(function (i) {
        map[i.key] = { qty: i.quantity, item: mapCartItem(i) };
      });
      return map;
    }

    function lineWithQty(item, qty) {
      var o = {};
      for (var k in item) o[k] = item[k];
      o.quantity = qty;
      return o;
    }

    function sumValue(items) {
      var v = items.reduce(function (a, i) { return a + (i.price || 0) * (i.quantity || 0); }, 0);
      return Math.round(v * 100) / 100;
    }

    function diff(prev, next, currency, emitRemovals) {
      var added = [], removed = [];

      Object.keys(next).forEach(function (k) {
        var d = next[k].qty - (prev[k] ? prev[k].qty : 0);
        if (d > 0) added.push(lineWithQty(next[k].item, d));
      });

      Object.keys(prev).forEach(function (k) {
        var d = prev[k].qty - (next[k] ? next[k].qty : 0);
        if (d > 0) removed.push(lineWithQty(prev[k].item, d));
      });

      added.forEach(function (it, i) { it.index = i; });
      removed.forEach(function (it, i) { it.index = i; });

      if (added.length) {
        push({ event: 'add_to_cart', ecommerce: { currency: currency, value: sumValue(added), items: added } });
      }
      if (emitRemovals && removed.length) {
        push({ event: 'remove_from_cart', ecommerce: { currency: currency, value: sumValue(removed), items: removed } });
      }
    }

    function syncCart(emitRemovals) {
      return fetch('/cart.js', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          var next = snapshotOf(cart);
          var prev = readSnapshot();
          if (prev) diff(prev, next, cart.currency || window.tdEcom.currency, emitRemovals);
          writeSnapshot(next);
        })
        .catch(function () {});
    }

    function hookCartRequests() {
      var origFetch = window.fetch;
      if (origFetch) {
        window.fetch = function () {
          var a = arguments[0];
          var url = (a && a.url) || a;
          var p = origFetch.apply(this, arguments);
          if (typeof url === 'string' && CART_ENDPOINTS.test(url)) {
            p.then(function () { setTimeout(function () { syncCart(true); }, 50); }, function () {});
          }
          return p;
        };
      }

      var origOpen = XMLHttpRequest.prototype.open;
      var origSend = XMLHttpRequest.prototype.send;
      XMLHttpRequest.prototype.open = function (m, u) {
        this.__tdUrl = u;
        return origOpen.apply(this, arguments);
      };
      XMLHttpRequest.prototype.send = function () {
        if (typeof this.__tdUrl === 'string' && CART_ENDPOINTS.test(this.__tdUrl)) {
          this.addEventListener('load', function () {
            setTimeout(function () { syncCart(true); }, 50);
          });
        }
        return origSend.apply(this, arguments);
      };
    }

    function startTracking() {
      if (window.tdEcom.viewItem) {
        push({ event: 'view_item', ecommerce: window.tdEcom.viewItem });
      }
      if (window.tdEcom.viewItemList && window.tdEcom.viewItemList.items.length) {
        push({ event: 'view_item_list', ecommerce: window.tdEcom.viewItemList });
      }

      syncCart(false);
      hookCartRequests();
    }

    function loadGTM() {
      if (window.gtmIsLoaded) return;
      window.gtmIsLoaded = true;

      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });

      var f = document.getElementsByTagName('script')[0];
      var j = document.createElement('script');
      j.async = true;
      j.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTM_ID;
      f.parentNode.insertBefore(j, f);

      var c = (window.Cookiebot && window.Cookiebot.consent) || {};
      window.dataLayer.push({
        event: 'page_view',
        page_location: window.location.href,
        page_title: document.title,
        page_referrer: document.referrer || undefined,
        consent_statistics: !!c.statistics,
        consent_marketing: !!c.marketing,
        consent_preferences: !!c.preferences
      });

      startTracking();
    }

    function checkConsentAndLoad() {
      var c = window.Cookiebot && window.Cookiebot.consent;
      if (c && (c.statistics || c.marketing)) loadGTM();
    }

    window.addEventListener('CookiebotOnConsentReady', checkConsentAndLoad);
    window.addEventListener('CookiebotOnAccept', checkConsentAndLoad);
    window.addEventListener('CookiebotOnDecline', checkConsentAndLoad);

    if (window.Cookiebot && window.Cookiebot.hasResponse) checkConsentAndLoad();
  })();
</script>
