    "b2b_solution_header_9c4LJd": {
      "type": "b2b_solution_header",
      "name": "Brand & Corporate Identity",
      "settings": {
        "text_subline": "B2B Solutions",
        "text_heading_1": "Brand & Corporate Identity",
        "textarea_subheading_1": "DICOTA is the ideal partner for modern workplace setups: a broad portfolio of connectivity, ergonomic and protection solutions helps companies equip employees for hybrid work — whether in the office, at home or on the move. Standardized workplace bundles simplify procurement, support efficient onboarding and create recurring business opportunities with IT, HR and facility management.",
        "url_hero_button_link": "shopify://pages/b2b-signup",
        "text_hero_button_text": "Become a reseller",
        "padding_top": 4,
