    "b2b_solution_feature_UnXFb6": {
      "type": "b2b_solution_feature",
      "name": "B2B Solution Feature",
      "settings": {
        "image_feature_bild": "shopify://shop_images/Blog_Image_Business_travel_in_2026_essentials_for_mobile_professionals.jpg",
        "text_feature_subline": "",
        "text_feature_heading": "Current situation& market opportunity",
        "textarea_feature_text": "Resellers and system integrators make their money primarily from devices – laptops, tablets and Surface products. However, the real potential for adding value lies in the accessories that come with each device. In practice, this potential is often not fully realised: accessories are treated as an afterthought, rather than as part of the offering.<br><br>\nThe Device Rollout Bundle fundamentally changes this approach. Instead of offering a sleeve, case and lock as three separate items that the customer might order, they are positioned as an integrated package – compatible with the device model, configurable as required, and ready to be added directly to the quote. The result: higher order value, less coordination effort and stronger customer loyalty.",
        "padding_top": 2,
        "padding_bottom": 2
      }
    },
