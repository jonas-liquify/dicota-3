    "b2b_solution_feature_UnXFb6": {
      "type": "b2b_solution_feature",
      "name": "B2B Solution Feature",
      "settings": {
        "image_feature_bild": "shopify://shop_images/Blog_Image_Business_travel_in_2026_essentials_for_mobile_professionals.jpg",
        "text_feature_subline": "",
        "text_feature_heading": "Current situation<br>& market opportunity",
        "textarea_feature_text": "ESG – Environmental, Social, Governance – is no longer just a marketing term. It is a regulatory framework that imposes binding requirements on companies across Europe. From 2025, the EU’s Corporate Sustainability Reporting Directive (CSRD) will require thousands of companies to provide detailed sustainability reporting – including Scope 3 emissions, which cover the entire supply chain.<br><br>\nFor IT resellers, this means that their major clients will increasingly be asking what evidence of sustainability their suppliers can provide. Those unable to answer this question risk being removed from supplier lists. Those who provide a convincing answer will gain points in the procurement process and strengthen their partnership.",
        "padding_top": 2,
        "padding_bottom": 2
      }
    },
