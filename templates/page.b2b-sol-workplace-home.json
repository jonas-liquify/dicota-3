    "rich_text_YxCbPU": {
      "type": "rich_text",
      "disabled": true,
      "name": "Rich Text",
      "settings": {
        "richtext_inhalt": "<h4>This approach significantly reduces the reseller’s internal workload: no manual checks for compatibility, no need to contact the manufacturer, and no mistakes regarding size. At the same time, it conveys a sense of professionalism to the customer – the offer comes across as well thought-out, not cobbled together.</h4>",
