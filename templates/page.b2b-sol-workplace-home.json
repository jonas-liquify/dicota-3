    "value_tabs_8xDcCx": {
      "type": "value_tabs",
      "blocks": {
        "tab_WtkFKC": {
          "type": "tab",
          "name": "Employee onboarding",
          "settings": {
            "text_tab_label": "Employee onboarding",
            "text_tab_heading": "Employee onboarding",
            "textarea_tab_text": "Every new hire triggers a full workplace setup. HR defines a standard package, IT adds the device, and the reseller delivers everything as a bundle – defined once, available at any time. Once this setup has been integrated into the onboarding process, there is little risk of being replaced.\nThe key lies in defining the onboarding package in collaboration with HR – not just with IT. HR focuses on the welcome kit and the employee experience; if the DICOTA package forms part of this experience, the order is secured."
          },
          "blocks": {}
        },
        "tab_EnGYGA": {
          "type": "tab",
          "name": "Office Relocations and Refurbishments",
          "settings": {
            "text_tab_label": "Office Relocations and Refurbishments",
            "text_tab_heading": "Office Relocations and Refurbishments",
            "textarea_tab_text": "When companies relocate or modernise their office spaces, new workstations require new accessories. Resellers often overlook this opportunity because it doesn’t feature in the traditional IT procurement calendar. A quick check-in with the facilities manager or senior management – “Are you planning any refurbishments in the next 12 months?” – can lead to an unexpectedly large order."
          },
          "blocks": {}
        },
        "tab_U46hmf": {
          "type": "tab",
          "name": "Roll-out of the home working policy",
          "settings": {
            "text_tab_label": "Roll-out of the home working policy",
            "text_tab_heading": "Roll-out of the home working policy",
            "textarea_tab_text": "Since 2022, many companies have introduced formal home working policies that also set out a standard for equipping the home office. There is often a fixed per-person budget – around 200 to 500 euros – which employees can use to set up their home office. DICOTA packages fit perfectly into this budget framework: defined contents, a clear price, and simple invoicing."
          },
          "blocks": {}
        },
        "tab_3n6qfQ": {
          "type": "tab",
          "name": "Argument 4",
          "settings": {
            "text_tab_label": "Argument 4",
            "text_tab_heading": "Warranty and support from a single source",
            "textarea_tab_text": "If there’s a problem with the accessories – a broken zip, a sleeve that’s too small, a faulty lock – there’s a single point of contact: the reseller. No finger-pointing between different suppliers. No hassle for the customer in finding out who’s responsible. That’s a real service advantage that carries weight in discussions with the IT manager."
          },
          "blocks": {}
        }
      },
