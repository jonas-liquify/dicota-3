    "b2b_solution_feature_UnXFb6": {
      "type": "b2b_solution_feature",
      "name": "B2B Solution Feature",
      "settings": {
        "image_feature_bild": "shopify://shop_images/Blog_Image_Business_travel_in_2026_essentials_for_mobile_professionals.jpg",
        "text_feature_subline": "",
        "text_feature_heading": "Current situation<br>& market opportunity",
        "textarea_feature_text": "Hybrid working is no longer just a trend – it is the new norm. Since 2020, organisations of all sizes have learnt that employees need not just a device, but a complete, ergonomic and functional workspace – whether in the office, at home or on the move. This need is here to stay and grows with every new hire.<br><br>\nFor resellers, this opens up a new channel of communication: not just with IT procurement, but also with HR, facilities management and senior management. These stakeholders think in terms of employee satisfaction, the quality of onboarding and per-capita budgets – not in terms of device specifications. Those who speak this language can tap into an additional market with high volume and good contribution margins.",
        "padding_top": 2,
        "padding_bottom": 2
      }
    },
